---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import SkillGrid from '@/components/about/SkillGrid.astro';
import Timeline from '@/components/about/Timeline.astro';
import { author } from '@/data/author';
import { experiences } from '@/data/experiences';
import { degrees } from '@/data/education';
import { publications } from '@/data/publications';
import { getCollection } from 'astro:content';

const bio = author.bio.it;

const allPosts = await getCollection('posts');
const articleCount = allPosts.filter((p) => p.data.lang === 'it' && !p.data.draft && p.data.pillar !== null).length;
const yearsExperience = new Date().getFullYear() - 2021;

const experienceItems = experiences.flatMap((exp) =>
  exp.positions.map((pos) => ({
    title: pos.designation,
    subtitle: exp.company.name,
    period: pos.end ? `${pos.start} - ${pos.end}` : `${pos.start} - Presente`,
    description: pos.responsibilities.join('. ') + '.',
  }))
);

const educationItems = degrees.map((deg) => ({
  title: deg.name,
  subtitle: deg.institution.name,
  period: deg.timeframe,
  description: [
    deg.grade ? `Voto: ${deg.grade.achieved}` : null,
    deg.thesis ? `Tesi: ${deg.thesis}` : null,
  ].filter(Boolean).join(' — '),
}));
---

<PageLayout title="About">
  <PageHero
    title="Chi sono"
    subtitle='Backend Engineer & DevOps Consultant. Technical writer per <a href="https://theredcode.it/authors/francesco-montelli/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">TheRedCode</a>.'
    image={{ src: author.image, alt: author.name }}
    cta={{ href: '/files/Francesco_Montelli_CV.pdf', label: 'Scarica CV' }}
  />

  {/* Bio */}
  <section class="mb-20 fade-in-section">
    <p class="text-text-muted text-lg leading-relaxed max-w-2xl">
      {bio}
    </p>
    <div class="flex gap-8 mt-6">
      <div>
        <span class="text-3xl font-bold text-accent">{yearsExperience}+</span>
        <p class="text-sm text-text-muted">anni di esperienza</p>
      </div>
      <div>
        <span class="text-3xl font-bold text-accent">{articleCount}</span>
        <p class="text-sm text-text-muted">articoli pubblicati</p>
      </div>
    </div>
  </section>

  {/* Stack tecnologico */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title="Stack tecnologico" />
    <SkillGrid />
  </section>

  {/* Esperienze */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title="Esperienze" />
    <Timeline items={experienceItems} />
  </section>

  {/* Istruzione */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title="Istruzione" />
    <Timeline items={educationItems} />
  </section>

  {/* Pubblicazioni */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title="Pubblicazioni" />
    <p class="text-text-muted mb-6 max-w-2xl">
      Membro del Comitato Tecnico-Scientifico di Operai dell'Arte APS. Ho supervisionato tesi di laurea e collaborato a pubblicazioni peer-reviewed in ambito geomatica e patrimonio culturale.
    </p>
    <div class="space-y-6 stagger-children">
      {publications.map((pub) => (
        <div class="border-l-2 border-accent pl-4">
          <a
            href={pub.paper.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-semibold text-text-dark dark:text-text-light hover:text-accent transition-colors"
          >
            {pub.title}
          </a>
          {pub.authors && (
            <p class="text-sm text-text-muted mt-1">{pub.authors}</p>
          )}
          <p class="text-sm text-accent mt-1">
            {pub.publishedIn.name} ({pub.publishedIn.date})
          </p>
          <p class="text-sm text-text-muted mt-2">{pub.paper.summary}</p>
        </div>
      ))}
    </div>
  </section>

  {/* CTA */}
  <section class="text-center py-16 fade-in-section">
    <h2 class="text-3xl font-bold mb-3">Lavoriamo insieme?</h2>
    <p class="text-text-muted text-lg mb-8 max-w-xl mx-auto">
      Costruisco infrastrutture che scalano. Se il tuo team sta crescendo, parliamone.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <Button href="/servizi/" variant="secondary" size="lg">
        Vedi i servizi
      </Button>
      <Button href="/files/Francesco_Montelli_CV.pdf" variant="primary" size="lg">
        Scarica CV
      </Button>
    </div>
    <p class="mt-6 text-sm text-text-muted">
      oppure scrivimi a <a href="mailto:francesco@montelli.dev" class="text-accent hover:underline">francesco@montelli.dev</a>
    </p>
  </section>
</PageLayout>
