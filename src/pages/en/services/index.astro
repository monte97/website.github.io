---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { getPillarLabel } from '@/data/pillars';
import { postHref } from '@/utils/blog';

const services = (await getCollection('services')).sort((a, b) => a.data.weight - b.data.weight);

const rendered = await Promise.all(
  services.map(async (service) => {
    const { Content } = await render(service);
    return { service, Content };
  })
);

// Separate health check (pillar === 'tutti') from other services
const healthCheck = rendered.find(({ service }) => service.data.pillar === 'tutti');
const otherServices = rendered.filter(({ service }) => service.data.pillar !== 'tutti');

// Fetch English posts for related articles
const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft && p.data.lang === 'en')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group posts by pillar and take 2 per pillar
const postsByPillar: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  if (post.data.pillar) {
    if (!postsByPillar[post.data.pillar]) postsByPillar[post.data.pillar] = [];
    if (postsByPillar[post.data.pillar].length < 2) {
      postsByPillar[post.data.pillar].push(post);
    }
  }
}

// Pillar color mappings
const pillarBorders: Record<string, string> = {
  progettare: 'border-pillar-progettare',
  verificare: 'border-pillar-verificare',
  automatizzare: 'border-pillar-automatizzare',
};
const pillarText: Record<string, string> = {
  progettare: 'text-pillar-progettare',
  verificare: 'text-pillar-verificare',
  automatizzare: 'text-pillar-automatizzare',
};

// SVG icons by name
const icons: Record<string, string> = {
  stethoscope: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v6a6 6 0 0 0 12 0V4"/><path d="M4 4h2"/><path d="M14 4h2"/><circle cx="18" cy="14" r="2"/><path d="M18 16v2a4 4 0 0 1-4 4h-2a4 4 0 0 1-4-4v-2"/></svg>`,
  'drafting-compass': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"/><path d="M12 7v2"/><path d="m6.5 21 4.74-9.13"/><path d="m17.5 21-4.74-9.13"/><path d="M8.5 14h7"/></svg>`,
  'shield-check': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s-4.5 1.5-8 3v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5c-3.5-1.5-8-3-8-3z"/><path d="m9 12 2 2 4-4"/></svg>`,
  rocket: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>`,
};
---

<BaseLayout title="Services">
  <Header lang="en" />
  <PageHero
    title="How I can help"
    subtitle="I help engineering teams build, monitor, and automate software systems with method."
    cta={{ href: '#health-check', label: 'Start with a Health Check' }}
  />
  <main class="max-w-5xl mx-auto px-5 py-12">
    {/* Other services as cards */}
    <div class="space-y-8">
      {otherServices.map(({ service, Content }) => {
        const slug = service.id;
        const pillar = service.data.pillar as 'progettare' | 'verificare' | 'automatizzare';
        const mailto = `mailto:francesco@montelli.dev?subject=${encodeURIComponent(service.data.title)}`;
        const borderClass = pillarBorders[pillar] || '';
        const textClass = pillarText[pillar] || '';
        const relatedPosts = postsByPillar[pillar] || [];
        const iconSvg = icons[service.data.icon] || '';

        return (
          <section
            id={slug}
            class:list={[
              'rounded-xl border-l-[3px] bg-white dark:bg-surface-dark border border-border/50 dark:border-border-dark/50 p-6 scroll-mt-20 fade-in-section',
              borderClass,
            ]}
          >
            <div class="flex items-center gap-3 mb-4">
              <span class={textClass} set:html={iconSvg} />
              <h2 class="text-xl font-bold">{service.data.title}</h2>
              <Badge pillar={pillar}>
                {getPillarLabel(pillar, 'en')}
              </Badge>
            </div>
            <div class="prose dark:prose-invert max-w-none text-text-muted mb-6">
              <Content />
            </div>
            <Button href={mailto} variant="primary" size="sm">
              {service.data.cta}
            </Button>

            {relatedPosts.length > 0 && (
              <div class="mt-6 pt-4 border-t border-border/30 dark:border-border-dark/30">
                <p class="text-xs text-text-muted uppercase tracking-wide mb-2">From the blog</p>
                <ul class="space-y-1">
                  {relatedPosts.map((post) => (
                    <li class="flex items-baseline gap-2 text-sm">
                      <a
                        href={postHref(post.id, 'en')}
                        class="text-text-dark dark:text-text-light hover:text-accent transition-colors line-clamp-1"
                      >
                        {post.data.title}
                      </a>
                      <span class="text-text-muted text-xs whitespace-nowrap">
                        {post.data.date.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        );
      })}
    </div>

    {/* Health Check hero card - moved to bottom */}
    {healthCheck && (
      <section
        id={healthCheck.service.id}
        class="bg-accent-subtle rounded-xl p-8 mt-16 scroll-mt-20 fade-in-section"
      >
        <span class="text-xs text-accent font-semibold uppercase tracking-wide">
          Starting point
        </span>
        <div class="flex items-center gap-3 mt-2 mb-4">
          <span class="text-accent" set:html={icons[healthCheck.service.data.icon]} />
          <h2 class="text-2xl font-bold">{healthCheck.service.data.title}</h2>
        </div>
        <div class="prose dark:prose-invert max-w-none text-text-muted mb-6">
          <healthCheck.Content />
        </div>
        <Button
          href={`mailto:francesco@montelli.dev?subject=${encodeURIComponent(healthCheck.service.data.title)}`}
          variant="primary"
          size="md"
        >
          {healthCheck.service.data.cta}
        </Button>
      </section>
    )}
  </main>
  <Footer lang="en" />
</BaseLayout>
