---
/** Indice del blog: ultimi articoli, serie con filtro, altri articoli. */
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import BlogIndex from '@/components/blog/BlogIndex.astro';
import { getSeriesIndex } from '@/utils/series';

const allPosts = (await getCollection('posts')).filter(p => p.data.lang === 'en' && !p.data.draft);
const tutte = getSeriesIndex(allPosts, 'en');
const series = tutte.filter(s => s.count > 1);
const serieDaUno = new Set(tutte.filter(s => s.count === 1).map(s => s.key));
const singoli = allPosts
  .filter(p => !p.data.series || serieDaUno.has(p.data.series))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

---

<PageLayout title="Blog" description="What I learn, I write down" lang="en" ogImage="/og/blog.png">
  <PageHero slot="hero" variant="index" eyebrow="Blog" title="What I learned by building, put in order" subtitle="Real systems, decisions actually taken, limits declared alongside the results." note={`${allPosts.length} articles · ${series.length} series`} />

  <BlogIndex allPosts={allPosts} series={series} singoli={singoli} lang="en" />
</PageLayout>
