---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import PostSummary from '@/components/ui/PostSummary.astro';
import PostOpenItems from '@/components/ui/PostOpenItems.astro';
import PostCaseStudy from '@/components/ui/PostCaseStudy.astro';
import { getHeroImage, estimateReadingTime } from '@/utils/blog';

// Hero image auto-detection via import.meta.glob (must stay here — Vite statically analyzes globs)
const heroImages = import.meta.glob<{ default: { src: string } }>(
  '/src/content/posts/**/hero.webp',
  { eager: true }
);

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  return posts
    .filter(p => p.data.lang === 'en' && !p.data.draft)
    .map(post => {
      const slug = post.id.replace(/\/indexen$/, '');
      return {
        params: { slug },
        props: { post },
      };
    });
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const editUrl = `https://github.com/monte97/website.github.io/edit/main/src/content/posts/${post.id}.md`;

const slug = post.id.replace(/\/indexen$/, '');
const heroImage = getHeroImage(post.id, heroImages);
const readingTime = estimateReadingTime(post.body);
const alternateUrl = `/blog/${slug}`;
---

<BlogPostLayout
  title={post.data.title}
  seoTitle={post.data.seoTitle}
  description={post.data.description}
  date={post.data.date}
  pillar={post.data.pillar}
  category={post.data.category}
  tags={post.data.tags}
  headings={headings}
  lang="en"
  editUrl={editUrl}
  series={post.data.series}
  postId={post.id}
  heroImage={heroImage}
  readingTime={readingTime}
  ogImage={heroImage}
  alternateUrl={alternateUrl}
>
  {post.data.summary && post.data.summary.length > 0 && (
    <PostSummary items={post.data.summary} lang="en" />
  )}

  <Content />

  {post.data.openItems && post.data.openItems.length > 0 && (
    <PostOpenItems items={post.data.openItems} note={post.data.openNote} lang="en" />
  )}

  {post.data.caseStudy && (
    <PostCaseStudy slug={post.data.caseStudy.slug} hook={post.data.caseStudy.hook} lang="en" />
  )}
</BlogPostLayout>
