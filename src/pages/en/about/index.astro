---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import SkillGrid from '@/components/about/SkillGrid.astro';
import Timeline from '@/components/about/Timeline.astro';
import { author } from '@/data/author';
import { experiences } from '@/data/experiences';
import { degrees } from '@/data/education';
import { publications } from '@/data/publications';
import { getCollection } from 'astro:content';

const bio = author.bio.en;

const allPosts = await getCollection('posts');
const articleCount = allPosts.filter((p) => p.data.lang === 'en' && !p.data.draft && p.data.pillar !== null).length;
const yearsExperience = new Date().getFullYear() - 2021;

const experienceItems = experiences.flatMap((exp) =>
  exp.positions.map((pos) => ({
    title: pos.designation,
    subtitle: exp.company.name,
    period: pos.end ? `${pos.start} - ${pos.end}` : `${pos.start} - Present`,
    description: pos.responsibilities.join('. ') + '.',
  }))
);

const educationItems = degrees.map((deg) => ({
  title: deg.name,
  subtitle: deg.institution.name,
  period: deg.timeframe,
  description: [
    deg.grade ? `Grade: ${deg.grade.achieved}` : null,
    deg.thesis ? `Thesis: ${deg.thesis}` : null,
  ].filter(Boolean).join(' — '),
}));
---

<PageLayout title="About" lang="en">
  <PageHero
    title="About me"
    subtitle='Backend Engineer & DevOps Consultant. Technical writer for <a href="https://theredcode.it/authors/francesco-montelli/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">TheRedCode</a>.'
    image={{ src: author.image, alt: author.name }}
    cta={{ href: '/files/Francesco_Montelli_CV.pdf', label: 'Download CV' }}
  />

  {/* Bio */}
  <section class="mb-20 fade-in-section">
    <p class="text-text-muted text-lg leading-relaxed max-w-2xl">
      {bio}
    </p>
    <div class="flex gap-8 mt-6">
      <div>
        <span class="text-3xl font-bold text-accent">{yearsExperience}+</span>
        <p class="text-sm text-text-muted">years experience</p>
      </div>
      <div>
        <span class="text-3xl font-bold text-accent">{articleCount}</span>
        <p class="text-sm text-text-muted">articles published</p>
      </div>
    </div>
  </section>

  {/* Tech Stack */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title="Tech Stack" />
    <SkillGrid />
  </section>

  {/* Experience */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title="Experience" />
    <Timeline items={experienceItems} />
  </section>

  {/* Education */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title="Education" />
    <Timeline items={educationItems} />
  </section>

  {/* Publications */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title="Publications" />
    <p class="text-text-muted mb-6 max-w-2xl">
      Member of the Scientific Committee of Operai dell'Arte APS. I have supervised master's theses and co-authored peer-reviewed publications in geomatics and cultural heritage.
    </p>
    <div class="space-y-6 stagger-children">
      {publications.map((pub) => (
        <div class="border-l-2 border-accent pl-4">
          <a
            href={pub.paper.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-semibold text-text-dark dark:text-text-light hover:text-accent transition-colors"
          >
            {pub.title}
          </a>
          {pub.authors && (
            <p class="text-sm text-text-muted mt-1">{pub.authors}</p>
          )}
          <p class="text-sm text-accent mt-1">
            {pub.publishedIn.name} ({pub.publishedIn.date})
          </p>
          <p class="text-sm text-text-muted mt-2">{pub.paper.summary}</p>
        </div>
      ))}
    </div>
  </section>

  {/* CTA */}
  <section class="text-center py-16 fade-in-section">
    <h2 class="text-3xl font-bold mb-3">Let's work together?</h2>
    <p class="text-text-muted text-lg mb-8 max-w-xl mx-auto">
      I build infrastructure that scales. If your team is growing, let's talk.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <Button href="/en/services/" variant="secondary" size="lg">
        View services
      </Button>
      <Button href="/files/Francesco_Montelli_CV.pdf" variant="primary" size="lg">
        Download CV
      </Button>
    </div>
    <p class="mt-6 text-sm text-text-muted">
      or write me at <a href="mailto:francesco@montelli.dev" class="text-accent hover:underline">francesco@montelli.dev</a>
    </p>
  </section>
</PageLayout>
