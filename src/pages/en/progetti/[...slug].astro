---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import { pillarStyles } from '@/data/pillar-styles';
import { getPillarLabel } from '@/data/pillars';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;

if (project.data.type === 'workshop') {
  const workshopTarget = {
    'e2e-testing-infrastructure': '/en/workshop/testing-e2e/',
  };
  const target = workshopTarget[project.id] ?? '/en/workshop/';
  return new Response(
    `<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Redirecting</title><link rel="canonical" href="${target}"><meta http-equiv="refresh" content="0; url=${target}"><meta name="robots" content="noindex"></head><body><p>This page has moved. <a href="${target}">Go to workshop</a>.</p><script>window.location.replace(${JSON.stringify(target)});</script></body></html>`,
    { status: 200, headers: { 'Content-Type': 'text/html; charset=utf-8' } }
  );
}

const { Content } = await render(project);

const pillarKey = project.data.pillarApplied;
const pillarBadgeStyle = pillarKey ? pillarStyles[pillarKey] : null;
const result = project.data.result;
const resultItems = Array.isArray(result) ? result : result ? [result] : [];
---

<BaseLayout title={project.data.title} description={project.data.description} ogImage="/og/progetti.png" lang="en">
  <Header lang="en" />

  <main class="max-w-5xl mx-auto px-5 py-8">
    <Breadcrumb
      class="mb-6"
      variant="text"
      truncateLast
      items={[
        { label: 'Home', href: '/en/' },
        { label: 'Case studies', href: '/en/progetti/' },
        { label: project.data.title },
      ]}
    />

    <header class="mb-10 max-w-3xl">
      <span class="text-xs text-accent font-semibold uppercase tracking-wide">Case study</span>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight text-text-dark dark:text-text-light mt-2 mb-4">
        {project.data.title}
      </h1>
      {project.data.problem && (
        <p class="text-text-muted text-lg leading-relaxed mb-4">{project.data.problem}</p>
      )}
      {!project.data.problem && (
        <p class="text-text-muted text-lg leading-relaxed mb-4">{project.data.description}</p>
      )}
      {project.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4">
          {project.data.tags.map((tag) => (
            <span class="text-[11px] text-text-muted/80 bg-text-muted/8 px-1.5 py-0.5 rounded">{tag}</span>
          ))}
        </div>
      )}
    </header>

    {project.data.links && (
      <div class="flex flex-wrap gap-3 mb-12">
        {project.data.links.github && (
          <a href={project.data.links.github} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border dark:border-border-dark text-sm font-medium hover:border-accent hover:text-accent transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
        )}
        {project.data.links.demo && (
          <a href={project.data.links.demo} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent text-white text-sm font-medium hover:bg-accent-hover transition-colors">
            Demo &rarr;
          </a>
        )}
        {project.data.links.blog && (
          <a href={project.data.links.blog}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border dark:border-border-dark text-sm font-medium hover:border-accent hover:text-accent transition-colors">
            Related articles &rarr;
          </a>
        )}
      </div>
    )}

    <div class="max-w-3xl space-y-10">
      {project.data.context && (
        <section>
          <h2 class="text-xl font-bold text-text-dark dark:text-text-light mb-3">Context</h2>
          <p class="text-text-muted leading-relaxed">{project.data.context}</p>
        </section>
      )}

      {pillarKey && pillarBadgeStyle && (
        <section class={`pl-5 border-l-4 ${pillarBadgeStyle.borderLeft}`}>
          <p class="text-xs uppercase tracking-wide text-text-muted mb-1">Pillar applied</p>
          <h2 class={`text-xl font-bold ${pillarBadgeStyle.text} mb-3`}>
            {getPillarLabel(pillarKey, 'en')}
          </h2>
        </section>
      )}

      {project.data.actions && project.data.actions.length > 0 && (
        <section>
          <h2 class="text-xl font-bold text-text-dark dark:text-text-light mb-3">What I did</h2>
          <ul class="space-y-2">
            {project.data.actions.map((action) => (
              <li class="text-text-muted leading-relaxed flex gap-2">
                <span class="text-accent mt-2 shrink-0 w-1 h-1 rounded-full bg-accent" />
                <span>{action}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {resultItems.length > 0 && (
        <section>
          <h2 class="text-xl font-bold text-text-dark dark:text-text-light mb-3">Outcome</h2>
          {resultItems.length === 1 ? (
            <p class="text-text-muted leading-relaxed">{resultItems[0]}</p>
          ) : (
            <ul class="space-y-2">
              {resultItems.map((item) => (
                <li class="text-text-muted leading-relaxed flex gap-2">
                  <span class="text-accent mt-2 shrink-0 w-1 h-1 rounded-full bg-accent" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      )}
    </div>

    {project.body && project.body.trim().length > 0 && (
      <article class="prose prose-lg dark:prose-invert max-w-3xl mt-16
        prose-headings:tracking-tight
        prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-12 prose-h2:mb-4
        prose-h3:text-xl prose-h3:font-semibold prose-h3:mt-8 prose-h3:mb-3
        prose-p:leading-relaxed prose-p:mb-4
        prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-a:underline-offset-4
        prose-img:rounded-xl prose-img:shadow-sm prose-img:border prose-img:border-border/50
        prose-code:before:content-none prose-code:after:content-none
        prose-pre:bg-code-bg prose-pre:rounded-xl
        prose-blockquote:border-l-accent prose-blockquote:bg-accent/5 prose-blockquote:rounded-r-lg prose-blockquote:py-1
        prose-li:marker:text-accent">
        <Content />
      </article>
    )}

    <section class="mt-20 pt-10 border-t border-border/50 dark:border-border-dark/50 max-w-3xl">
      <h2 class="text-2xl font-bold text-text-dark dark:text-text-light mb-3">
        Facing something similar?
      </h2>
      <p class="text-text-muted mb-6">
        If this case study touches a problem you have on your plate, let's talk in a free 30-minute discovery call.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
        <a href="https://cal.com/francesco-montelli-4hfojq/30min" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-accent text-white text-sm font-semibold hover:bg-accent-hover transition-colors">
          Book a discovery call →
        </a>
        <a href="mailto:francesco@montelli.dev" class="text-sm text-text-muted hover:text-accent transition-colors">
          or write me
        </a>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</BaseLayout>
