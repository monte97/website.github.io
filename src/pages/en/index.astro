---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import ForWho from '@/components/home/ForWho.astro';
import PillarCards from '@/components/home/PillarCards.astro';
import FilteredPosts from '@/components/home/FilteredPosts.astro';
import ContactSection from '@/components/home/ContactSection.astro';
---

<BaseLayout
  title="I design, build and automate product software · Francesco Montelli"
  description="Freelance Software Engineer. I design, build and automate product software, from scratch or on systems grown rigid over time: architecture, build, testing, CI/CD, observability, security."
  ogImage="/og/home.webp"
  lang="en"
>
  <Header lang="en" />
  <main>
    <Hero lang="en" />
    <ForWho lang="en" />
    <PillarCards lang="en" />
    <FilteredPosts lang="en" />
    <ContactSection lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
