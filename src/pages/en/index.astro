---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import SeenAt from '@/components/home/SeenAt.astro';
import Offer from '@/components/home/Offer.astro';
import Coffee from '@/components/home/Coffee.astro';
---

<BaseLayout
  title="Architecture, testing and automation on a subscription · Francesco Montelli"
  description="Freelance Software Engineer. I design, build and automate software, from scratch or on systems grown rigid over time: architecture, testing, CI/CD, observability, security. On a subscription or per project."
  ogImage="/og/home.png"
  lang="en"
>
  <Header lang="en" overlay />
  <main>
    <Hero lang="en" />
    <SeenAt lang="en" />
    <Offer lang="en" />
    <Coffee lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
