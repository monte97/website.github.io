---
const target = '/servizi/';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <title>Reindirizzamento — Servizi</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Questa pagina si è spostata. <a href={target}>Vai a Servizi</a>.</p>
    <script set:html={`window.location.replace(${JSON.stringify(target)});`} />
  </body>
</html>
