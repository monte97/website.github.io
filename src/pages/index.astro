---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import ForWho from '@/components/home/ForWho.astro';
import PillarCards from '@/components/home/PillarCards.astro';
import FilteredPosts from '@/components/home/FilteredPosts.astro';
import ContactSection from '@/components/home/ContactSection.astro';
---

<BaseLayout
  title="Quando il sistema inizia a scricchiolare · Francesco Montelli"
  description="Software Engineer freelance. Aiuto aziende di prodotto a modernizzare sistemi irrigiditi nel tempo: architettura, observability, automazione. E a costruire la disciplina perché reggano."
  ogImage="/og/home.webp"
>
  <Header lang="it" />
  <main>
    <Hero lang="it" />
    <ForWho lang="it" />
    <PillarCards lang="it" />
    <FilteredPosts lang="it" />
    <ContactSection lang="it" />
  </main>
  <Footer lang="it" />
</BaseLayout>
