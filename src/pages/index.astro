---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import SeenAt from '@/components/home/SeenAt.astro';
import Offer from '@/components/home/Offer.astro';
import Coffee from '@/components/home/Coffee.astro';
---

<BaseLayout
  title="Architettura, test e automazione in abbonamento · Francesco Montelli"
  description="Software Engineer freelance. Progetto, sviluppo e automatizzo software, da zero o su sistemi irrigiditi nel tempo: architettura, test, CI/CD, observability, sicurezza. In abbonamento o a progetto."
  ogImage="/og/home.png"
>
  <Header lang="it" overlay />
  <main>
    <Hero lang="it" />
    <SeenAt lang="it" />
    <Offer lang="it" />
    <Coffee lang="it" />
  </main>
  <Footer lang="it" />
</BaseLayout>
