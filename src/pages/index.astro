---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import ForWho from '@/components/home/ForWho.astro';
import PillarCards from '@/components/home/PillarCards.astro';
import FilteredPosts from '@/components/home/FilteredPosts.astro';
import ContactSection from '@/components/home/ContactSection.astro';
---

<BaseLayout
  title="Quando il sistema inizia a scricchiolare — Francesco Montelli"
  description="Software Engineer freelance specializzato in sistemi distribuiti. Aiuto team in crescita a riconoscere i segnali prima che diventino guasti — architettura, observability, automazione."
  ogImage="/og/home.webp"
>
  <Header lang="it" />
  <main>
    <Hero lang="it" />
    <ForWho lang="it" />
    <PillarCards lang="it" />
    <FilteredPosts lang="it" />
    <ContactSection lang="it" />
  </main>
  <Footer lang="it" />
</BaseLayout>
