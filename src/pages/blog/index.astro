---
/**
 * Indice del blog.
 *
 * Il corpus è organizzato in serie: 58 articoli su 64 ne fanno parte. Quindi
 * la pagina è un sommario per pillar, non un feed cronologico: dentro ogni
 * pillar le sue serie, e sotto i pezzi singoli. L'hero fa da indice: le tre
 * colonne portano ai settori, la card a destra all'ultimo arrivato.
 *
 * Una "serie" con un solo articolo è un pezzo singolo e viene trattata così.
 */
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import BlogIndexBody from '@/components/blog/BlogIndexBody.astro';
import { getSeriesIndex } from '@/utils/series';
import { postHref, estimateReadingTime } from '@/utils/blog';
import { pillarStyles } from '@/data/pillar-styles';
import { getPillarLabel } from '@/data/pillars';

const allPosts = (await getCollection('posts')).filter(p => p.data.lang === 'it' && !p.data.draft);
const tutte = getSeriesIndex(allPosts);
const series = tutte.filter(s => s.count > 1);
const serieDaUno = new Set(tutte.filter(s => s.count === 1).map(s => s.key));
const singoli = allPosts
  .filter(p => !p.data.series || serieDaUno.has(p.data.series))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const ultimo = [...allPosts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const PILLARS = ['progettare', 'verificare', 'automatizzare'] as const;
const riga: Record<string, string> = {
  progettare: 'Architetture, eventi, identità, permessi',
  verificare: 'Test, observability, alerting',
  automatizzare: 'Cluster, pipeline, container, homelab',
};
const conteggi: Record<string, { art: number; ser: number }> = {
  progettare: { art: 0, ser: 0 }, verificare: { art: 0, ser: 0 }, automatizzare: { art: 0, ser: 0 },
};
for (const p of allPosts) if (p.data.pillar) conteggi[p.data.pillar].art++;
for (const s of series) if (s.pillar) conteggi[s.pillar].ser++;
---

<PageLayout title="Blog" description="Quello che imparo, lo scrivo" lang="it" ogImage="/og/blog.png">
  <section slot="hero" class="bg-accent-subtle border-b border-border/40 dark:border-border-dark/40">
    <div class="max-w-5xl mx-auto px-5 py-14 md:py-16 fade-in-section">

      <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-4">Blog</p>
          <h1 class="font-bold tracking-tight text-text-dark dark:text-text-light leading-[1.15] text-3xl sm:text-4xl max-w-2xl">
            Quello che ho imparato costruendo, messo in ordine
          </h1>
          <p class="mt-4 text-text-muted leading-relaxed max-w-xl">
            {allPosts.length} articoli in {series.length} serie: sistemi veri, scelte prese davvero, e i vincoli dichiarati insieme ai risultati.
          </p>
        </div>

        {ultimo && (
          <a href={postHref(ultimo.id)} class="group block max-w-xs rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-4 hover:border-accent/50 hover:bg-accent/5 transition-all">
            <div class="text-[10px] font-mono font-semibold uppercase tracking-widest text-text-muted mb-1.5">
              L'ultimo · {estimateReadingTime(ultimo.body)} min
            </div>
            <div class="text-sm font-semibold text-text-dark dark:text-text-light group-hover:text-accent transition-colors leading-snug">
              {ultimo.data.title}
            </div>
          </a>
        )}
      </div>

      <!-- le tre porte, come sommario -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-border/60 dark:bg-border-dark/60 rounded-xl overflow-hidden border border-border/60 dark:border-border-dark/60">
        {PILLARS.map(pil => {
          const st = pillarStyles[pil];
          const c = conteggi[pil];
          return (
            <a href={`#${pil}`} class="group bg-surface dark:bg-surface-dark p-5 hover:bg-accent/5 transition-colors">
              <div class="flex items-baseline gap-2 mb-2">
                <span class={`font-mono text-lg font-bold ${st.text}`}>{st.num}</span>
                <span class="text-base font-bold text-text-dark dark:text-text-light group-hover:text-accent transition-colors">
                  {getPillarLabel(pil)}
                </span>
              </div>
              <p class="text-sm text-text-muted leading-snug mb-3">{riga[pil]}</p>
              <div class={`h-0.5 w-8 ${st.bg} opacity-50 mb-3`} />
              <div class="text-xs text-text-muted tabular-nums">
                {c.art} articoli · {c.ser} {c.ser === 1 ? 'serie' : 'serie'}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <BlogIndexBody series={series} singoli={singoli} />
</PageLayout>
