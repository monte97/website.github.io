---
/** Indice del blog: ultimi articoli, serie con filtro, altri articoli. */
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import BlogIndex from '@/components/blog/BlogIndex.astro';
import { getSeriesIndex } from '@/utils/series';

const allPosts = (await getCollection('posts')).filter(p => p.data.lang === 'it' && !p.data.draft);
const tutte = getSeriesIndex(allPosts);
const series = tutte.filter(s => s.count > 1);
const serieDaUno = new Set(tutte.filter(s => s.count === 1).map(s => s.key));
const singoli = allPosts
  .filter(p => !p.data.series || serieDaUno.has(p.data.series))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

---

<PageLayout title="Blog" description="Quello che imparo, lo scrivo" lang="it" ogImage="/og/blog.png">
  <PageHero slot="hero" variant="index" eyebrow="Blog" title="Quello che ho imparato costruendo, messo in ordine" subtitle="Sistemi veri, scelte prese davvero, vincoli dichiarati insieme ai risultati." note={`${allPosts.length} articoli · ${series.length} serie`} />

  <BlogIndex allPosts={allPosts} series={series} singoli={singoli} lang="it" />
</PageLayout>
