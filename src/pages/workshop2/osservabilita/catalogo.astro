---
/**
 * Catalogo del percorso sull'osservabilita', in versione web.
 *
 * L'impaginazione segue il doc-kit del design system, non la landing del sito:
 * cover con eyebrow / titolo / filetto arancio / sommario, capitoli marcati da
 * una regola spessa con il numero nella colonna di sinistra, griglie
 * etichetta-valore al posto delle tabelle. La profondita' e' data dallo spessore
 * dei filetti (3px capitolo, 2px sezione, 1px riga), mai dal colore: il filetto
 * arancio compare una volta sola, sulla cover.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FinalCta from '@/components/ui/FinalCta.astro';
import { workshopAreas } from '@/data/workshop-areas';
import { author } from '@/data/author';
import Logo from '@/assets/logo-fra.svg?raw';

const area = workshopAreas.find((a) => a.slug === 'osservabilita')!;
const pdf = area.catalog?.pdf;

// ── Idiomi del doc-kit, in classi ──────────────────────────────────────────
const gutter = 'grid grid-cols-1 sm:grid-cols-[7rem_1fr] gap-x-5 gap-y-2';
const mono = 'font-mono text-[11px] uppercase tracking-[0.12em] text-text-muted';
const hair = 'border-border/70 dark:border-border-dark/70';
const strong = 'border-text-dark/30 dark:border-text-light/30';
const prose = 'text-text-muted leading-relaxed max-w-[42rem] mb-4';
const h2 = 'text-2xl md:text-3xl font-bold tracking-tight leading-snug text-text-dark dark:text-text-light text-balance';
const h3 = 'text-xl font-bold tracking-tight text-text-dark dark:text-text-light';

const meta = [
  ['Per chi è', 'Team di sviluppo che devono capire cosa è successo dentro un sistema distribuito in esecuzione'],
  ['Formato', 'Due ore in versione compatta, tre giorni in versione aziendale. In presenza o da remoto'],
  ['Base di lavoro', 'Uno stack completo in esecuzione: ingresso, coda, elaborazione, persistenza, con la raccolta dei segnali già configurata'],
];

const acquisito = [
  ['Si presume', 'Che sappiate a cosa servono metriche, log e trace.'],
  ['Non si presume', "Che qualcuno abbia mai strumentato un servizio a mano, né che sappiate cosa fa un collector quando gli si cambia la configurazione sotto."],
  ['Si parte da', 'Lo stack già in esecuzione sulle vostre macchine, verificato prima del corso.'],
];

const catena = [
  ['01', 'Ingresso', 'autenticato'],
  ['02', 'Coda', 'disaccoppia'],
  ['03', 'Elaborazione', 'strumentata'],
  ['—', 'Persistenza', 'si strumenta da fuori'],
];

const compatta = [
  ['15 min', 'Claim e avvio dello stack', 'Si parte dal sistema in esecuzione e dal giro della dashboard.'],
  ['20 min', 'Il guasto', 'Si attiva il tasso di dispositivi rotti nel generatore di carico e si correlano metriche, log e trace.'],
  ['15 min', 'Il buco nero', 'Entra il servizio non strumentato: risponde, chiama a valle, non compare da nessuna parte.'],
  ['45 min', 'I quattro checkpoint', 'Dalla prima traccia al waterfall completo, con verifica a ogni passo.'],
  ['5 min', 'Chiusura', 'Waterfall completo a schermo e confronto con la soluzione di riferimento.'],
  ['10 min', 'La parte onesta', 'Costi veri dello stack, cambio del backend dal vivo, quando basta molto meno.'],
];

const serve = [
  ['Macchine', 'Docker funzionante e circa 4 GB di RAM libera per macchina. Lo stack a regime ne occupa poco meno di 4.'],
  ['Rete', 'Accesso al registry delle immagini. Il pacchetto di preparazione le scarica prima del corso.'],
  ['Verifica', 'Un avvio di prova dello stack, da fare prima e non in aula.'],
];

const aziendale = [
  ['Servizi da strumentare', 'Uno, in Python', 'Due in più, nel runtime scelto dal team fra Node, Java e Go'],
  ['Checkpoint', 'Quattro, in 45 minuti', "Ognuno diventa una sessione da un'ora con debrief"],
  ['Guasto', 'Uno, su un servizio', 'Guasto multi servizio con propagazione fra le trace'],
  ['Pipeline', 'Configurazione già pronta', 'Collector con routing e uscite multiple, alerting, SLO'],
  ['Neutralità del fornitore', 'Accennata', 'Sostituzione del backend dalla configurazione, con i limiti dichiarati'],
  ['Cosa resta', 'Esercizi e soluzione di riferimento', "Documento di architettura dell'osservabilità e runbook"],
];

const giorni = [
  ['Giorno 1', 'Fondamenti e debug: avvio dello stack, il guasto, correlazione fra metriche, log e trace, il modello di telemetria.'],
  ['Giorno 2', 'Strumentazione: i quattro checkpoint con più tempo, poi un secondo servizio in un altro runtime e il confronto sulla propagazione del contesto.'],
  ['Giorno 3', 'Produzione: telemetria come codice, collector, SLO e alerting, sostituzione del backend, retrospettiva.'],
];

const base = {
  nome: 'Leggere un sistema e strumentarne un componente',
  desc: "Avvio dello stack, analisi di un primo guasto e correlazione fra i tre segnali, seguiti dalla prima strumentazione del servizio privo di telemetria. I primi venti minuti introducono metriche, log e trace per i team che affrontano il tema per la prima volta.",
  nota: 'Tutti gli altri moduli presuppongono questo.',
};

const moduli = [
  ['M1', 'Strumentazione avanzata', 'richiede la base', 'Ricostruzione completa della richiesta con propagazione del contesto, e strumentazione della persistenza dalla configurazione.'],
  ['M2', 'Automatica o manuale', 'richiede la base', 'Quali risultati offre la strumentazione automatica e quali richiedono un intervento nel codice.'],
  ['M3', 'SLO e alerting', 'richiede la base', 'Definizione di un obiettivo di servizio misurabile e allarme basato sul consumo del margine di errore.'],
  ['M4', 'Verifica degli allarmi', 'richiede SLO e alerting', 'Introduzione di un guasto circoscritto e verifica di quali allarmi non si attivano.'],
  ['M5', 'Portabilità', 'richiede la base', 'Sostituzione del backend dei segnali dalla sola configurazione, e limiti effettivi della portabilità.'],
  ['M6', 'Costi e dimensionamento', 'indipendente', 'Costo misurato di esercizio, conservazione dei dati, campionamento e cardinalità.'],
  ['M7', 'Contenuti di una dashboard', 'richiede la base', 'Quali indicatori si osservano quotidianamente e quali soltanto durante un incidente.'],
  ['M8', 'Esercitazione conclusiva', 'richiede tutti i precedenti', 'Guasto non dichiarato, ruoli assegnati, causa da individuare a partire dai soli segnali.'],
];

const composizione = [
  ['01', 'La base', 'Due ore, sempre incluse. È la durata minima con un esito verificabile.'],
  ['02', 'I moduli', 'La base con due moduli corrisponde a sei ore, pause incluse.'],
  ['03', 'Il calendario', 'Sessione unica oppure sessioni distinte, preferibili oltre le sei ore.'],
];

const ram = [
  ['Osservabilità', '0,48 GiB'],
  ['Dipendenze', '0,44 GiB'],
  ['Servizi della demo', '0,99 GiB'],
  ['Totale', '1,92 GiB'],
];

const disco = [['7 giorni', '~12 GB'], ['30 giorni', '~52 GB'], ['90 giorni', '~157 GB']];

const leve = [
  ['Campionamento', 'Da 80 a 90 per cento in meno sullo spazio delle trace', 'Tiene errori e trace lente, scarta quelle sane. Il compromesso è dichiarato: le trace sane le perdete.'],
  ['Conservazione', 'Finestre diverse per segnale', 'Dettaglio a breve, aggregazioni a lunga. Meno storia consultabile nel dettaglio.'],
  ['Cardinalità', 'La leva che esplode se nessuno la guarda', 'Richiede governo continuo delle etichette, non una configurazione da fare una volta.'],
];

const bastaMeno = [
  ["Un servizio, poche richieste all'ora", 'Un cron, una curl, un alert via mail', 'Un controllo periodico batte un collector intero'],
  ['Pochi servizi, senza trace', 'Metriche per applicazione', 'Si capisce il come, senza il perché'],
  ['Più servizi, serve propagare il contesto', 'Collector leggero, un backend solo', 'Portabilità senza il peso dello stack completo'],
  ['Microservizi, più team, debug fra servizi', 'Stack completo', 'Il debugging e la conservazione valgono il costo'],
];

const resta = [
  ['Lo stack', 'Quattro servizi, la coda, il servizio di identità, il generatore di carico e la raccolta dei segnali, con due comandi per avviarlo.'],
  ['Gli esercizi', 'I quattro checkpoint scritti passo per passo, e la soluzione di riferimento completa da confrontare.'],
  ['La parte onesta', 'I costi misurati, la proiezione sulla conservazione dei dati e la tabella per decidere quando basta meno.'],
];

const capitoli = [
  ['01', 'Il sistema', 'Un sistema a microservizi, e uno di questi è cieco'],
  ['02', 'Il punto di partenza', 'Un servizio che risponde e non esiste'],
  ['03', 'La versione compatta', 'Due ore, sei blocchi'],
  ['04', 'La versione aziendale', 'Stessa base, altra profondità'],
  ['05', 'I moduli', 'Da cosa è composto il percorso'],
  ['06', 'I costi', 'Quanto costa tenere acceso lo stack'],
  ['07', 'Il dimensionamento', 'Quando basta molto meno'],
  ['08', 'Cosa resta', 'Il repository resta, e continua a girare'],
];

const terminale = `$ curl -s -X POST localhost:18081/gate
{ "gate": "open", "upstream_status": 202 }          # il servizio funziona

Grafana → Explore → Tempo   { service.name = "quality-gate" }
0 risultati                                         # per il sistema di osservabilità non esiste`;
---

<BaseLayout
  title="Catalogo · Rendere osservabile un sistema vivo"
  description="Il catalogo del percorso sull'osservabilità: il sistema su cui si lavora, i moduli componibili, i due formati, i costi misurati dello stack e cosa resta al team."
  ogImage="/og/workshop.png"
  lang="it"
>
  <Header lang="it" />

  <main class="max-w-[72rem] mx-auto px-5 py-10 md:px-10">

    <!-- ── Testata ── -->
    <div class={`flex items-center justify-between gap-5 pb-4 border-b ${hair}`}>
      <div class="flex items-center gap-3">
        <span class="w-[46px] h-[40px] shrink-0 [&_svg]:w-full [&_svg]:h-full" set:html={Logo} />
        <span class="text-base font-bold text-text-dark dark:text-text-light leading-tight">
          {author.name}
          <span class={`block ${mono} mt-0.5`}>Software engineer freelance</span>
        </span>
      </div>
      <p class={`${mono} text-right hidden sm:block`}>
        francesco@montelli.dev<br />montelli.dev
      </p>
    </div>

    <!-- ── Cover ── -->
    <div class="mt-12">
      <p class={mono}>Osservabilità · catalogo del percorso</p>
      <h1 class="mt-3 text-3xl md:text-5xl font-bold tracking-tight leading-[1.1] text-text-dark dark:text-text-light text-balance">
        Rendere osservabile un sistema vivo
      </h1>
      <div class="mt-5 w-[72px] h-[3px] rounded-sm bg-accent" />
      <p class="mt-5 text-lg text-text-muted leading-relaxed max-w-[42rem]">
        Strumentare i servizi e debuggare con metriche, log e trace. Su uno stack completo, in esecuzione.
      </p>

      <dl class={`mt-8 max-w-[54rem] ${gutter} border-t-2 ${strong}`}>
        {meta.map(([k, v]) => (
          <>
            <dt class={`${mono} pt-3 pb-1 sm:pb-3 sm:border-b ${hair}`}>{k}</dt>
            <dd class={`text-sm text-text-dark dark:text-text-light pb-3 border-b ${hair}`}>{v}</dd>
          </>
        ))}
      </dl>

      {pdf && (
        <p class="mt-8">
          <a href={pdf} class={`inline-flex items-center gap-2 px-4 py-2 rounded-sm border ${strong} text-sm font-medium hover:border-accent hover:text-accent transition-colors`}>
            Scarica il catalogo in PDF &rarr;
          </a>
        </p>
      )}
    </div>

    <!-- ── Indice ── -->
    <nav class={`mt-12 max-w-[54rem] border-t ${hair}`} aria-label="Indice del catalogo">
      {capitoli.map(([n, kicker, titolo]) => (
        <a href={`#c${n}`} class={`${gutter} py-3 px-2 border-b ${hair} hover:bg-text-muted/5 transition-colors`}>
          <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-accent">{n}</span>
          <span class="text-sm font-semibold text-text-dark dark:text-text-light">
            {titolo}
            <span class={`block ${mono} font-normal mt-0.5`}>{kicker}</span>
          </span>
        </a>
      ))}
    </nav>

    <!-- ══ 01 ══ -->
    <section id="c01" class={`mt-20 pt-5 border-t-[3px] ${strong} scroll-mt-6`}>
      <div class={gutter}>
        <div>
          <span class="block font-mono text-4xl font-medium leading-none tracking-tight text-accent">01</span>
          <span class={`block ${mono} mt-2`}>Il sistema</span>
        </div>
        <div>
          <h2 class={h2}>Un sistema a microservizi, e uno di questi è cieco</h2>
          <p class="mt-3 text-text-muted leading-relaxed max-w-[42rem]">
            Il percorso gira su una catena di servizi che si chiamano fra loro, con una coda in mezzo e un
            generatore di carico che tiene tutto in movimento. I problemi che si vogliono mostrare esistono solo
            quando una richiesta attraversa più processi.
          </p>
        </div>
      </div>

      <div class="mt-8 max-w-[54rem]">
        <p class={`${mono} mb-3`}>Una richiesta attraverso i servizi</p>
        <div class={`border ${hair} rounded-sm divide-y ${hair}`}>
          {catena.map(([n, nome, ruolo]) => (
            <div class="grid grid-cols-[3.5rem_1fr] items-baseline">
              <span class={`${mono} px-4 py-3 border-r ${hair} self-stretch`}>{n}</span>
              <span class="px-4 py-3 text-sm">
                <span class="font-semibold text-text-dark dark:text-text-light">{nome}</span>
                <span class="text-text-muted"> · {ruolo}</span>
              </span>
            </div>
          ))}
        </div>
        <p class={`${mono} mt-3`}>
          La raccolta dei segnali è già configurata: un collector solo, unico punto di uscita per trace, log e metriche
        </p>
      </div>

      <p class={`${prose} mt-8`}>
        Nella stessa sessione si vedono due strumentazioni diverse: il servizio si strumenta nel codice, la
        persistenza si configura da fuori, e sono mestieri distinti che spesso in azienda ricadono su persone
        distinte.
      </p>
      <p class={prose}>
        Questa architettura copre buona parte dei casi che si incontrano e resta personalizzabile: i componenti si
        sostituiscono con i vostri, i servizi da strumentare si scrivono nel linguaggio che usate, e i punti su cui
        si interviene si scelgono in fase di scoping.
      </p>

      <div class={`mt-10 max-w-[54rem] ${gutter} pb-4 border-b-2 ${strong}`}>
        <span aria-hidden="true" />
        <h3 class={h3}>Cosa si dà per acquisito</h3>
      </div>
      <dl class={`max-w-[54rem] ${gutter}`}>
        {acquisito.map(([k, v]) => (
          <>
            <dt class={`${mono} pt-3 pb-1 sm:pb-3 sm:border-b ${hair}`}>{k}</dt>
            <dd class={`text-sm text-text-muted pb-3 border-b ${hair}`}>{v}</dd>
          </>
        ))}
      </dl>
    </section>

    <!-- ══ 02 ══ -->
    <section id="c02" class={`mt-20 pt-5 border-t-[3px] ${strong} scroll-mt-6`}>
      <div class={gutter}>
        <div>
          <span class="block font-mono text-4xl font-medium leading-none tracking-tight text-accent">02</span>
          <span class={`block ${mono} mt-2`}>Il punto di partenza</span>
        </div>
        <div>
          <h2 class={h2}>Un servizio che risponde e non esiste</h2>
          <p class="mt-3 text-text-muted leading-relaxed max-w-[42rem]">
            Allo stack in esecuzione si aggiunge un quarto servizio, <code class="text-sm">quality-gate</code>.
            Risponde alle richieste, chiama il gateway a valle e non emette telemetria. Chi guarda i cruscotti non
            ha modo di sapere che è lì.
          </p>
        </div>
      </div>

      <div class="mt-8 max-w-[54rem]">
        <p class={`${mono} mb-3`}>Terminale · le due righe che aprono il percorso</p>
        <pre class="rounded-sm bg-code-bg text-text-light text-xs md:text-sm p-5 overflow-x-auto"><code>{terminale}</code></pre>
      </div>

      <p class={`${prose} mt-8`}>
        Il servizio risponde 200 e il gateway a valle accetta i dati. Nessuno dei due segnali arriva dove qualcuno
        lo guarderebbe.
      </p>
      <p class={prose}>
        Poi lo si rende osservabile in quattro checkpoint, e ognuno si chiude con una verifica in Tempo, Loki e
        Grafana. Il confronto finale è con la soluzione di riferimento, che resta chiusa fino alla fine.
      </p>
      <p class={prose}>
        Il collector applica un campionamento che tiene il 20% delle trace sane, quindi una singola richiesta può
        non comparire. Le verifiche si fanno su volume, con un ciclo di dieci chiamate, ed è la prima cosa che il
        team impara sul funzionamento reale di uno stack di telemetria.
      </p>
    </section>

    <!-- ══ 03 ══ -->
    <section id="c03" class={`mt-20 pt-5 border-t-[3px] ${strong} scroll-mt-6`}>
      <div class={gutter}>
        <div>
          <span class="block font-mono text-4xl font-medium leading-none tracking-tight text-accent">03</span>
          <span class={`block ${mono} mt-2`}>La versione compatta</span>
        </div>
        <div>
          <h2 class={h2}>Due ore, sei blocchi</h2>
          <p class="mt-3 text-text-muted leading-relaxed max-w-[42rem]">
            Centodieci minuti di programma su due ore di aula. Il margine che resta è per le domande e per la demo
            che sfora.
          </p>
        </div>
      </div>

      <div class={`mt-8 max-w-[54rem] ${gutter} border-t ${hair}`}>
        {compatta.map(([min, titolo, desc]) => (
          <>
            <span class={`font-mono text-[11px] uppercase tracking-[0.12em] text-accent pt-3 pb-1 sm:pb-3 sm:border-b ${hair}`}>{min}</span>
            <span class={`pb-3 border-b ${hair}`}>
              <span class="block text-sm font-semibold text-text-dark dark:text-text-light sm:pt-3">{titolo}</span>
              <span class="block text-sm text-text-muted mt-1">{desc}</span>
            </span>
          </>
        ))}
      </div>

      <div class={`mt-10 max-w-[54rem] ${gutter} pb-4 border-b-2 ${strong}`}>
        <span aria-hidden="true" />
        <h3 class={h3}>Cosa serve dalla vostra parte</h3>
      </div>
      <dl class={`max-w-[54rem] ${gutter}`}>
        {serve.map(([k, v]) => (
          <>
            <dt class={`${mono} pt-3 pb-1 sm:pb-3 sm:border-b ${hair}`}>{k}</dt>
            <dd class={`text-sm text-text-muted pb-3 border-b ${hair}`}>{v}</dd>
          </>
        ))}
      </dl>
    </section>

    <!-- ══ 04 ══ -->
    <section id="c04" class={`mt-20 pt-5 border-t-[3px] ${strong} scroll-mt-6`}>
      <div class={gutter}>
        <div>
          <span class="block font-mono text-4xl font-medium leading-none tracking-tight text-accent">04</span>
          <span class={`block ${mono} mt-2`}>La versione aziendale</span>
        </div>
        <div>
          <h2 class={h2}>Stessa base, altra profondità</h2>
          <p class="mt-3 text-text-muted leading-relaxed max-w-[42rem]">
            Lo stack è lo stesso e il servizio da strumentare è lo stesso. Cambia quanto tempo ha ogni passaggio e
            quanto lontano si arriva.
          </p>
        </div>
      </div>

      <div class="mt-8 max-w-[54rem] overflow-x-auto">
        <table class="w-full text-sm min-w-[36rem]">
          <thead>
            <tr>
              <th class={`text-left ${mono} font-normal pb-3 pr-6 border-b-2 ${strong}`}>aspetto</th>
              <th class={`text-left ${mono} font-normal pb-3 pr-6 border-b-2 ${strong}`}>due ore</th>
              <th class={`text-left ${mono} font-normal pb-3 border-b-2 ${strong}`}>tre giorni</th>
            </tr>
          </thead>
          <tbody>
            {aziendale.map(([a, due, tre]) => (
              <tr>
                <td class={`align-top py-3 pr-6 border-b ${hair} font-semibold text-text-dark dark:text-text-light`}>{a}</td>
                <td class={`align-top py-3 pr-6 border-b ${hair} text-text-muted`}>{due}</td>
                <td class={`align-top py-3 border-b ${hair} text-text-muted`}>{tre}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class={`mt-10 max-w-[54rem] ${gutter} pb-4 border-b-2 ${strong}`}>
        <span aria-hidden="true" />
        <h3 class={h3}>Come sono divisi i tre giorni</h3>
      </div>
      <dl class={`max-w-[54rem] ${gutter}`}>
        {giorni.map(([g, desc]) => (
          <>
            <dt class={`${mono} pt-3 pb-1 sm:pb-3 sm:border-b ${hair}`}>{g}</dt>
            <dd class={`text-sm text-text-muted pb-3 border-b ${hair}`}>{desc}</dd>
          </>
        ))}
      </dl>
    </section>

    <!-- ══ 05 ══ -->
    <section id="c05" class={`mt-20 pt-5 border-t-[3px] ${strong} scroll-mt-6`}>
      <div class={gutter}>
        <div>
          <span class="block font-mono text-4xl font-medium leading-none tracking-tight text-accent">05</span>
          <span class={`block ${mono} mt-2`}>I moduli</span>
        </div>
        <div>
          <h2 class={h2}>Da cosa è composto il percorso</h2>
          <p class="mt-3 text-text-muted leading-relaxed max-w-[42rem]">
            Il percorso si compone a moduli. Lo stack di lavoro è comune a tutti e resta a disposizione del team, e
            i componenti possono essere sostituiti con quelli in uso presso di voi. Gli importi non sono riportati:
            sono oggetto della proposta economica.
          </p>
        </div>
      </div>

      <div class={`mt-8 max-w-[54rem] border ${strong} rounded-sm overflow-hidden`}>
        <div class={`grid grid-cols-[6rem_1fr_auto] items-center bg-text-muted/5 border-b ${strong}`}>
          <span class={`font-mono text-sm tracking-[0.06em] text-accent px-4 py-3 border-r ${strong}`}>BASE</span>
          <h3 class="px-4 py-3 text-base md:text-lg font-bold tracking-tight text-text-dark dark:text-text-light">
            {base.nome}
          </h3>
          <span class="mr-4 px-3 py-0.5 rounded-sm bg-text-dark dark:bg-text-light text-white dark:text-text-dark font-mono text-xs whitespace-nowrap">
            2 h
          </span>
        </div>
        <div class={`grid grid-cols-1 sm:grid-cols-[6rem_1fr] border-b ${hair}`}>
          <span class={`${mono} px-4 pt-3 sm:py-3 sm:border-r ${hair}`}>Sempre incluso</span>
          <span class="px-4 py-3 text-sm text-text-muted leading-relaxed">{base.desc}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[6rem_1fr]">
