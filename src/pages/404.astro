---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<PageLayout title="Pagina non trovata">
  <div class="flex flex-col items-center justify-center text-center py-20">
    <h1 class="text-8xl font-bold text-accent mb-4">404</h1>
    <p class="text-xl text-text-muted mb-10">Questa pagina non esiste.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <Button href="/" variant="primary">Homepage</Button>
      <Button href="/blog/" variant="secondary">Blog</Button>
    </div>
  </div>
</PageLayout>
