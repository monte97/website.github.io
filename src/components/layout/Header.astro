---
import ThemeToggle from '@/components/interactive/ThemeToggle.vue';
import SearchModal from '@/components/interactive/SearchModal.vue';
import Logo from '@/assets/logo-fra.svg?raw';

interface Props {
  lang?: 'it' | 'en';
  /** URL della stessa pagina nell'altra lingua. `null` = non esiste, il pulsante sparisce. */
  altHref?: string | null;
}

const { lang = 'it', altHref } = Astro.props;

/**
 * Quattro voci, non sette. Il sito deve portare clienti: la barra dice cosa
 * vendi (Servizi), la prova che sai farlo (Lavori, Blog) e chi sei (About).
 *
 * Talks e Workshop restano vivi ai loro URL e si raggiungono da dove hanno
 * senso: /workshop/ e' linkato dalla pagina Servizi (e' un servizio anche
 * lui), /talks/ dalla pagina About e dal footer. Erano due voci di menu che
 * duplicavano link gia' presenti nelle pagine.
 *
 * "Lavori" al posto di "Case Study": e' il nome che il vault usa gia' per
 * queste schede, e dice a un cliente cosa trovera' senza chiedergli di
 * conoscere il gergo. La rotta resta /case-study/, cambia solo l'etichetta.
 */
const nav = {
  it: [
    { label: 'Servizi', href: '/servizi/' },
    { label: 'Lavori', href: '/case-study/' },
    { label: 'Blog', href: '/blog/' },
    { label: 'About', href: '/about/' },
  ],
  en: [
    { label: 'Services', href: '/en/services/' },
    { label: 'Work', href: '/en/case-study/' },
    { label: 'Blog', href: '/en/blog/' },
    { label: 'About', href: '/en/about/' },
  ],
};

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';
const ctaLabel = lang === 'en' ? 'Book a call' : 'Prenota una call';

const currentPath = Astro.url.pathname;

/**
 * Il selettore di lingua non puo' anteporre `/en` a occhi chiusi: non tutte le
 * pagine hanno un gemello, e uno slug non coincide (servizi/services).
 *
 * - `altHref` passato esplicitamente vince sempre: le pagine che conoscono il
 *   proprio gemello (gli articoli del blog) lo dichiarano.
 * - `altHref={null}` dice "questa pagina non ha traduzione": il pulsante sparisce.
 * - Se non viene passato niente, si calcola qui, e si torna `null` per le rotte
 *   che esistono solo in italiano.
 */
const SOLO_IT = [/^\/cv/, /^\/qr(\/|$)/, /^\/secret(\/|$)/, /^\/blog\/series\//, /^\/404/];

function altDiDefault(path: string, l: 'it' | 'en'): string | null {
  if (l === 'it') {
    if (SOLO_IT.some(r => r.test(path))) return null;
    if (path === '/servizi/' || path === '/servizi') return '/en/services/';
    return `/en${path}`;
  }
  if (path === '/en/services/' || path === '/en/services') return '/servizi/';
  return path.replace(/^\/en/, '') || '/';
}

const langSwitchHref = altHref !== undefined ? altHref : altDiDefault(currentPath, lang);

function isActive(href: string): boolean {
  if (href === '/' || href === '/en/') return currentPath === href;
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-base-light/95 dark:bg-base-dark/95 backdrop-blur-lg border-b border-border/60 dark:border-border-dark/60">
  <nav class="max-w-5xl mx-auto px-5 h-14 flex items-center justify-between">

    <!-- Logo -->
    <a href={lang === 'it' ? '/' : '/en/'} class="flex items-center gap-2.5 group">
      <span
        class="w-[61px] h-[52px] [&_svg]:w-full [&_svg]:h-full"
        set:html={Logo}
      />
      <span class="text-sm font-semibold text-text-dark dark:text-text-light tracking-tight hidden sm:inline">
        montelli.dev
      </span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1">
      {nav[lang].map(item => (
        <a
          href={item.href}
          class:list={[
            'px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200',
            isActive(item.href)
              ? 'text-accent bg-accent-subtle'
              : 'text-text-dark dark:text-text-light hover:text-accent hover:bg-accent-subtle',
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Right side actions -->
    <div class="flex items-center gap-2">
      <a
        href={calLink}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center justify-center font-medium rounded-md px-3 py-1.5 text-sm bg-accent text-white hover:bg-accent/90 shadow-sm transition-all"
        data-umami-event="cta-header"
      >
        {ctaLabel}
      </a>

      <SearchModal client:only="vue" />

      {langSwitchHref && (
        <a
          href={langSwitchHref}
          class="px-2 py-1 rounded-md text-xs font-bold uppercase tracking-wider text-text-muted hover:text-accent hover:bg-accent-subtle transition-all duration-200"
        >
          {lang === 'it' ? 'EN' : 'IT'}
        </a>
      )}

      <ThemeToggle client:load />

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-1.5 rounded-md hover:bg-accent-subtle transition-colors"
        aria-label="Menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border/60 dark:border-border-dark/60 bg-base-light dark:bg-base-dark px-5 py-3">
    <div class="flex flex-col gap-1">
      <a
        href={calLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mb-2 inline-flex items-center justify-center font-medium rounded-md px-3 py-2.5 text-sm bg-accent text-white hover:bg-accent/90 shadow-sm transition-all"
        data-umami-event="cta-header-mobile"
      >
        {ctaLabel}
      </a>
      {nav[lang].map(item => (
        <a
          href={item.href}
          class:list={[
            'px-3 py-2 rounded-md text-sm font-medium transition-all',
            isActive(item.href)
              ? 'text-accent bg-accent-subtle'
              : 'text-text-dark dark:text-text-light hover:text-accent hover:bg-accent-subtle',
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  }
  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
