---
import Button from '@/components/ui/Button.astro';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const text = {
  it: {
    heading: 'Parliamone.',
    sub: 'Se il tuo team sta crescendo e vuoi capire dove intervenire, parti da una discovery call gratuita di 30 minuti.',
    ctaPrimary: 'Richiedi un Health Check',
    emailLabel: 'oppure scrivimi',
  },
  en: {
    heading: "Let's talk.",
    sub: 'If your team is growing and you want to figure out where to act, start with a free 30-minute discovery call.',
    ctaPrimary: 'Request a Health Check',
    emailLabel: 'or write me',
  },
};

const t = text[lang];
---

<section class="py-24 border-t border-border/30 dark:border-border-dark/30 fade-in-section" aria-label={t.heading}>
  <div class="max-w-xl mx-auto px-5 text-center">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-text-dark dark:text-text-light mb-4">
      {t.heading}
    </h2>
    <p class="text-text-muted text-base mb-8 leading-relaxed">
      {t.sub}
    </p>
    <div class="flex flex-col items-center gap-3 mb-8">
      <Button href="https://cal.eu/monte97/30min" size="lg" data-umami-event="cta-contact-healthcheck">
        {t.ctaPrimary} &rarr;
      </Button>
      <a href="mailto:francesco@montelli.dev" class="text-sm text-text-muted hover:text-accent transition-colors" data-umami-event="click-email">
        {t.emailLabel}
      </a>
    </div>

    <div class="flex justify-center text-sm text-text-muted">
      <a href="https://linkedin.com/in/francesco-montelli" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors" data-umami-event="click-social" data-umami-event-platform="linkedin">
        LinkedIn
      </a>
    </div>
  </div>
</section>
