---
import FinalCta from '@/components/ui/FinalCta.astro';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const mailLink = 'mailto:francesco@montelli.dev';

const text = {
  it: {
    heading: 'Parliamone.',
    sub: '30 minuti, gratuiti, per capire se possiamo lavorare insieme.',
    ctaPrimary: 'Prenota una discovery call',
    emailLabel: 'oppure scrivimi',
    talksLabel: 'Talks',
  },
  en: {
    heading: "Let's talk.",
    sub: '30 minutes, free, to figure out if we can work together.',
    ctaPrimary: 'Book a discovery call',
    emailLabel: 'or write me',
    talksLabel: 'Talks',
  },
};

const t = text[lang];
---

<FinalCta
  title={t.heading}
  desc={t.sub}
  ctaLabel={t.ctaPrimary}
  secondaryLabel={t.emailLabel}
  secondaryHref={mailLink}
  umamiEvent="cta-contact-healthcheck"
  fullBleed
>
  <div class="mt-8 flex justify-center gap-5 text-sm">
    <a
      href="https://linkedin.com/in/francesco-montelli"
      target="_blank"
      rel="noopener noreferrer"
      class="text-white/70 hover:text-white transition-colors"
      data-umami-event="click-social"
      data-umami-event-platform="linkedin"
    >
      LinkedIn
    </a>
    <a href={`${prefix}/talks/`} class="text-white/70 hover:text-white transition-colors">
      {t.talksLabel}
    </a>
  </div>
</FinalCta>
