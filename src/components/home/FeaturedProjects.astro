---
import { getCollection } from 'astro:content';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getPillarLabel } from '@/data/pillars';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const text = {
  it: { title: 'Progetti selezionati', subtitle: 'Casi reali su cui ho lavorato.' },
  en: { title: 'Featured Projects', subtitle: 'Real cases I have worked on.' },
};

const t = text[lang];

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.weight - b.data.weight);

---

<section class="py-20 bg-surface/50 dark:bg-surface-dark/30 fade-in-section" aria-label={t.title}>
  <div class="max-w-5xl mx-auto px-5">
    <SectionHeading title={t.title} subtitle={t.subtitle} />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 stagger-children">
      {featured.map((project) => {
        const prefix = lang === 'en' ? '/en' : '';
        const href = `${prefix}/progetti/${project.id}/`;
        return (
          <a href={href} class="group block h-full" data-umami-event="click-project" data-umami-event-project={project.data.title}>
            <Card pillar={project.data.pillar}>
              <div class="flex items-start justify-between gap-3 mb-3">
                <h3 class="text-base font-bold text-text-dark dark:text-text-light group-hover:text-accent transition-colors">{project.data.title}</h3>
                <Badge pillar={project.data.pillar} class="shrink-0">
                  {getPillarLabel(project.data.pillar, lang)}
                </Badge>
              </div>
              <p class="text-text-muted text-sm mb-4 leading-relaxed flex-1">{project.data.description}</p>
              <span class="text-accent text-sm font-medium">
                {lang === 'it' ? 'Dettagli' : 'Details'} &rarr;
              </span>
            </Card>
          </a>
        );
      })}
    </div>
    <div class="mt-6 text-right">
      <a href={lang === 'en' ? '/en/progetti/' : '/progetti/'} class="text-sm text-accent font-medium hover:underline underline-offset-4">
        {lang === 'it' ? 'Tutti i progetti' : 'All projects'} &rarr;
      </a>
    </div>
  </div>
</section>
