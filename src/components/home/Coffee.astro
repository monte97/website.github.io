---
/**
 * Chiusura della home: "Un caffè?" e quattro modi per sentirsi,
 * nello stesso stile a icone di "Come lavoro". Ancora #contatti per le CTA.
 */
interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const icons = {
  cal: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/>',
  chat: '<path d="M5 5h14v10H8l-3 3z"/>',
  mail: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 7l9 6 9-6"/>',
  mic: '<path d="M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z"/><path d="M6 11a6 6 0 0 0 12 0M12 17v4"/>',
};

const text = {
  it: {
    h: 'Un caffè?',
    pre: 'Mi racconti cosa state costruendo. Se posso aiutarvi te lo dico, ',
    em: 'se no ti dico chi può',
    ways: [
      { i: 'cal', b: 'Una call di 30 minuti', d: 'Scegli tu giorno e ora, gratis.', l: 'Prenota →', href: 'https://cal.com/francesco-montelli-4hfojq/30min', primary: true, ev: 'contatti-call' },
      { i: 'chat', b: 'Un messaggio su LinkedIn', d: 'Anche solo per conoscerci.', l: 'Scrivimi →', href: 'https://linkedin.com/in/francesco-montelli', ev: 'contatti-linkedin' },
      { i: 'mail', b: 'Una mail', d: 'Se preferisci spiegarmi con calma.', l: 'francesco@montelli.dev', href: 'mailto:francesco@montelli.dev', ev: 'contatti-email' },
      { i: 'mic', b: 'Di persona', d: 'A DevRomagna o alla prossima conferenza.', l: 'Dove parlo →', href: `${prefix}/talks/`, ev: 'contatti-talks' },
    ],
  },
  en: {
    h: 'Coffee?',
    pre: "Tell me what you're building. If I can help, I'll tell you; ",
    em: "if not, I'll tell you who can",
    ways: [
      { i: 'cal', b: 'A 30-minute call', d: 'You pick the day and time, free.', l: 'Book →', href: 'https://cal.com/francesco-montelli-4hfojq/30min', primary: true, ev: 'contatti-call' },
      { i: 'chat', b: 'A LinkedIn message', d: 'Even just to get to know each other.', l: 'Write me →', href: 'https://linkedin.com/in/francesco-montelli', ev: 'contatti-linkedin' },
      { i: 'mail', b: 'An email', d: 'If you prefer to explain at your own pace.', l: 'francesco@montelli.dev', href: 'mailto:francesco@montelli.dev', ev: 'contatti-email' },
      { i: 'mic', b: 'In person', d: 'At DevRomagna or the next conference.', l: 'Where I speak →', href: `${prefix}/talks/`, ev: 'contatti-talks' },
    ],
  },
};

const t = text[lang];
---

<section id="contatti" class="scroll-mt-16 py-20 md:py-24 bg-surface dark:bg-surface-dark" aria-label={t.h}>
  <div class="max-w-5xl mx-auto px-5">
    <h2 class="text-3xl md:text-[2.75rem] font-extrabold tracking-tight text-text-dark dark:text-text-light">{t.h}</h2>
    <p class="mt-3 max-w-2xl text-lg text-text-muted leading-relaxed">{t.pre}<strong class="text-accent font-bold">{t.em}</strong>.</p>

    <div class="mt-10 grid md:grid-cols-4 border-y border-border dark:border-border-dark">
      {t.ways.map((w, i) => (
        <div class:list={['flex flex-col py-6 md:px-5', i > 0 ? 'border-t md:border-t-0 md:border-l border-border dark:border-border-dark' : 'md:pl-0']}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 text-accent" set:html={icons[w.i as keyof typeof icons]} aria-hidden="true"></svg>
          <p class="mt-3.5 font-bold text-text-dark dark:text-text-light">{w.b}</p>
          <p class="mt-1 text-[15px] text-text-muted leading-snug flex-1">{w.d}</p>
          <a
            href={w.href}
            {...(w.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class:list={[
              'mt-3.5 text-[15px] font-semibold',
              w.primary ? 'self-start rounded-lg bg-accent px-4 py-2.5 text-white hover:bg-accent-hover transition-colors' : 'text-accent hover:underline break-all',
            ]}
            data-umami-event={w.ev}
          >{w.l}</a>
        </div>
      ))}
    </div>
  </div>
</section>
