---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { pillarStyles } from '@/data/pillar-styles';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const text = {
  it: {
    eyebrow: 'Il metodo',
    title: 'Tre pilastri in un ordine preciso. Togline uno e gli altri due perdono efficacia.',
    intro: "Saltare uno step non fa risparmiare tempo: sposta solo il dolore più avanti.",
    cards: [
      {
        key: 'progettare' as const,
        order: '01',
        title: 'Progettare',
        body: 'Non si torna indietro senza pagare. Per questo le decisioni di design vengono prima di tutto.',
      },
      {
        key: 'verificare' as const,
        order: '02',
        title: 'Verificare',
        body: "Sapere che funziona davvero: sotto carico, sotto attacco, nel tempo. Senza questo, automatizzare amplifica solo i guasti.",
      },
      {
        key: 'automatizzare' as const,
        order: '03',
        title: 'Automatizzare',
        body: "Solo dopo aver progettato e verificato. L'automazione amplifica tutto quello che le sta sopra, errori compresi.",
      },
    ],
    cta: 'Il metodo nei servizi →',
  },
  en: {
    eyebrow: 'The method',
    title: 'Three pillars in a deliberate order. Take one away and the other two lose their edge.',
    intro: "Skipping a step doesn't save time. It just pushes the pain further down the line.",
    cards: [
      {
        key: 'progettare' as const,
        order: '01',
        title: 'Design',
        body: "There's no going back without paying. That's why design decisions come first.",
      },
      {
        key: 'verificare' as const,
        order: '02',
        title: 'Verify',
        body: 'Making sure it actually works: under load, under attack, over time. Without this, automation just amplifies the failures.',
      },
      {
        key: 'automatizzare' as const,
        order: '03',
        title: 'Automate',
        body: 'Only after designing and verifying. Automation amplifies everything sitting above it, mistakes included.',
      },
    ],
    cta: 'The method in services →',
  },
};

const t = text[lang];
---

<section class="py-20 fade-in-section" aria-label={t.eyebrow}>
  <div class="max-w-5xl mx-auto px-5">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.intro} class="mb-10" />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 stagger-children">
      {t.cards.map((card) => {
        const c = pillarStyles[card.key];
        return (
          <div
            class:list={[
              'surface-card border-l-[3px] p-6',
              c.borderLeft,
            ]}
          >
            <div class="flex items-baseline gap-3 mb-3">
              <span class={`text-sm font-mono ${c.text}`}>{card.order}</span>
              <h3 class={`text-lg font-bold ${c.text}`}>{card.title}</h3>
            </div>
            <p class="text-text-muted text-sm leading-relaxed">
              {card.body}
            </p>
          </div>
        );
      })}
    </div>

    <div class="mt-10">
      <a
        href={lang === 'en' ? '/en/services/' : '/servizi/'}
        class="text-accent font-medium hover:underline inline-flex items-baseline gap-1"
      >
        {t.cta}
      </a>
    </div>
  </div>
</section>
