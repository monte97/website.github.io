---
import Button from '@/components/ui/Button.astro';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';

const text = {
  it: {
    greeting: 'Ciao, sono Monte.',
    headline: 'Quando il sistema inizia a scricchiolare,',
    headlineAccent: "arrivo prima che diventi un'emergenza.",
    subtitle: 'Software Engineer freelance per sistemi distribuiti. Aiuto team in crescita a cogliere i segnali prima che diventino guasti, e a costruire la disciplina perché non tornino.',
    credential: "Iscritto all'Ordine degli Ingegneri di Ravenna",
    cta: 'Prenota una discovery call',
  },
  en: {
    greeting: "Hi, I'm Monte.",
    headline: 'When the system starts to creak,',
    headlineAccent: 'I step in before it turns into an emergency.',
    subtitle: 'Freelance Software Engineer for distributed systems. I help growing teams catch the signals before they become outages, and build the discipline that keeps them from coming back.',
    credential: 'Registered with the Italian Order of Engineers (Ravenna)',
    cta: 'Book a discovery call',
  },
};

const t = text[lang];
---

<section class="relative overflow-hidden border-b border-border/30 dark:border-border-dark/30" aria-label={t.greeting}>
  <div class="absolute inset-0 opacity-[0.04] dark:opacity-[0.07]" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-dots" width="32" height="32" patternUnits="userSpaceOnUse">
          <circle cx="16" cy="16" r="1" fill="currentColor" class="text-text-dark dark:text-text-light" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-dots)" />
    </svg>
  </div>

  <div class="absolute top-0 right-0 w-96 h-96 bg-accent/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3" aria-hidden="true"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-5 pt-24 pb-20 md:pt-32 md:pb-28">
    <div class="flex flex-col md:flex-row md:items-center md:gap-16">

      <div class="shrink-0 mb-8 md:mb-0">
        <img
          src="/images/author/monte.webp"
          alt="Francesco Montelli"
          width="144"
          height="144"
          loading="eager"
          fetchpriority="high"
          class="w-28 h-28 md:w-36 md:h-36 rounded-full object-cover shadow-lg ring-4 ring-accent"
        />
      </div>

      <div class="flex-1">
        <p class="text-accent font-semibold text-base md:text-lg mb-3 tracking-tight">
          {t.greeting}
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-[1.15] tracking-tight text-text-dark dark:text-text-light">
          {t.headline}
          <br />
          <span class="text-accent">{t.headlineAccent}</span>
        </h1>
        <p class="mt-5 text-base md:text-lg text-text-muted max-w-xl leading-relaxed">
          {t.subtitle}
        </p>
        <p class="mt-2 text-xs text-text-muted/70">
          {t.credential}
        </p>
        <div class="mt-8">
          <Button href={calLink} size="lg" data-umami-event="cta-hero-healthcheck">
            {t.cta} &rarr;
          </Button>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-text-muted/50">
      <path d="M7 10l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>
