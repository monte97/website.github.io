---
import Button from '@/components/ui/Button.astro';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';

const text = {
  it: {
    greeting: 'Ciao, sono Monte.',
    headline: 'Il codice lo produce anche la macchina.',
    headlineAccent: 'Io costruisco il sistema che lo fa reggere.',
    subtitle: 'Progetto, sviluppo e automatizzo il software del tuo prodotto, e il team resta capace di andare avanti da solo.',
    cta: 'Prenota una discovery call',
  },
  en: {
    greeting: "Hi, I'm Monte.",
    headline: 'Machines write code too.',
    headlineAccent: 'I build the system that keeps it standing.',
    subtitle: "I design, build and automate the software behind your product, and the team stays able to carry on without me.",
    cta: 'Book a discovery call',
  },
};

const t = text[lang];
---

<section class="relative bg-base-light dark:bg-base-dark border-b border-border/30 dark:border-border-dark/30" aria-label={t.greeting}>
  <div class="relative z-10 max-w-5xl mx-auto px-5 pt-24 pb-20 md:pt-32 md:pb-28">
    <div class="flex flex-col md:flex-row md:items-center md:gap-16">

      <div class="shrink-0 mb-8 md:mb-0">
        <img
          src="/images/author/monte-palco.webp"
          alt="Francesco Montelli sul palco del DevSecOps Day"
          width="224"
          height="224"
          loading="eager"
          fetchpriority="high"
          class="w-40 h-40 md:w-56 md:h-56 rounded-full object-cover shadow-lg ring-4 ring-accent"
        />
      </div>

      <div class="flex-1">
        <p class="text-accent font-semibold text-base md:text-lg mb-3 tracking-tight">
          {t.greeting}
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-[1.15] tracking-tight text-text-dark dark:text-text-light">
          {t.headline}
          <br />
          <span class="text-accent">{t.headlineAccent}</span>
        </h1>
        <p class="mt-6 text-lg md:text-2xl text-text-dark/80 dark:text-text-light/80 max-w-2xl leading-snug">
          {t.subtitle}
        </p>
        <div class="mt-8">
          <Button href={calLink} size="lg" data-umami-event="cta-hero-healthcheck">
            {t.cta} &rarr;
          </Button>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-4 left-1/2 -translate-x-1/2" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-text-muted/50">
      <path d="M7 10l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>
