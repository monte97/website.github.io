---
/**
 * Hero della home: la foto dal palco del DevSecOps Day a tutto schermo
 * (versione lavorata da Maurizio), la frase di posizionamento e due CTA.
 * L'header sopra e' in modalita' overlay (trasparente finche' si e' sulla foto).
 * Su telefono la foto sta sopra e il testo sotto, per non coprire il volto.
 */
interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';

const text = {
  it: {
    l1: 'Il codice lo produce anche la macchina.',
    pre: 'Io ',
    a1: 'costruisco',
    mid: ' il sistema che lo fa ',
    a2: 'reggere',
    end: '.',
    sub: 'Software engineer freelance: progetto, sviluppo e automatizzo software, da zero o su sistemi già in produzione.',
    cta: 'Prenota 30 minuti',
    cta2: 'Scrivimi, anche solo per due chiacchiere',
    alt: 'Francesco Montelli sul palco del DevSecOps Day',
  },
  en: {
    l1: 'Machines write code too.',
    pre: 'I ',
    a1: 'build',
    mid: ' the system that keeps it ',
    a2: 'standing',
    end: '.',
    sub: 'Freelance software engineer: I design, build and automate software, from scratch or on systems already in production.',
    cta: 'Book 30 minutes',
    cta2: 'Write me, even just for a chat',
    alt: 'Francesco Montelli on stage at DevSecOps Day',
  },
};

const t = text[lang];
---

<section id="hero" class="hero-home relative bg-[#16161d] text-white overflow-hidden" aria-label={t.l1}>
  <img
    src="/images/home/palco.webp"
    alt={t.alt}
    width="830"
    height="724"
    loading="eager"
    fetchpriority="high"
    class="hero-img"
  />
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-inner relative z-10 max-w-5xl mx-auto px-5">
    <h1 class="text-[2.3rem] leading-[1.06] sm:text-5xl md:text-[3.9rem] font-extrabold tracking-tight max-w-[700px]">
      {t.l1} {t.pre}<span class="text-accent">{t.a1}</span>{t.mid}<span class="text-accent">{t.a2}</span>{t.end}
    </h1>
    <p class="mt-5 text-lg md:text-xl text-white/85 max-w-xl">{t.sub}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={calLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center rounded-lg bg-accent px-5 py-3.5 font-semibold text-white hover:bg-accent-hover transition-colors"
        data-umami-event="cta-hero-call"
      >{t.cta}</a>
      <a
        href="#contatti"
        class="inline-flex items-center rounded-lg border-[1.5px] border-white/90 px-5 py-3.5 font-semibold text-white hover:bg-white/10 transition-colors"
        data-umami-event="cta-hero-contatti"
      >{t.cta2}</a>
    </div>
  </div>
</section>

<style>
  .hero-home { display: flex; align-items: flex-end; min-height: 88vh; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right 30%; }
  .hero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(20,20,28,.55) 0%, rgba(20,20,28,0) 18%),
      linear-gradient(90deg, rgba(20,20,28,.88) 0%, rgba(20,20,28,.55) 45%, rgba(20,20,28,.05) 75%);
  }
  .hero-inner { width: 100%; padding-bottom: 5rem; }

  @media (max-width: 767px) {
    .hero-home { display: block; min-height: 0; padding-top: calc(100vw * 724 / 830 - 70px); }
    .hero-img { inset: 0 0 auto 0; height: auto; aspect-ratio: 830 / 724; object-position: center; }
    .hero-shade {
      background: linear-gradient(180deg, rgba(20,20,28,.5) 0, rgba(20,20,28,0) 90px,
        rgba(20,20,28,0) calc(100vw * 724 / 830 - 160px), #16161d calc(100vw * 724 / 830 - 70px));
    }
    .hero-inner { padding-bottom: 2.75rem; }
  }
</style>
