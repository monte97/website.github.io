---
import Button from '@/components/ui/Button.astro';
import { author } from '@/data/author';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const text = {
  it: {
    title: 'Chi sono',
    aboutCta: 'Di più su di me',
    cvCta: 'Scarica CV',
  },
  en: {
    title: 'About me',
    aboutCta: 'More about me',
    cvCta: 'Download CV',
  },
};

const t = text[lang];
---

<section class="py-20 bg-surface/50 dark:bg-surface-dark/30 fade-in-section" aria-label={t.title}>
  <div class="max-w-2xl mx-auto px-5 text-center">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-text-dark dark:text-text-light mb-5">
      {t.title}
    </h2>
    <p class="text-text-muted text-base leading-relaxed mb-8">
      {author.bio[lang]}
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href="/about/" variant="secondary" size="sm">{t.aboutCta} &rarr;</Button>
      <Button href="/files/Francesco_Montelli_CV.pdf" variant="ghost" size="sm">{t.cvCta} (PDF)</Button>
    </div>
  </div>
</section>
