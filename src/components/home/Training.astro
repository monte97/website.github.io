---
import SectionHeading from '@/components/ui/SectionHeading.astro';
/**
 * La formazione, in home: i percorsi che vengono erogati, con abbastanza testo
 * per capire cosa si porta a casa. Sta piu' in basso delle prove perche' e' la
 * seconda cosa che si vende, non la prima.
 */
import { getWorkshops } from '@/utils/workshop';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const workshops = await getWorkshops();

const t = lang === 'en'
  ? {
      eyebrow: 'Training',
      title: 'Or I train the team',
      intro: 'When the problem is not building but knowing how: a path run with the team, on your stack.',
      all: 'The workshops',
      modules: (n: number) => `${n} modules`,
      delivered: 'Already delivered',
    }
  : {
      eyebrow: 'Formazione',
      title: 'Oppure formo il team',
      intro: 'Quando il problema non è costruire ma saper fare: un percorso con il team, sul vostro stack.',
      all: 'I workshop',
      modules: (n: number) => `${n} moduli`,
      delivered: 'Già erogato',
    };
---

<section class="py-20 border-t border-border/30 dark:border-border-dark/30 fade-in-section" aria-label={t.eyebrow}>
  <div class="max-w-5xl mx-auto px-5">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.intro} />

    <div class="grid md:grid-cols-3 gap-4">
      {/* Le landing dei singoli workshop sono solo in italiano: in inglese
          le schede portano all'indice, che esiste in entrambe. */}
      {workshops.map((w) => (
        <a href={lang === 'en' ? '/en/workshop/' : `/workshop/${w.slug}/`}
          class="group surface-link block p-5">
          <p class="label-mono !text-accent">{t.modules(w.moduleCount)}{w.delivered ? ` · ${t.delivered}` : ''}</p>
          <h3 class="mt-2 font-semibold text-text-dark dark:text-text-light leading-snug group-hover:text-accent transition-colors">
            {lang === 'en' ? w.titleEn : w.title}
          </h3>
          <p class="mt-2 text-sm text-text-muted leading-relaxed line-clamp-4">{lang === 'en' ? w.goalEn : w.goal}</p>
        </a>
      ))}
    </div>

    <p class="mt-6">
      <a href={`${prefix}/workshop/`} class="text-sm font-semibold text-accent hover:underline">{t.all} &rarr;</a>
    </p>
  </div>
</section>
