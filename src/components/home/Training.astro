---
/**
 * La formazione, in home: una riga sola con i percorsi che vengono erogati.
 * Sta piu' in basso delle prove perche' e' la seconda cosa che si vende, non la
 * prima.
 */
import { getWorkshops } from '@/utils/workshop';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const workshops = await getWorkshops();

const t = lang === 'en'
  ? {
      eyebrow: 'Training',
      title: 'Or I train the team',
      intro: 'When the problem is not building but knowing how: a path run with the team, on your stack.',
      all: 'The workshops',
    }
  : {
      eyebrow: 'Formazione',
      title: 'Oppure formo il team',
      intro: 'Quando il problema non è costruire ma saper fare: un percorso con il team, sul vostro stack.',
      all: 'I workshop',
    };
---

<section class="py-20 border-t border-border/30 dark:border-border-dark/30 fade-in-section" aria-label={t.eyebrow}>
  <div class="max-w-5xl mx-auto px-5">
    <p class="label-mono !text-accent">{t.eyebrow}</p>
    <h2 class="mt-3 text-2xl md:text-3xl font-bold tracking-tight text-text-dark dark:text-text-light">{t.title}</h2>
    <p class="mt-4 text-text-muted leading-relaxed max-w-2xl">{t.intro}</p>

    <ul class="flex flex-wrap gap-3 mt-8">
      {workshops.map((w) => (
        <li>
          {/* Le landing dei singoli workshop sono solo in italiano: in inglese
              le pastiglie portano all'indice, che esiste in entrambe. */}
          <a href={lang === 'en' ? '/en/workshop/' : `/workshop/${w.slug}/`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg surface-link text-sm font-medium text-text-dark dark:text-text-light">
            {lang === 'en' ? w.titleEn : w.title}
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-6">
      <a href={`${prefix}/workshop/`} class="text-sm font-semibold text-accent hover:underline">{t.all} &rarr;</a>
    </p>
  </div>
</section>
