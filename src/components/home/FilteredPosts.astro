---
import { getCollection } from 'astro:content';
import PostCard from '@/components/blog/PostCard.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getPillarLabel } from '@/data/pillars';
import { postHref } from '@/utils/blog';

interface Props {
  lang?: 'it' | 'en';
  count?: number;
}

const { lang = 'it', count = 5 } = Astro.props;

const text = {
  it: { title: 'Ultimi articoli', subtitle: 'Quello che imparo, lo scrivo.' },
  en: { title: 'Latest posts', subtitle: 'What I learn, I write down.' },
};

const t = text[lang];

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => p.data.lang === lang && !p.data.draft && p.data.pillar !== null)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, count);

const [featured, ...rest] = posts;

const featuredDate = featured?.data.date.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

---

<section class="py-20 border-t border-border/30 dark:border-border-dark/30 fade-in-section" aria-label={t.title}>
  <div class="max-w-5xl mx-auto px-5">
    <div class="flex items-end justify-between mb-10">
      <SectionHeading title={t.title} subtitle={t.subtitle} />
      <a href={lang === 'en' ? '/en/blog/' : '/blog/'} class="text-accent text-sm font-medium hover:underline underline-offset-4 shrink-0 hidden md:block">
        {lang === 'it' ? 'Tutti gli articoli' : 'All posts'} &rarr;
      </a>
    </div>

    {/* Featured post — full width */}
    {featured && (
      <a href={postHref(featured.id, lang)} class="group block mb-6" data-umami-event="blog-read" data-umami-event-pillar={featured.data.pillar ?? ''} data-umami-event-category={featured.data.category ?? ''}>
        <div class="surface-link p-6">
          <div class="flex items-center gap-2 mb-3">
            <time class="text-xs text-text-muted tabular-nums" datetime={featured.data.date.toISOString()}>
              {featuredDate}
            </time>
            {featured.data.pillar && (
              <Badge pillar={featured.data.pillar}>
                {getPillarLabel(featured.data.pillar, lang)}
              </Badge>
            )}
          </div>
          <h3 class="text-xl font-bold mb-2 text-text-dark dark:text-text-light group-hover:text-accent transition-colors leading-snug">
            {featured.data.title}
          </h3>
          <p class="text-text-muted text-sm leading-relaxed">
            {featured.data.description}
          </p>
        </div>
      </a>
    )}

    {/* Remaining posts — 2-col grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 stagger-children">
      {rest.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          pillar={post.data.pillar}
          category={post.data.category}
          tags={post.data.tags}
          href={postHref(post.id, lang)}
          lang={lang}
        />
      ))}
    </div>
    <div class="text-center mt-8 md:hidden">
      <a href={lang === 'en' ? '/en/blog/' : '/blog/'} class="text-accent text-sm font-medium hover:underline underline-offset-4">
        {lang === 'it' ? 'Tutti gli articoli' : 'All posts'} &rarr;
      </a>
    </div>
  </div>
</section>
