---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Button from '@/components/ui/Button.astro';
import { postHref } from '@/utils/blog';
import { pillarStyles } from '@/data/pillar-styles';
import { pillarLabels, type Pillar } from '@/data/pillars';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';
const mailLink = 'mailto:francesco@montelli.dev';

const services = (await getCollection('services')).sort((a, b) => a.data.weight - b.data.weight);
const rendered = await Promise.all(
  services.map(async (service) => {
    const { Content } = await render(service);
    return { service, Content };
  })
);

const byPillar = (p: Pillar) => rendered.find(({ service }) => service.data.pillar === p);

const pillarOrder: Array<{
  pillar: Pillar;
  anchor: string;
  order: string;
  why: { it: string; en: string };
}> = [
  {
    pillar: 'progettare',
    anchor: 'architecture',
    order: '01',
    why: {
      it: 'Le decisioni architetturali sono le più costose da cambiare in corsa. Vengono prima di tutto: se la base è sbagliata, qualsiasi cosa ci costruisci sopra eredita il problema.',
      en: 'Architectural decisions are the most expensive ones to change later. They come first: if the foundation is wrong, anything you build on top of it inherits the problem.',
    },
  },
  {
    pillar: 'verificare',
    anchor: 'observability-security',
    order: '02',
    why: {
      it: 'Una volta progettato, devi sapere che funziona davvero. Sotto carico, sotto attacco, nel tempo. Senza verifica, automatizzare significa solo amplificare i guasti.',
      en: "Once it's designed, you need to know it actually works. Under load, under attack, over time. Without verification, automating just means amplifying the failures.",
    },
  },
  {
    pillar: 'automatizzare',
    anchor: 'pipeline-automation',
    order: '03',
    why: {
      it: "Solo dopo aver progettato e verificato. L'automazione amplifica tutto quello che le sta sopra, errori compresi. Per questo è l'ultimo step, non il primo.",
      en: "Only after designing and verifying. Automation amplifies everything sitting above it, mistakes included. That's why it's the last step, not the first.",
    },
  },
];

const allProjects = (await getCollection('projects')).filter(
  (p) => p.data.type === 'project',
);
const projectById = new Map(allProjects.map((p) => [p.id, p]));

const caseStudyIdsByPillar: Record<Pillar, string[]> = {
  progettare: ['order-processing-platform'],
  verificare: ['observability-as-a-service', 'keycloak-dotnet-adoption'],
  automatizzare: ['pipeline-cicd-proxmox'],
};

const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft && p.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postsByPillar: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  if (post.data.pillar) {
    if (!postsByPillar[post.data.pillar]) postsByPillar[post.data.pillar] = [];
    if (postsByPillar[post.data.pillar].length < 2) {
      postsByPillar[post.data.pillar].push(post);
    }
  }
}

const locale = lang === 'en' ? 'en-US' : 'it-IT';

type Scenario = { scenario: string; problem: string };
const scenarios: Scenario[] = lang === 'en'
  ? [
      { scenario: 'Design without verification', problem: "Good intentions with no proof. The system works as long as nothing changes." },
      { scenario: 'Tests without CI/CD', problem: "Run by hand, when someone remembers. Eventually, nobody runs them at all." },
      { scenario: 'CI/CD without observability', problem: "You know the deploy went through. You don't know whether the system actually works." },
      { scenario: 'Observability without tests', problem: "You see the problems in production, but you can't prevent them. You're stuck in reactive mode." },
      { scenario: 'All three together', problem: 'You design consciously → verify automatically → observe in production.' },
    ]
  : [
      { scenario: 'Design senza verifica', problem: 'Buone intenzioni senza prove. Il sistema funziona finché non cambia niente.' },
      { scenario: 'Test senza CI/CD', problem: 'Vengono eseguiti a mano, quando ci si ricorda. Con il tempo si smette.' },
      { scenario: 'CI/CD senza observability', problem: 'Sai che il deploy è andato a buon fine. Non sai se il sistema funziona davvero.' },
      { scenario: 'Observability senza test', problem: 'Vedi i problemi in produzione, ma non puoi prevenirli. Sei sempre in modalità reattiva.' },
      { scenario: 'Tutti e tre insieme', problem: 'Progetti consapevolmente → verifichi automaticamente → osservi in produzione.' },
    ];

const t = lang === 'en'
  ? {
      pageTitle: 'Services',
      pageDesc: 'Free discovery call, a focused one-week Health Check with a report and concrete moves, ongoing engagement with written objectives. Three pillars, one deliberate order.',
      heroTitle: 'I build software. And I build the system that keeps it standing.',
      heroSubtitle: 'From greenfield projects to systems creaking in production: we work together one step at a time. No leap of faith required.',
      heroStepperLabel: 'The three steps of the path',
      caseStudyLabel: 'Case study',
      discoveryPriceMain: 'Free',
      discoveryPriceSub: '30 minutes, no strings',
      step2PriceMain: '€700',
      step2PriceSub: '1 week · money-back guarantee',
      step3PriceMain: 'from €2,500/mo',
      step3PriceSub: '€2,000/mo on a quarterly plan',
      // ── Funnel section ──
      // Step 1 — Discovery call
      step1Eyebrow: 'Step 1 · Free',
      discoveryTitle: 'Discovery call',
      discoveryLead: "A 30-minute call. Free, no strings attached. The fastest way to find out whether we can work together, and whether you actually need someone like me.",
      discoveryWhatTitle: 'What we cover',
      discoveryWhat: [
        'Where you are now: architecture, processes, the things that scare you in production',
        'Where you want to get to: the goal, the constraints, the deadline',
        "The symptoms: what's hurting today, and how often",
        "Or: what you're about to build. If the system doesn't exist yet, this is the best time to start right",
      ],
      discoveryDeliverableTitle: 'What you walk away with',
      discoveryDeliverable: [
        'A technical read on the problem, not generic advice',
        'A concrete next step, whether it involves me or not',
        "An honest answer: yes I can help, or no I can't.",
      ],
      discoveryDurationLabel: 'Duration',
      discoveryDuration: '30 minutes',
      discoveryCostLabel: 'Cost',
      discoveryCostFree: 'Free',
      discoveryCta: 'Book on Cal.com',
      step1Closing: "A call can lead anywhere: a quick piece of advice, a focused fix, or the Health Check if it's worth digging deeper. And if you need nothing, I'll tell you: that's a good outcome too.",
      // Step 2 — Health Check
      step2Eyebrow: 'Step 2 · The diagnosis',
      step2Title: 'Health Check',
      step2Subtitle: "One week inside your system: by the end you know what needs fixing, and you know what working with me is like.",
      step2Body1: "In the discovery call we pick the area to start from: observability, testing, deploy pipelines, access management, or architecture. For one week I go deep there: I talk to the people who work on it, look at the code and tooling, and find what's actually holding you back.",
      step2DeliverableTitle: 'What you walk away with:',
      step2Deliverables: [
        'A clear read of that area: what holds, what creaks, what’s missing',
        'The concrete moves to make, ordered by cost-to-risk ratio',
        'Where possible, a first fix already done: a result to build on, not just a document',
      ],
      step2Body2: "The report is yours: use it with me, with your team, or with anyone else. No lock-in, no long contract to sign. And if you're not satisfied at the end, I'll refund you: no questions asked.",
      step2DurationLabel: 'Duration',
      step2Duration: '1 week',
      step2CostLabel: 'Cost',
      step2Cost: '€700, fixed price',
      step2Cta: 'Start with the discovery call',
      // Step 3 — Ongoing engagement
      step3Eyebrow: 'Step 3 · Ongoing',
      step3Title: 'Ongoing engagement',
      step3Subtitle: 'The path to close what the Health Check opened.',
      step3Lead: "One active goal at a time, measurable and agreed before we start. We close it, the next one begins: no shopping list, no twenty half-finished things.",
      step3Items: [
        'Hands-on, not just advice: development, integrations, pieces of platform',
        'Everything with the system included: tests that actually catch things, observability, documented decisions',
        'Without internal technical leadership, I also act as external direction: roadmap, tooling choices, hiring support',
      ],
      step3Outro: "The end goal is to make myself unnecessary: the system and the team shouldn’t depend on me. It’s built to shrink over time, and that’s a success.",
      step3DurationLabel: 'Commitment',
      step3Duration: 'one active project at a time · written objectives, reviewed each quarter',
      step3CostLabel: 'Cost',
      step3Cost: 'from €2,500/month (€6,750/quarter)',
      step3Closing: 'Most engagements start with a Health Check. If the problem is already clear, the discovery call is enough.',
      // ── Method ──
      methodTitle: 'The method',
      methodIntro: "Everything I do inside a Health Check or an ongoing engagement follows the same method: three pillars that multiply, not three services that add up. Each builds on the previous. The order is not a detail: it’s the difference between building and rebuilding.",
      whyLabel: 'Why this order',
      blogLabel: 'From the blog',
      scenariosTitle: 'Why the order matters',
      scenariosIntro: 'What happens when you skip a pillar. Or all of them.',
      scenariosScenarioCol: 'Scenario',
      scenariosProblemCol: 'What goes wrong',
      ctaTitle: 'Want to talk?',
      ctaDesc: "30 minutes to figure out whether we can work together. No commitment, no slides.",
      ctaPrimary: 'Book a call',
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'Servizi',
      pageDesc: 'Discovery call gratuita, un Health Check mirato di una settimana con report e mosse concrete, affiancamento con obiettivi scritti. Tre pilastri, un ordine preciso.',
      heroTitle: 'Costruisco software. E costruisco il sistema che lo tiene in piedi.',
      heroSubtitle: "Dal progetto che parte da zero al sistema che scricchiola in produzione: lavoriamo insieme un passo alla volta. Niente salti nel vuoto.",
      heroStepperLabel: 'I tre passi del percorso',
      caseStudyLabel: 'Case study',
      discoveryPriceMain: 'Gratis',
      discoveryPriceSub: '30 minuti, senza impegno',
      step2PriceMain: '€700',
      step2PriceSub: '1 settimana · soddisfatto o rimborsato',
      step3PriceMain: 'da €2.500/mese',
      step3PriceSub: '€2.000/mese sul trimestre',
      // ── Sezione funnel ──
      // Gradino 1 — Discovery call
      step1Eyebrow: 'Passo 1 · Gratuito',
      discoveryTitle: 'Discovery call',
      discoveryLead: 'Una chiamata di 30 minuti. Gratuita, senza impegno. Il modo più rapido per capire se possiamo lavorare insieme, e se serve davvero qualcuno come me.',
      discoveryWhatTitle: 'Di cosa parliamo',
      discoveryWhat: [
        'Dove sei ora: architettura, processi, le cose che ti fanno paura in produzione',
        'Dove vuoi andare: obiettivo, vincolo, scadenza',
        'I sintomi: cosa fa male oggi e con che frequenza',
        'Oppure: cosa stai per costruire. Se il sistema ancora non esiste, è il momento migliore per partire bene',
      ],
      discoveryDeliverableTitle: 'Cosa ti porti a casa',
      discoveryDeliverable: [
        'Una lettura tecnica del problema, non consigli generici',
        'Un prossimo passo concreto, che coinvolga me o meno',
        'Una risposta onesta: posso aiutarti o no.',
      ],
      discoveryDurationLabel: 'Durata',
      discoveryDuration: '30 minuti',
      discoveryCostLabel: 'Costo',
      discoveryCostFree: 'Gratuita',
      discoveryCta: 'Prenota su Cal.com',
      step1Closing: "Da una call può nascere di tutto: un consiglio al volo, un intervento mirato, oppure l’Health Check se vale la pena scavare. E se non serve niente, te lo dico: è comunque una buona notizia.",
      // Gradino 2 — Health Check
      step2Eyebrow: 'Passo 2 · La diagnosi',
      step2Title: 'Health Check',
      step2Subtitle: "Una settimana dentro il tuo sistema: alla fine sai cosa va sistemato, e sai com’è lavorare con me.",
      step2Body1: "In discovery scegliamo l’area da cui partire: observability, test, pipeline di deploy, gestione degli accessi o architettura. Per una settimana entro lì in profondità: parlo con chi ci lavora, guardo codice e strumenti, e individuo cosa frena davvero.",
      step2DeliverableTitle: 'Cosa ti porti a casa:',
      step2Deliverables: [
        'Una lettura chiara di quell’area: cosa regge, cosa scricchiola, cosa manca',
        'Le mosse concrete da fare, in ordine di rapporto costo/rischio',
        'Dove possibile, un primo intervento già fatto: un risultato su cui ripartire, non solo un documento',
      ],
      step2Body2: 'Il report è tuo: puoi usarlo con me, con il tuo team, o con chiunque altro. Nessun lock-in, nessun contratto lungo da firmare. E se alla fine non sei soddisfatto, ti rimborso: senza domande.',
      step2DurationLabel: 'Durata',
      step2Duration: '1 settimana',
      step2CostLabel: 'Costo',
      step2Cost: '€700, prezzo fisso',
      step2Cta: 'Parti dalla discovery call',
      // Gradino 3 — Affiancamento
      step3Eyebrow: 'Passo 3 · Continuativo',
      step3Title: 'Affiancamento',
      step3Subtitle: "Il percorso per chiudere quello che l’Health Check ha aperto.",
      step3Lead: "Un obiettivo attivo alla volta, misurabile e deciso insieme prima di partire. Lo chiudiamo, parte il prossimo: niente lista della spesa, niente venti cose a metà.",
      step3Items: [
        'Le mani, non solo i consigli: sviluppo, integrazioni, pezzi di piattaforma',
        'Tutto col sistema incluso: test che verificano davvero, osservabilità, decisioni documentate',
        'Senza una guida tecnica interna, faccio anche da direzione esterna: roadmap, scelta degli strumenti, supporto alle assunzioni',
      ],
      step3Outro: "L’obiettivo finale è rendermi inutile: il sistema e il team non devono dipendere da me. È fatto per ridursi nel tempo, ed è un successo.",
      step3DurationLabel: 'Impegno',
      step3Duration: 'un progetto attivo per volta · obiettivi scritti, rivisti ogni trimestre',
      step3CostLabel: 'Costo',
      step3Cost: "a partire da €2.500/mese (€6.750/trimestre)",
      step3Closing: "Di solito si parte dall’Health Check. Se il problema è già chiaro, basta la discovery call.",
      // ── Metodo ──
      methodTitle: 'Il metodo',
      methodIntro: "Tutto quello che faccio dentro un Health Check o un affiancamento segue lo stesso metodo: tre pilastri che si moltiplicano, non tre servizi che si sommano. Ognuno si appoggia al precedente. L’ordine non è un dettaglio: è la differenza tra costruire e ricostruire.",
      whyLabel: "Perché in quest’ordine",
      blogLabel: 'Dal blog',
      scenariosTitle: "Perché l’ordine conta",
      scenariosIntro: 'Cosa succede quando salti un pilastro. O tutti e tre.',
      scenariosScenarioCol: 'Scenario',
      scenariosProblemCol: 'Cosa va storto',
      ctaTitle: 'Vogliamo parlarne?',
      ctaDesc: '30 minuti per capire se possiamo lavorare insieme. Senza impegno, senza slide.',
      ctaPrimary: 'Prenota una call',
      ctaSecondary: 'oppure scrivimi',
    };
---

<BaseLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/servizi.webp" lang={lang}>
  <Header lang={lang} />
  <main>

  {/* BANDA 1 — Hero: ingresso al percorso con stepper */}
  <section class="bg-accent-subtle border-b border-border/40 dark:border-border-dark/40">
    <div class="max-w-5xl mx-auto px-5 py-16 md:py-24 fade-in-section">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-text-dark dark:text-text-light max-w-4xl">
      {t.heroTitle}
    </h1>
    <p class="mt-3 text-base md:text-lg text-text-muted max-w-2xl leading-relaxed">
      {t.heroSubtitle}
    </p>

    <nav class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-3 text-sm" aria-label={t.heroStepperLabel}>
      <a href="#discovery-call" class="group inline-flex items-center gap-2">
        <span class="flex items-center justify-center w-7 h-7 rounded-full bg-accent text-white text-sm font-bold shrink-0">1</span>
        <span class="font-semibold text-text-dark dark:text-text-light group-hover:text-accent transition-colors">{t.discoveryTitle}</span>
      </a>
      <span class="text-text-muted hidden sm:inline" aria-hidden="true">→</span>
      <a href="#health-check" class="group inline-flex items-center gap-2">
        <span class="flex items-center justify-center w-7 h-7 rounded-full border border-border dark:border-border-dark text-text-muted text-sm font-bold shrink-0">2</span>
        <span class="font-semibold text-text-dark dark:text-text-light group-hover:text-accent transition-colors">{t.step2Title}</span>
      </a>
      <span class="text-text-muted hidden sm:inline" aria-hidden="true">→</span>
      <a href="#affiancamento" class="group inline-flex items-center gap-2">
        <span class="flex items-center justify-center w-7 h-7 rounded-full border border-border dark:border-border-dark text-text-muted text-sm font-bold shrink-0">3</span>
        <span class="font-semibold text-text-dark dark:text-text-light group-hover:text-accent transition-colors">{t.step3Title}</span>
      </a>
    </nav>
    </div>
  </section>

  {/* BANDA 2 — I tre gradini del funnel */}
  <section>
    <div class="max-w-5xl mx-auto px-5 py-16 md:py-20 fade-in-section">
    <div class="space-y-6">

      {/* Gradino 1 — Discovery call */}
      <div id="discovery-call" class="rounded-xl border border-accent/30 bg-accent/5 p-8 md:p-10 scroll-mt-20 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-full bg-accent text-white text-base font-bold shrink-0">1</span>
          <span class="text-xs text-accent font-semibold uppercase tracking-wide">{t.step1Eyebrow}</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-text-dark dark:text-text-light mb-4">
          {t.discoveryTitle}
        </h2>
        <p class="text-text-muted text-lg leading-relaxed mb-8 max-w-3xl">
          {t.discoveryLead}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-text-dark dark:text-text-light mb-3">
              {t.discoveryWhatTitle}
            </h3>
            <ul class="space-y-2">
              {t.discoveryWhat.map((item) => (
                <li class="text-text-muted text-sm leading-relaxed flex gap-2">
                  <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-text-dark dark:text-text-light mb-3">
              {t.discoveryDeliverableTitle}
            </h3>
            <ul class="space-y-2">
              {t.discoveryDeliverable.map((item) => (
                <li class="text-text-muted text-sm leading-relaxed flex gap-2">
                  <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mb-6 inline-flex items-baseline gap-x-3 gap-y-1 flex-wrap rounded-xl border border-border/60 dark:border-border-dark/60 bg-base-light/70 dark:bg-base-dark/20 px-5 py-3">
          <span class="text-2xl md:text-3xl font-bold text-accent">{t.discoveryPriceMain}</span>
          <span class="text-sm text-text-muted">{t.discoveryPriceSub}</span>
        </div>

        <Button href={calLink} variant="primary" size="lg">
          {t.discoveryCta} →
        </Button>

        <p class="mt-6 text-text-muted text-sm leading-relaxed max-w-2xl italic">
          {t.step1Closing}
        </p>
      </div>

      {/* Gradino 2 — Health Check */}
      <div id="health-check" class="rounded-xl border border-border/50 dark:border-border-dark/50 bg-white dark:bg-surface-dark p-8 md:p-10 scroll-mt-20 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-full border border-border dark:border-border-dark text-text-muted text-base font-bold shrink-0">2</span>
          <span class="text-xs text-text-muted font-semibold uppercase tracking-wide">{t.step2Eyebrow}</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-text-dark dark:text-text-light mb-2">
          {t.step2Title}
        </h2>
        <p class="text-text-muted text-lg leading-relaxed mb-6 max-w-3xl font-medium">
          {t.step2Subtitle}
        </p>

        <p class="text-text-muted text-base leading-relaxed mb-6 max-w-3xl">
          {t.step2Body1}
        </p>

        <div class="mb-6">
          <p class="text-sm font-semibold text-text-dark dark:text-text-light mb-3">
            {t.step2DeliverableTitle}
          </p>
          <ul class="space-y-2">
            {t.step2Deliverables.map((item) => (
              <li class="text-text-muted text-sm leading-relaxed flex gap-2">
                <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <p class="text-text-muted text-base leading-relaxed mb-8 max-w-3xl">
          {t.step2Body2}
        </p>

        <div class="mb-6 inline-flex items-baseline gap-x-3 gap-y-1 flex-wrap rounded-xl border border-border/60 dark:border-border-dark/60 bg-base-light/70 dark:bg-base-dark/20 px-5 py-3">
          <span class="text-2xl md:text-3xl font-bold text-accent">{t.step2PriceMain}</span>
          <span class="text-sm text-text-muted">{t.step2PriceSub}</span>
        </div>

        <Button href={calLink} variant="secondary" size="lg">
          {t.step2Cta} →
        </Button>
      </div>

      {/* Gradino 3 — Affiancamento */}
      <div id="affiancamento" class="rounded-xl border border-border/50 dark:border-border-dark/50 bg-white dark:bg-surface-dark p-8 md:p-10 scroll-mt-20 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-full border border-border dark:border-border-dark text-text-muted text-base font-bold shrink-0">3</span>
          <span class="text-xs text-text-muted font-semibold uppercase tracking-wide">{t.step3Eyebrow}</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-text-dark dark:text-text-light mb-2">
          {t.step3Title}
        </h2>
        <p class="text-text-muted text-lg leading-relaxed mb-6 max-w-3xl font-medium">
          {t.step3Subtitle}
        </p>

        <p class="text-text-muted text-base leading-relaxed mb-6 max-w-3xl">{t.step3Lead}</p>
        <ul class="space-y-2 mb-6 max-w-3xl">
          {t.step3Items.map((item) => (
            <li class="text-text-muted text-sm leading-relaxed flex gap-2">
              <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="text-text-muted text-base leading-relaxed mb-8 max-w-3xl">{t.step3Outro}</p>

        <div class="mb-6 inline-flex items-baseline gap-x-3 gap-y-1 flex-wrap rounded-xl border border-border/60 dark:border-border-dark/60 bg-base-light/70 dark:bg-base-dark/20 px-5 py-3">
          <span class="text-2xl md:text-3xl font-bold text-accent">{t.step3PriceMain}</span>
          <span class="text-sm text-text-muted">{t.step3PriceSub}</span>
        </div>

        <p class="text-text-muted text-sm leading-relaxed italic">
          {t.step3Closing}
        </p>
      </div>

    </div>
    </div>
  </section>

  {/* BANDA 3 — Metodo, pilastri e scenari (banda calda) */}
  <section class="bg-surface dark:bg-surface-dark/40 border-b border-border/40 dark:border-border-dark/40">
    <div class="max-w-5xl mx-auto px-5 py-16 md:py-20">

  {/* Il metodo — intro */}
  <div class="mb-12 fade-in-section">
    <h2 class="text-3xl font-bold text-text-dark dark:text-text-light mb-4">
      {t.methodTitle}
    </h2>
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl">
      {t.methodIntro}
    </p>
  </div>

  {/* Tre pilastri come sequenza */}
  <div class="space-y-8 mb-20">
    {pillarOrder.map(({ pillar, anchor, order, why }) => {
      const entry = byPillar(pillar);
      if (!entry) return null;
      const styles = pillarStyles[pillar];
      const label = pillarLabels[pillar][lang];
      const relatedPosts = postsByPillar[pillar] || [];
      const ids = caseStudyIdsByPillar[pillar] || [];
      const caseStudies = ids.flatMap((id) => {
        const p = projectById.get(id);
        return p ? [p] : [];
      });
      const Content = entry.Content;

      return (
        <section
          id={anchor}
          class:list={[
            'rounded-xl border bg-white dark:bg-surface-dark border-border/50 dark:border-border-dark/50 border-l-[3px] p-6 md:p-8 scroll-mt-20 fade-in-section',
            styles.borderLeft,
          ]}
        >
          <div class="flex items-baseline gap-3 mb-3">
            <span class={`text-sm font-mono ${styles.text}`}>{order}</span>
            <h3 class={`text-2xl font-bold ${styles.text}`}>{label}</h3>
            <span class="text-text-muted text-sm">— {entry.service.data.title}</span>
          </div>

          <div class={`mb-5 pl-3 border-l-2 ${styles.borderLeft}`}>
            <p class="text-xs uppercase tracking-wide text-text-muted mb-1">{t.whyLabel}</p>
            <p class="text-text-dark dark:text-text-light text-base leading-relaxed">
              {why[lang]}
            </p>
          </div>

          <div class="prose dark:prose-invert max-w-none text-text-muted">
            <Content />
          </div>

          {caseStudies.length > 0 && (
            <div class="mt-6 pt-4 border-t border-border/30 dark:border-border-dark/30">
              <p class="text-xs text-text-muted uppercase tracking-wide mb-3">{t.caseStudyLabel}</p>
              <ul class="space-y-2">
                {caseStudies.map((cs) => (
                  <li>
                    <a
                      href={`${prefix}/progetti/${cs.id}/`}
                      class="group inline-flex flex-col gap-0.5"
                    >
                      <span class={`text-sm font-semibold ${styles.text} group-hover:underline`}>
                        {cs.data.title} <span aria-hidden="true">→</span>
                      </span>
                      <span class="text-xs text-text-muted line-clamp-1">
                        {cs.data.problem || cs.data.description}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {relatedPosts.length > 0 && (
            <div class="mt-6 pt-4 border-t border-border/30 dark:border-border-dark/30">
              <p class="text-xs text-text-muted uppercase tracking-wide mb-2">{t.blogLabel}</p>
              <ul class="space-y-1">
                {relatedPosts.map((post) => (
                  <li class="flex items-baseline gap-2 text-sm">
                    <a
                      href={postHref(post.id, lang)}
                      class="text-text-dark dark:text-text-light hover:text-accent transition-colors line-clamp-1"
                    >
                      {post.data.title}
                    </a>
                    <span class="text-text-muted text-xs whitespace-nowrap">
                      {post.data.date.toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' })}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      );
    })}
  </div>

  {/* Scenari — perché l'ordine conta */}
  <section class="mb-20 fade-in-section">
    <h2 class="text-3xl font-bold text-text-dark dark:text-text-light mb-3">
      {t.scenariosTitle}
    </h2>
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl mb-6">
      {t.scenariosIntro}
    </p>
    <div class="overflow-x-auto rounded-xl border border-border/70 dark:border-border-dark/70">
      <table class="w-full text-left">
        <thead class="bg-accent/5">
          <tr>
            <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-text-dark dark:text-text-light w-1/3">
              {t.scenariosScenarioCol}
            </th>
            <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-text-dark dark:text-text-light">
              {t.scenariosProblemCol}
            </th>
          </tr>
        </thead>
        <tbody>
          {scenarios.map((row, i) => {
            const isLast = i === scenarios.length - 1;
            return (
              <tr class:list={[
                'border-t border-border/50 dark:border-border-dark/50',
                isLast && 'bg-accent/5',
              ]}>
                <td class:list={[
                  'px-5 py-4 align-top text-sm font-semibold',
                  isLast ? 'text-accent' : 'text-text-dark dark:text-text-light',
                ]}>
                  {row.scenario}
                </td>
                <td class="px-5 py-4 align-top text-sm text-text-muted leading-relaxed">
                  {row.problem}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

    </div>
  </section>

  {/* BANDA 4 — CTA finale (banda accent piena) */}
  <section class="bg-accent text-white">
    <div class="max-w-5xl mx-auto px-5 py-20 text-center fade-in-section">
      <h2 class="text-3xl md:text-4xl font-bold mb-3">{t.ctaTitle}</h2>
      <p class="text-white/85 text-lg mb-8 max-w-xl mx-auto">{t.ctaDesc}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href={calLink}
          class="inline-flex items-center justify-center font-medium rounded-lg px-7 py-3 text-base bg-white text-accent hover:bg-white/90 shadow-sm active:scale-[0.98] transition-all"
        >
          {t.ctaPrimary}
        </a>
        <a href={mailLink} class="text-sm text-white/80 hover:text-white underline underline-offset-4 transition-colors">
          {t.ctaSecondary}
        </a>
      </div>
    </div>
  </section>

  </main>
  <Footer lang={lang} />
</BaseLayout>
