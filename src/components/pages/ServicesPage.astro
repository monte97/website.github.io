      tailoredIntro: 'Oppure, su misura, se sai già cosa ti serve.',
      aprogEyebrow: 'Su misura · A progetto',
      aprogTitle: 'A Progetto',
      aprogPriceMain: 'Su preventivo',
      aprogPriceSub: 'prezzo fisso e perimetro concordato, a milestone',
