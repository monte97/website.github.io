      ],
      aprogExamples: 'E.g. a new service, tested from day one · an integration between two systems · external access under control · observability on a system running blind.',
      aprogCta: 'Tell me about your project',
      formEyebrow: 'Tailored · Training',
      formTitle: 'Training for your team',
      formPriceMain: 'Tailored',
      formPriceSub: 'format and length agreed',
      formBullets: [
        'Hands-on on observability, testing and DevSecOps',
        'Exercises on your real codebase',
        'Material the team keeps afterwards',
      ],
      formDetail: 'Half a day, a full day, or a cycle across several sessions.',
      formCta: 'See the workshops',
      methodTitle: 'The method',
      methodIntro: "Everything I do inside a targeted intervention or an ongoing engagement follows the same method: three pillars that multiply, not three services that add up. Each builds on the previous. The order is not a detail: it’s the difference between building and rebuilding.",
      whyLabel: 'Why this order',
      blogLabel: 'From the blog',
      scenariosTitle: 'Why the order matters',
      scenariosIntro: 'What happens when you skip a pillar. Or all of them.',
      scenariosScenarioCol: 'Scenario',
      scenariosProblemCol: 'What goes wrong',
      ctaTitle: 'Want to talk?',
      ctaDesc: "30 minutes to figure out whether we can work together. No commitment, no slides.",
      ctaPrimary: 'Book a call',
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'Servizi',
      pageDesc: 'Discovery call gratuita, un affondo mirato che porta un intervento concreto su un’area in due settimane, affiancamento con obiettivi scritti. Tre pilastri, un ordine preciso.',
      heroTitle: "Progettare, verificare, automatizzare. In quest'ordine.",
      heroSubtitle: "Tre pilastri che si moltiplicano: togline uno e gli altri due perdono efficacia. Qui sotto, i tre passi per entrarci, una chiamata alla volta.",
      heroStepperLabel: 'I tre passi del percorso',
      caseStudyLabel: 'Case study',
      discoveryPriceMain: 'Gratis',
      discoveryPriceSub: '30 minuti, senza impegno',
      step2PriceMain: '€1.200',
      step2PriceSub: 'prezzo fisso · si scala dalla prima fattura se prosegui',
      step3PriceMain: 'da €2.500/mese',
      step3PriceSub: 'mese per mese, nessun vincolo di durata',
      // ── Sezione funnel ──
      // Gradino 1 — Discovery call
      step1Eyebrow: 'Passo 1 · Gratuito',
      discoveryTitle: 'Discovery call',
      discoveryLead: 'Trenta minuti, gratis, senza impegno. Per capire se possiamo lavorare insieme — e se serve davvero qualcuno come me.',
      discoveryWhatTitle: 'Di cosa parliamo',
      discoveryWhat: [
        'Dove sei ora: architettura, processi, le cose che ti fanno paura in produzione',
        'Dove vuoi andare: obiettivo, vincolo, scadenza',
        'I sintomi: cosa fa male oggi e con che frequenza',
        'Oppure: cosa stai per costruire. Se il sistema ancora non esiste, è il momento migliore per partire bene',
      ],
      discoveryDeliverableTitle: 'Cosa ti porti a casa',
      discoveryDeliverable: [
        'Una lettura tecnica del problema, non consigli generici',
        'Un prossimo passo concreto, che coinvolga me o meno',
        'Una risposta onesta: posso aiutarti o no.',
      ],
      discoveryDurationLabel: 'Durata',
      discoveryDuration: '30 minuti',
      discoveryCostLabel: 'Costo',
      discoveryCostFree: 'Gratuita',
      discoveryCta: 'Prenota su Cal.com',
      step1Closing: "Da qui può nascere di tutto: un consiglio al volo o un affondo mirato. E se non serve niente, te lo dico: è comunque una buona notizia.",
      // Gradino 2 — Affondo mirato
      step2Eyebrow: 'Passo 2 · L’intervento',
      step2Title: 'Affondo mirato',
      step2Subtitle: "Un’area sola, un risultato in mano: qualcosa che prima non c’era e ora funziona. Consegnato entro due settimane.",
      step2Body1: "L’area la scegliamo in discovery: observability, test, pipeline di deploy, accessi o architettura. Entro lì, capisco dove mettere le mani e ci porto l’intervento.",
      step2DeliverableTitle: 'Cosa ti porti a casa:',
      step2Deliverables: [
        'Un intervento concreto su quell’area: qualcosa che prima non c’era e ora funziona',
        'La radiografia di quell’area come sottoprodotto: cosa regge, cosa scricchiola, cosa manca',
        'Le mosse successive in ordine di rapporto costo/rischio, per proseguire con me o da soli',
      ],
      step2Body2: 'Quello che produco è tuo, senza lock-in. Se proseguiamo entro 30 giorni, i €1.200 si scalano dalla prima fattura. E se non sei soddisfatto, te li rimborso: il lavoro fatto resta comunque tuo.',
      step2DurationLabel: 'Durata',
      step2Duration: 'consegna entro 2 settimane',
      step2CostLabel: 'Costo',
      step2Cost: '€1.200, prezzo fisso',
      step2Cta: 'Parti dalla discovery call',
      // Gradino 3 — Affiancamento
      step3Eyebrow: 'Passo 3 · Continuativo',
      step3Title: 'Affiancamento',
      step3Subtitle: "Il percorso per chiudere quello che l’affondo ha aperto.",
      step3Lead: "Un obiettivo attivo alla volta, deciso insieme. Lo chiudiamo, parte il prossimo: niente lista della spesa, niente venti cose a metà.",
      step3Items: [
        'Le mani, non solo i consigli: sviluppo, integrazioni, pezzi di piattaforma',
        'Tutto col sistema incluso: test che verificano davvero, osservabilità, decisioni documentate',
        'Senza una guida tecnica interna, faccio anche da direzione esterna: roadmap, scelta degli strumenti, supporto alle assunzioni',
      ],
      step3Outro: "L’obiettivo finale è rendermi inutile: il sistema e il team non devono dipendere da me. È fatto per ridursi nel tempo, ed è un successo.",
      step3DurationLabel: 'Come funziona',
      step3Duration: 'un progetto attivo per volta · obiettivi scritti, decisi insieme · mese per mese',
      step3CostLabel: 'Costo',
      step3Cost: "a partire da €2.500/mese",
      step3Closing: "Di solito si parte da un affondo. Se il problema è già chiaro, basta la discovery call.",
