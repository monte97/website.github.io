---
/**
 * Servizi.
 *
 * Racconta la stessa storia della home: cosa fa (le aree), come si lavora
 * (abbonamento trimestrale consigliato, mensile, progetto a corpo), garanzia.
 * Prezzi e promesse sono quelli di src/components/home/Offer.astro: se cambiano
 * la, cambiano anche qui. I deliverable di ogni area stanno nel contenuto, in
 * src/content/services/.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import FinalCta from '@/components/ui/FinalCta.astro';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';

const services = (await getCollection('services')).sort((a, b) => a.data.weight - b.data.weight);

const icons = {
  tools: '<path d="M4 7h16M4 12h10M4 17h7"/>',
  clock: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
  chat: '<path d="M5 5h14v10H8l-3 3z"/>',
  lock: '<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0"/>',
  design: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/><path d="M11 7.5h5v5.5"/>',
  verify: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
  auto: '<path d="M5 12a7 7 0 0 1 12-4.9L19 9"/><path d="M19 4v5h-5"/><path d="M19 12a7 7 0 0 1-12 4.9L5 15"/><path d="M5 20v-5h5"/>',
  teach: '<path d="M3 9l9-4 9 4-9 4z"/><path d="M7 11v4c0 1.5 2.2 3 5 3s5-1.5 5-3v-4"/>',
};
const areaIcons = ['design', 'verify', 'auto'];

const text = {
  it: {
    pageTitle: 'Servizi',
    pageDesc: 'Architettura, test e automazione in abbonamento: 2.500 €/mese con impegno trimestrale, oppure un progetto a corpo su misura. Soddisfatto o rimborsato nelle prime due settimane.',
    heroTitle: 'Progetto, verifico e automatizzo il tuo software.',
    heroSub: 'In abbonamento, oppure con un progetto a prezzo chiuso. Alla fine il team sa andare avanti da solo.',
    heroCta: { href: calLink, label: 'Parliamone in 30 minuti' },
    whatTitle: 'Cosa faccio',
    trainingTitle: 'Formazione per il team',
    trainingBody: 'Workshop sul vostro stack, quando serve saper fare e non solo avere fatto.',
    plansTitleA: 'Come lavoriamo: ',
    plansTitleB: 'abbonamento o progetto',
    badge: 'Consigliato',
    plans: [
      { h: 'Abbonamento trimestrale', amt: '2.500 €', per: '/ mese', sub: 'Impegno di tre mesi, poi rinnovi se ti serve.',
        li: ['Priorità decise insieme ogni mese', 'Progetto, verifica e automazione nello stesso prezzo', 'Il team impara e resta autonomo'],
        cta: 'Parliamone in 30 minuti', hot: true },
      { h: 'Abbonamento mensile', amt: '3.000 €', per: '/ mese', sub: 'Mese per mese, ti fermi quando vuoi.',
        li: ['Tutto quello del trimestrale', 'Per partire con un primo mese di prova'],
        cta: 'Parliamone' },
      { h: 'Progetto a corpo', amt: 'Su misura', per: '', sub: 'Un obiettivo preciso, un prezzo chiuso.',
        li: ["Per esempio: un health check del sistema, una pipeline CI/CD, l'observability da zero, Keycloak", 'Preventivo dopo la prima chiacchierata'],
        cta: 'Raccontami il progetto' },
    ],
    how: [
      { i: 'tools', b: 'Entro nei vostri strumenti', d: 'Repository, board e chat che usate già.' },
      { i: 'clock', b: 'Una priorità alla volta', d: 'La decidiamo insieme, la chiudo, passo alla prossima.' },
      { i: 'chat', b: 'Aggiornamento ogni settimana', d: 'Due righe scritte: cosa è fatto, cosa blocca.' },
      { i: 'lock', b: 'Niente lock-in', d: 'Codice, documentazione e accessi restano vostri.' },
    ],
    gb: 'Soddisfatto o rimborsato.',
    gd: ' Se dopo le prime due settimane non ti torna, ci fermiamo e ti restituisco quanto hai pagato.',
    subTitleA: 'Come funziona ',
    subTitleB: "l'abbonamento",
    subLead: 'Niente preventivo da rifare a ogni modifica: un prezzo fisso al mese e le priorità che decidiamo insieme.',
    steps: [
      { k: 'Prima', h: 'Due chiacchiere', d: 'Trenta minuti, gratis: mi racconti cosa state costruendo e dove fa male.' },
      { k: 'Il primo giorno', h: 'Entro nei vostri strumenti', d: 'Mi date accesso a repository, board e chat che usate già, e scegliamo insieme la prima priorità.' },
      { k: 'Ogni settimana', h: 'Una priorità alla volta', d: 'La chiudo e passo alla prossima. Ti scrivo due righe: cosa è fatto, cosa blocca.' },
      { k: 'Ogni mese', h: 'Rivediamo le priorità', d: 'Decidiamo insieme cosa viene dopo. Con il mensile ti fermi quando vuoi, con il trimestrale l\'impegno è di tre mesi.' },
    ],
    subNote: 'Le prime due settimane sono coperte: se non ti torna, ci fermiamo e ti restituisco quanto hai pagato.',
    faqTitle: 'Domande frequenti',
    faq: [
      { q: 'Come funziona la prima call?', a: 'Trenta minuti, gratis, senza slide. Mi racconti dove sta il sistema e cosa vi blocca, e vediamo se ha senso lavorare insieme.' },
      { q: 'Abbonamento o progetto a corpo?', a: "Se hai più cose da sistemare e vuoi decidere le priorità strada facendo, l'abbonamento. Se hai un obiettivo preciso, il progetto: il preventivo arriva dopo la prima chiacchierata." },
      { q: 'Cosa resta alla fine?', a: 'Codice, documentazione e accessi restano vostri, e il team ha imparato a muoversi da solo.' },
    ],
    ctaTitle: 'Un caffè?',
    ctaDesc: 'Mi racconti cosa state costruendo. Se posso aiutarvi te lo dico, se no ti dico chi può.',
  },
  en: {
    pageTitle: 'Services',
    pageDesc: 'Architecture, testing and automation on a subscription: €2,500/month with a quarterly commitment, or a tailored fixed-price project. Satisfied or refunded in the first two weeks.',
    heroTitle: 'I design, verify and automate your software.',
    heroSub: 'On a subscription, or as a fixed-price project. In the end your team can go on by itself.',
    heroCta: { href: calLink, label: "Let's talk for 30 minutes" },
    whatTitle: 'What I do',
    trainingTitle: 'Training for the team',
    trainingBody: 'Workshops on your own stack, when the need is knowing how and not only having it built.',
    plansTitleA: 'How we work: ',
    plansTitleB: 'subscription or project',
    badge: 'Recommended',
    plans: [
      { h: 'Quarterly subscription', amt: '€2,500', per: '/ month', sub: 'Three-month commitment, then renew if you need it.',
        li: ['Priorities agreed together every month', 'Design, verification and automation at the same price', 'Your team learns and stays independent'],
        cta: "Let's talk for 30 minutes", hot: true },
      { h: 'Monthly subscription', amt: '€3,000', per: '/ month', sub: 'Month by month, stop whenever you want.',
        li: ['Everything in the quarterly plan', 'To start with a trial month'],
        cta: "Let's talk" },
      { h: 'Fixed-price project', amt: 'Tailored', per: '', sub: 'One clear goal, one fixed price.',
        li: ['For example: a system health check, a CI/CD pipeline, observability from scratch, Keycloak', 'Quote after our first chat'],
        cta: 'Tell me about the project' },
    ],
    how: [
      { i: 'tools', b: 'I join your tools', d: 'The repository, board and chat you already use.' },
      { i: 'clock', b: 'One priority at a time', d: 'We pick it together, I close it, I move to the next.' },
      { i: 'chat', b: 'A weekly update', d: 'Two written lines: what is done, what is blocked.' },
      { i: 'lock', b: 'No lock-in', d: 'Code, documentation and access stay yours.' },
    ],
    gb: 'Satisfied or refunded.',
    gd: " If after the first two weeks it doesn't work for you, we stop and I give you back what you paid.",
    subTitleA: 'How the ',
    subTitleB: 'subscription works',
    subLead: 'No new quote for every change: a fixed monthly price and priorities we decide together.',
    steps: [
      { k: 'First', h: 'A chat', d: "Thirty minutes, free: tell me what you're building and where it hurts." },
      { k: 'Day one', h: 'I join your tools', d: 'You give me access to the repository, board and chat you already use, and we pick the first priority together.' },
      { k: 'Every week', h: 'One priority at a time', d: 'I close it and move to the next. I send you two lines: what is done, what is blocked.' },
      { k: 'Every month', h: 'We review priorities', d: 'We decide together what comes next. Monthly: stop whenever you want. Quarterly: a three-month commitment.' },
    ],
    subNote: "The first two weeks are covered: if it doesn't work for you, we stop and I give you back what you paid.",
    faqTitle: 'Frequently asked',
    faq: [
      { q: 'How does the first call work?', a: 'Thirty minutes, free, no slides. You tell me where the system is and what is blocking you, and we see whether it makes sense to work together.' },
      { q: 'Subscription or fixed-price project?', a: 'If you have several things to fix and want to set priorities as you go, the subscription. If you have one precise goal, the project: the quote comes after our first chat.' },
      { q: 'What is left at the end?', a: 'Code, documentation and access stay yours, and your team has learned to move on its own.' },
    ],
    ctaTitle: 'Coffee?',
    ctaDesc: "Tell me what you're building. If I can help, I'll tell you; if not, I'll tell you who can.",
  },
};

const t = text[lang];
const line = 'border-border';
---

<BaseLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/servizi.png" lang={lang}>
  <Header lang={lang} />
  <main class="bg-base-light">

    <PageHero variant="index" title={t.heroTitle} subtitle={t.heroSub} cta={t.heroCta} />

    <section class="max-w-5xl mx-auto px-5 py-16 md:py-20">
      <SectionHeading title={t.whatTitle} />
      <div class={`grid md:grid-cols-2 border-t ${line}`}>
        {services.map((s, i) => (
          <a href={s.data.link ? `${prefix}${s.data.link}` : `${prefix}/case-study/`}
            class={`group flex gap-4 py-6 border-b ${line} md:odd:pr-8 md:even:pl-8 md:even:border-l`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[26px] w-[26px] flex-none text-accent mt-0.5" set:html={icons[areaIcons[i] as keyof typeof icons]} aria-hidden="true"></svg>
            <div>
              <h3 class="text-lg font-bold text-text-dark group-hover:text-accent transition-colors">{lang === 'en' ? (s.data.titleEn ?? s.data.title) : s.data.title}</h3>
              <p class="mt-1 text-[15px] text-text-muted leading-snug">
                {(lang === 'en' ? (s.data.itemsEn ?? s.data.items) : s.data.items).slice(0, 3).join(' · ')}
              </p>
            </div>
          </a>
        ))}
        <a href={`${prefix}/workshop/`} class={`group flex gap-4 py-6 border-b ${line} md:odd:pr-8 md:even:pl-8 md:even:border-l`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[26px] w-[26px] flex-none text-accent mt-0.5" set:html={icons.teach} aria-hidden="true"></svg>
          <div>
            <h3 class="text-lg font-bold text-text-dark group-hover:text-accent transition-colors">{t.trainingTitle}</h3>
            <p class="mt-1 text-[15px] text-text-muted leading-snug">{t.trainingBody}</p>
          </div>
        </a>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-5 pb-16 md:pb-20">
      <h2 class="text-3xl md:text-[2.5rem] font-extrabold tracking-tight leading-[1.1] text-text-dark max-w-3xl">
        {t.plansTitleA}<span class="text-accent">{t.plansTitleB}</span>.
      </h2>

      <div class="mt-10 grid md:grid-cols-[1.1fr_1fr_1fr] gap-5 items-stretch">
        {t.plans.map(p => (
          <div class:list={[
            'relative flex flex-col rounded-2xl p-7 bg-white',
            p.hot ? 'border-2 border-accent shadow-[0_18px_40px_rgba(232,151,58,.18)]' : 'border border-border',
          ]}>
            {p.hot && <span class="absolute -top-3 left-6 rounded-full bg-accent px-2.5 py-1 text-xs font-bold text-white">{t.badge}</span>}
            <h3 class="text-lg font-bold text-text-dark">{p.h}</h3>
            <div class="mt-3 flex items-baseline gap-1.5">
              <span class:list={['font-extrabold tracking-tight text-text-dark', p.per ? 'text-[2.75rem] leading-none' : 'text-[2rem] leading-tight']}>{p.amt}</span>
              {p.per && <span class="text-text-muted">{p.per}</span>}
            </div>
            <p class="mt-1.5 text-[15px] text-text-muted">{p.sub}</p>
            <ul class="mt-5 pt-4 border-t border-border grid gap-2.5 text-[15px] text-text-dark flex-1">
              {p.li.map(x => (
                <li class="flex gap-2.5"><span class="mt-[7px] h-[7px] w-[7px] flex-none rounded-full bg-accent"></span>{x}</li>
              ))}
            </ul>
            <a href={calLink} target="_blank" rel="noopener noreferrer" data-umami-event="cta-servizi-piano"
              class:list={[
                'mt-6 rounded-lg px-4 py-3 text-center font-semibold transition-colors',
                p.hot ? 'bg-accent text-white hover:bg-accent-hover' : 'border-[1.5px] border-text-dark/80 text-text-dark hover:border-accent hover:text-accent',
              ]}>{p.cta}</a>
          </div>
        ))}
      </div>

      <div class={`mt-12 grid md:grid-cols-4 border-y ${line}`}>
        {t.how.map((h, i) => (
          <div class:list={['py-6 md:px-5', i > 0 ? `border-t md:border-t-0 md:border-l ${line}` : 'md:pl-0']}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[26px] w-[26px] text-accent" set:html={icons[h.i as keyof typeof icons]} aria-hidden="true"></svg>
            <p class="mt-3 font-bold text-text-dark">{h.b}</p>
            <p class="text-[15px] text-text-muted leading-snug">{h.d}</p>
          </div>
        ))}
      </div>

      <div class="mt-9 mx-auto max-w-2xl flex gap-3.5 items-start rounded-2xl border border-border bg-white px-5 py-4 text-text-muted leading-relaxed">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[26px] w-[26px] flex-none text-accent" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
        <p><strong class="text-text-dark">{t.gb}</strong>{t.gd}</p>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-5 pb-16 md:pb-20">
      <h2 class="text-3xl md:text-[2.5rem] font-extrabold tracking-tight leading-[1.1] text-text-dark max-w-3xl">
        {t.subTitleA}<span class="text-accent">{t.subTitleB}</span>.
      </h2>
      <p class="mt-4 text-lg text-text-muted leading-relaxed max-w-2xl">{t.subLead}</p>
      <ol class="mt-10 grid md:grid-cols-4 gap-8 md:gap-6 relative">
        <span class="hidden md:block absolute top-[21px] left-[22px] right-[22px] h-[2px] bg-accent/30" aria-hidden="true"></span>
        {t.steps.map((st, i) => (
          <li class="relative">
            <span class="relative z-10 grid place-items-center w-11 h-11 rounded-full bg-accent text-white font-extrabold">{i + 1}</span>
            <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.12em] text-accent font-bold">{st.k}</p>
            <h3 class="mt-1 text-lg font-bold text-text-dark">{st.h}</h3>
            <p class="mt-1 text-[15px] text-text-muted leading-snug">{st.d}</p>
          </li>
        ))}
      </ol>
      <p class="mt-10 text-text-muted"><strong class="text-text-dark">{lang === 'en' ? 'Satisfied or refunded.' : 'Soddisfatto o rimborsato.'}</strong> {t.subNote}</p>
    </section>

    <section class="max-w-3xl mx-auto px-5 pb-16 md:pb-20">
      <SectionHeading title={t.faqTitle} />
      <div class={`border-t ${line}`}>
        {t.faq.map((f) => (
          <details class={`group border-b ${line}`}>
            <summary class="flex items-center justify-between gap-4 py-4 cursor-pointer font-semibold text-text-dark hover:text-accent transition-colors">
              {f.q}
              <span class="text-accent shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="pb-5 text-text-muted leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <FinalCta title={t.ctaTitle} desc={t.ctaDesc} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
