      ],
      step3Outro: "The end goal is to make myself unnecessary: the system and the team shouldn’t depend on me. It’s built to shrink over time, and that’s a success.",
      step3DurationLabel: 'How it works',
      step3Duration: 'one active project at a time · written objectives, agreed together · month to month',
      step3CostLabel: 'Cost',
      step3Cost: 'from €2,500/month',
      step3Closing: 'Most engagements start with a targeted intervention. If the problem is already clear, the discovery call is enough.',
      // ── Method ──
      tailoredIntro: 'Or tailored, if you already know what you need.',
      aprogEyebrow: 'Tailored · By project',
      aprogTitle: 'By project',
      aprogPriceMain: 'Custom quote',
      aprogPriceSub: 'fixed price, agreed scope, milestone-based',
      aprogBullets: [
