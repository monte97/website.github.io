---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import { postHref } from '@/utils/blog';
import { pillarStyles } from '@/data/pillar-styles';
import { pillarLabels, type Pillar } from '@/data/pillars';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const calLink = 'https://cal.eu/monte97/30min';
const mailLink = 'mailto:francesco@montelli.dev';

const services = (await getCollection('services')).sort((a, b) => a.data.weight - b.data.weight);
const rendered = await Promise.all(
  services.map(async (service) => {
    const { Content } = await render(service);
    return { service, Content };
  })
);

const byPillar = (p: Pillar) => rendered.find(({ service }) => service.data.pillar === p);

const pillarOrder: Array<{
  pillar: Pillar;
  anchor: string;
  order: string;
  why: { it: string; en: string };
}> = [
  {
    pillar: 'progettare',
    anchor: 'architecture',
    order: '01',
    why: {
      it: 'Le decisioni architetturali sono le più costose da cambiare in corsa. Vengono prima di tutto: se la base è sbagliata, qualsiasi cosa ci costruisci sopra eredita il problema.',
      en: 'Architectural decisions are the most expensive ones to change later. They come first: if the foundation is wrong, anything you build on top of it inherits the problem.',
    },
  },
  {
    pillar: 'verificare',
    anchor: 'observability-security',
    order: '02',
    why: {
      it: 'Una volta progettato, devi sapere che funziona davvero. Sotto carico, sotto attacco, nel tempo. Senza verifica, automatizzare significa solo amplificare i guasti.',
      en: "Once it's designed, you need to know it actually works. Under load, under attack, over time. Without verification, automating just means amplifying the failures.",
    },
  },
  {
    pillar: 'automatizzare',
    anchor: 'pipeline-automation',
    order: '03',
    why: {
      it: "Solo dopo aver progettato e verificato. L'automazione moltiplica il valore di ciò che ha a monte — errori compresi. Per questo è l'ultimo step, non il primo.",
      en: "Only after designing and verifying. Automation multiplies whatever sits upstream of it — mistakes included. That's why it's the last step, not the first.",
    },
  },
];

const allProjects = (await getCollection('projects')).filter(
  (p) => p.data.type === 'project',
);
const projectById = new Map(allProjects.map((p) => [p.id, p]));

const caseStudyIdsByPillar: Record<Pillar, string[]> = {
  progettare: ['order-processing-platform'],
  verificare: ['observability-as-a-service', 'keycloak-dotnet-adoption'],
  automatizzare: ['pipeline-cicd-proxmox'],
};

const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft && p.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postsByPillar: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  if (post.data.pillar) {
    if (!postsByPillar[post.data.pillar]) postsByPillar[post.data.pillar] = [];
    if (postsByPillar[post.data.pillar].length < 2) {
      postsByPillar[post.data.pillar].push(post);
    }
  }
}

const locale = lang === 'en' ? 'en-US' : 'it-IT';

type Scenario = { scenario: string; problem: string };
const scenarios: Scenario[] = lang === 'en'
  ? [
      { scenario: 'Tests without CI/CD', problem: "Run by hand, when someone remembers. Eventually, nobody runs them at all." },
      { scenario: 'CI/CD without observability', problem: "You know the deploy went through. You don't know whether the system actually works." },
      { scenario: 'Observability without tests', problem: "You see the problems in production, but you can't prevent them. You're stuck in reactive mode." },
      { scenario: 'All three together', problem: 'You design consciously → verify automatically → observe in production.' },
    ]
  : [
      { scenario: 'Test senza CI/CD', problem: 'Vengono eseguiti a mano, quando ci si ricorda. Con il tempo si smette.' },
      { scenario: 'CI/CD senza observability', problem: 'Sai che il deploy è andato a buon fine. Non sai se il sistema funziona davvero.' },
      { scenario: 'Observability senza test', problem: 'Vedi i problemi in produzione, ma non puoi prevenirli. Sei sempre in modalità reattiva.' },
      { scenario: 'Tutti e tre insieme', problem: 'Progetti consapevolmente → verifichi automaticamente → osservi in produzione.' },
    ];

const t = lang === 'en'
  ? {
      pageTitle: 'Services',
      heroTitle: 'How I can help',
      heroSubtitle: 'Three pillars that multiply — not three services that add up. The order is not negotiable.',
      heroCta: 'Book a discovery call',
      caseStudyLabel: 'Case study',
      discoveryEyebrow: 'Starting point',
      discoveryTitle: 'Discovery call',
      discoveryLead: "A 30-minute call. Free, no strings attached. The fastest way to find out whether we can work together — and whether you actually need someone like me.",
      discoveryWhatTitle: 'What we cover',
      discoveryWhat: [
        'Where you are now: architecture, processes, the things that scare you in production',
        'Where you want to get to: the goal, the constraints, the deadline',
        "The symptoms: what's hurting today, and how often",
      ],
      discoveryDeliverableTitle: 'What you walk away with',
      discoveryDeliverable: [
        'A technical read on the problem, not generic advice',
        'A concrete next step — whether it involves me or not',
        "An honest answer about whether this is something I can actually help with",
      ],
      discoveryDurationLabel: 'Duration',
      discoveryDuration: '30 minutes',
      discoveryCostLabel: 'Cost',
      discoveryCostFree: 'Free',
      discoveryCta: 'Book on Cal.com',
      methodTitle: 'The method',
      methodIntro: "Three pillars in a deliberate order. Each builds on the previous. Skipping a step doesn't save time — it just pushes the pain further down the line.",
      whyLabel: 'Why this order',
      blogLabel: 'From the blog',
      scenariosTitle: 'Why the order matters',
      scenariosIntro: 'What happens when you skip a pillar — or all of them.',
      scenariosScenarioCol: 'Scenario',
      scenariosProblemCol: 'What goes wrong',
      ctaTitle: 'Want to talk?',
      ctaDesc: "Half an hour to figure out whether we can work together. No commitment, no slides.",
      ctaPrimary: 'Book a call',
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'Servizi',
      heroTitle: 'Come posso aiutarti',
      heroSubtitle: "Tre pilastri che si moltiplicano, non tre servizi che si sommano. L'ordine non è negoziabile.",
      heroCta: 'Prenota una discovery call',
      caseStudyLabel: 'Case study',
      discoveryEyebrow: 'Punto di partenza',
      discoveryTitle: 'Discovery call',
      discoveryLead: 'Una chiamata di 30 minuti. Gratuita, senza impegno. Il modo più rapido per capire se possiamo lavorare insieme — e se serve davvero qualcuno come me.',
      discoveryWhatTitle: 'Di cosa parliamo',
      discoveryWhat: [
        'Dove sei ora: architettura, processi, le cose che ti fanno paura in produzione',
        'Dove vuoi andare: obiettivo, vincolo, scadenza',
        'I sintomi: cosa fa male oggi e con che frequenza',
      ],
      discoveryDeliverableTitle: 'Cosa ti porti a casa',
      discoveryDeliverable: [
        'Una lettura tecnica del problema, non consigli generici',
        'Un prossimo passo concreto — che coinvolga me o meno',
        'Una risposta onesta su se è qualcosa con cui posso aiutarti',
      ],
      discoveryDurationLabel: 'Durata',
      discoveryDuration: '30 minuti',
      discoveryCostLabel: 'Costo',
      discoveryCostFree: 'Gratuita',
      discoveryCta: 'Prenota su Cal.com',
      methodTitle: 'Il metodo',
      methodIntro: 'Tre pilastri in un ordine preciso. Ognuno si appoggia al precedente. Saltare uno step non fa risparmiare tempo — sposta solo il dolore più avanti.',
      whyLabel: "Perché in quest'ordine",
      blogLabel: 'Dal blog',
      scenariosTitle: "Perché l'ordine conta",
      scenariosIntro: 'Cosa succede quando salti un pilastro — o tutti e tre.',
      scenariosScenarioCol: 'Scenario',
      scenariosProblemCol: 'Cosa va storto',
      ctaTitle: 'Vogliamo parlarne?',
      ctaDesc: "Mezz'ora per capire se possiamo lavorare insieme. Senza impegno, senza slide.",
      ctaPrimary: 'Prenota una call',
      ctaSecondary: 'oppure scrivimi',
    };
---

<PageLayout title={t.pageTitle} lang={lang}>
  <PageHero
    title={t.heroTitle}
    subtitle={t.heroSubtitle}
    cta={{ href: calLink, label: t.heroCta }}
  />

  {/* Discovery call — punto di apertura */}
  <section id="health-check" class="mb-20 scroll-mt-20 fade-in-section">
    <div class="rounded-xl border border-accent/30 bg-accent/5 p-8 md:p-10">
      <span class="text-xs text-accent font-semibold uppercase tracking-wide">
        {t.discoveryEyebrow}
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-text-dark dark:text-text-light mt-2 mb-4">
        {t.discoveryTitle}
      </h2>
      <p class="text-text-muted text-lg leading-relaxed mb-8 max-w-3xl">
        {t.discoveryLead}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-text-dark dark:text-text-light mb-3">
            {t.discoveryWhatTitle}
          </h3>
          <ul class="space-y-2">
            {t.discoveryWhat.map((item) => (
              <li class="text-text-muted text-sm leading-relaxed flex gap-2">
                <span class="text-accent mt-2 shrink-0 w-1 h-1 rounded-full bg-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-text-dark dark:text-text-light mb-3">
            {t.discoveryDeliverableTitle}
          </h3>
          <ul class="space-y-2">
            {t.discoveryDeliverable.map((item) => (
              <li class="text-text-muted text-sm leading-relaxed flex gap-2">
                <span class="text-accent mt-2 shrink-0 w-1 h-1 rounded-full bg-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-8 text-sm">
        <div>
          <span class="text-text-muted">{t.discoveryDurationLabel}:</span>
          <span class="text-text-dark dark:text-text-light font-semibold ml-2">{t.discoveryDuration}</span>
        </div>
        <div>
          <span class="text-text-muted">{t.discoveryCostLabel}:</span>
          <span class="text-accent font-semibold ml-2">{t.discoveryCostFree}</span>
        </div>
      </div>

      <Button href={calLink} variant="primary" size="lg">
        {t.discoveryCta} →
      </Button>
    </div>
  </section>

  {/* Il metodo — intro */}
  <section class="mb-12 fade-in-section">
    <h2 class="text-3xl font-bold text-text-dark dark:text-text-light mb-4">
      {t.methodTitle}
    </h2>
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl">
      {t.methodIntro}
    </p>
  </section>

  {/* Tre pilastri come sequenza */}
  <div class="space-y-8 mb-20">
    {pillarOrder.map(({ pillar, anchor, order, why }) => {
      const entry = byPillar(pillar);
      if (!entry) return null;
      const styles = pillarStyles[pillar];
      const label = pillarLabels[pillar][lang];
      const relatedPosts = postsByPillar[pillar] || [];
      const ids = caseStudyIdsByPillar[pillar] || [];
      const caseStudies = ids.flatMap((id) => {
        const p = projectById.get(id);
        return p ? [p] : [];
      });
      const Content = entry.Content;

      return (
        <section
          id={anchor}
          class:list={[
            'rounded-xl border bg-white dark:bg-surface-dark border-border/50 dark:border-border-dark/50 border-l-[3px] p-6 md:p-8 scroll-mt-20 fade-in-section',
            styles.borderLeft,
          ]}
        >
          <div class="flex items-baseline gap-3 mb-3">
            <span class={`text-sm font-mono ${styles.text}`}>{order}</span>
            <h3 class={`text-2xl font-bold ${styles.text}`}>{label}</h3>
            <span class="text-text-muted text-sm">— {entry.service.data.title}</span>
          </div>

          <div class={`mb-5 pl-3 border-l-2 ${styles.borderLeft}`}>
            <p class="text-xs uppercase tracking-wide text-text-muted mb-1">{t.whyLabel}</p>
            <p class="text-text-dark dark:text-text-light text-base leading-relaxed">
              {why[lang]}
            </p>
          </div>

          <div class="prose dark:prose-invert max-w-none text-text-muted">
            <Content />
          </div>

          {caseStudies.length > 0 && (
            <div class="mt-6 pt-4 border-t border-border/30 dark:border-border-dark/30">
              <p class="text-xs text-text-muted uppercase tracking-wide mb-3">{t.caseStudyLabel}</p>
              <ul class="space-y-2">
                {caseStudies.map((cs) => (
                  <li>
                    <a
                      href={`${prefix}/progetti/${cs.id}/`}
                      class="group inline-flex flex-col gap-0.5"
                    >
                      <span class={`text-sm font-semibold ${styles.text} group-hover:underline`}>
                        {cs.data.title} <span aria-hidden="true">→</span>
                      </span>
                      <span class="text-xs text-text-muted line-clamp-1">
                        {cs.data.problem || cs.data.description}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {relatedPosts.length > 0 && (
            <div class="mt-6 pt-4 border-t border-border/30 dark:border-border-dark/30">
              <p class="text-xs text-text-muted uppercase tracking-wide mb-2">{t.blogLabel}</p>
              <ul class="space-y-1">
                {relatedPosts.map((post) => (
                  <li class="flex items-baseline gap-2 text-sm">
                    <a
                      href={postHref(post.id, lang)}
                      class="text-text-dark dark:text-text-light hover:text-accent transition-colors line-clamp-1"
                    >
                      {post.data.title}
                    </a>
                    <span class="text-text-muted text-xs whitespace-nowrap">
                      {post.data.date.toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' })}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      );
    })}
  </div>

  {/* Scenari — perché l'ordine conta */}
  <section class="mb-20 fade-in-section">
    <h2 class="text-3xl font-bold text-text-dark dark:text-text-light mb-3">
      {t.scenariosTitle}
    </h2>
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl mb-6">
      {t.scenariosIntro}
    </p>
    <div class="overflow-x-auto rounded-xl border border-border/70 dark:border-border-dark/70">
      <table class="w-full text-left">
        <thead class="bg-accent/5">
          <tr>
            <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-text-dark dark:text-text-light w-1/3">
              {t.scenariosScenarioCol}
            </th>
            <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-text-dark dark:text-text-light">
              {t.scenariosProblemCol}
            </th>
          </tr>
        </thead>
        <tbody>
          {scenarios.map((row, i) => {
            const isLast = i === scenarios.length - 1;
            return (
              <tr class:list={[
                'border-t border-border/50 dark:border-border-dark/50',
                isLast && 'bg-accent/5',
              ]}>
                <td class:list={[
                  'px-5 py-4 align-top text-sm font-semibold',
                  isLast ? 'text-accent' : 'text-text-dark dark:text-text-light',
                ]}>
                  {row.scenario}
                </td>
                <td class="px-5 py-4 align-top text-sm text-text-muted leading-relaxed">
                  {row.problem}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  {/* CTA finale */}
  <section class="text-center py-16 fade-in-section">
    <h2 class="text-3xl font-bold mb-3">{t.ctaTitle}</h2>
    <p class="text-text-muted text-lg mb-8 max-w-xl mx-auto">{t.ctaDesc}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <Button href={calLink} variant="primary" size="lg">
        {t.ctaPrimary}
      </Button>
      <a href={mailLink} class="text-sm text-text-muted hover:text-accent transition-colors">
        {t.ctaSecondary}
      </a>
    </div>
  </section>
</PageLayout>
