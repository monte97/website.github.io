---
/**
 * Servizi.
 *
 * La pagina dichiara prima come si lavora, poi cosa si fa, poi in che ordine si
 * procede. I deliverable di ogni servizio stanno nel contenuto, in
 * src/content/services/, non qui.
 *
 * Due blocchi restano spenti finche' non hanno testi veri: il riquadro "non
 * sono la scelta giusta se" e la relativa sezione, che senza il lato negativo
 * non regge. Bastano tre righe in `notForYou` per accenderla.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FinalCta from '@/components/ui/FinalCta.astro';
import { signals } from '@/data/signals';
import { getWorkshops } from '@/utils/workshop';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';
const mailLink = 'mailto:francesco@montelli.dev';

const services = (await getCollection('services')).sort((a, b) => a.data.weight - b.data.weight);
const workshops = await getWorkshops();
const caseStudyCount = (await getCollection('projects')).filter(
  (p) => p.data.type === 'case-study' && !p.data.hold
).length;

const hair = 'border-border/70 dark:border-border-dark/70';
const h2 = 'text-2xl md:text-3xl font-bold tracking-tight text-text-dark dark:text-text-light';

const t = lang === 'en'
  ? {
      pageTitle: 'Services',
      pageDesc: 'I design, build and automate the software behind your product: architecture, verification, automation. From scratch or on a system grown rigid over time. Free 30-minute discovery call.',
      eyebrow: 'The services',
      heroTitle: 'I design, build and automate the software behind your product.',
      heroBody: 'From analysis and architecture choices to the actual build, all the way to the automated processes that keep quality high. Whether it starts from scratch or from a system that has grown rigid over time, the team is left able to go on without me.',
      heroCta: 'Book a discovery call',
      heroSecondary: (n: number) => `Read the ${n} analyses`,
      howTitle: 'How I work',
      commitments: [
        { title: 'The goal is to make myself unnecessary', body: 'Every engagement ends with a handover doc, runbooks and an internal owner I train. The system should not depend on me to keep working.' },
        { title: 'One active goal at a time', body: 'No parallel tracks stealing attention from each other. What is open gets closed, then the next one opens.' },
        { title: 'The first focused piece is refundable', body: 'Fixed price, delivered in two weeks. If you are not satisfied it is refunded, no questions, and the work stays yours either way.' },
        { title: 'Decisions stay written down', body: 'The choices made, the alternatives rejected and why. The same format the public case studies are told in.' },
      ],
      whatTitle: 'What we can do together',
      whatBody: 'In the order things have to be faced: design first, then verify, then automate. Automation amplifies everything sitting above it, mistakes included.',
      trainingTitle: 'Training for the team',
      trainingBody: 'When the problem is not building but knowing how: a path run with the team, on your stack.',
      trainingMore: 'Modules chosen during the discovery call',
      processTitle: 'How it goes',
      process: [
        ['01', 'Discovery call', '30 minutes, free. Tell me what the system looks like today and which decision you are stuck on. It is there to see whether there is a problem I can be useful on.'],
        ['02', 'Focused piece', 'One area, a concrete result in hand, delivered within two weeks. Fixed price, and the work stays yours either way.'],
        ['03', 'Ongoing engagement', 'If the problem is bigger than one piece. Month to month, one active goal at a time, with everything the system needs included.'],
        ['04', 'Exit', 'Handover doc, runbooks and a trained internal owner. From there the team goes on by itself.'],
      ],
      fitTitle: 'When I am the right choice',
      fitYes: 'We work well together if…',
      fitNo: 'I am not the right choice if…',
      fitExtra: 'you want the team to be able to go on without me at the end',
      faqTitle: 'Frequently asked',
      faq: [
        { q: 'How much does it cost?', a: 'The focused piece has a fixed price of €1,200: one area, delivered in two weeks, refunded if you are not satisfied. The ongoing engagement starts at €2,500 a month, month to month, with one active goal at a time.' },
        { q: 'How does the first call work?', a: 'Thirty minutes, free, no commitment and no slides. You tell me where the system is and what is blocking you, and we work out whether and how it makes sense to work together.' },
        { q: 'What is left at the end of an engagement?', a: 'A handover doc, the runbooks and an internal owner I have trained. Plus the code, the tests and the documented decisions: the system should not depend on me to keep working.' },
      ],
      ctaTitle: 'Got a technical decision that deserves clarity?',
      ctaDesc: 'Thirty minutes are enough to see where the problem sits and whether I can be useful. No commitment, no slides.',
      ctaPrimary: "Let's talk",
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'Servizi',
      pageDesc: "Progetto, sviluppo e automatizzo il software del tuo prodotto: architettura, verifica, automazione. Da zero o su un sistema irrigidito nel tempo. Discovery call gratuita di 30 minuti.",
      eyebrow: 'I servizi',
      heroTitle: 'Progetto, sviluppo e automatizzo il software del tuo prodotto.',
      heroBody: "Dall'analisi e le scelte di architettura alla realizzazione, fino ai processi automatici che ne tengono alta la qualità. Che parta da zero o da un sistema irrigidito nel tempo, alla fine il team resta capace di andare avanti da solo.",
      heroCta: 'Prenota una discovery call',
      heroSecondary: (n: number) => `Leggi le ${n} analisi`,
      howTitle: 'Come lavoro',
      commitments: [
        { title: "L'obiettivo è rendermi inutile", body: 'Ogni ingaggio finisce con un handover doc, i runbook e un owner interno che formo. Il sistema non deve dipendere da me per funzionare.' },
        { title: 'Un obiettivo attivo per volta', body: 'Niente lavori paralleli che si rubano attenzione. Si chiude quello che è aperto, poi si apre il successivo.' },
        { title: 'Il primo affondo è rimborsabile', body: 'Prezzo fisso, consegna in due settimane. Se non sei soddisfatto viene rimborsato senza domande, e il lavoro fatto resta comunque tuo.' },
        { title: 'Le decisioni restano scritte', body: 'Le scelte prese, le alternative scartate e il motivo. È lo stesso formato con cui sono raccontati i case study pubblici.' },
      ],
      whatTitle: 'Cosa possiamo fare insieme',
      whatBody: "Nell'ordine in cui le cose vanno affrontate: prima progettare, poi verificare, poi automatizzare. L'automazione amplifica tutto quello che le sta sopra, errori compresi.",
      trainingTitle: 'Formazione per il team',
      trainingBody: 'Quando il problema non è costruire ma saper fare: un percorso con il team, sul vostro stack.',
      trainingMore: 'Moduli da scegliere in discovery call',
      processTitle: 'Come si procede',
      process: [
        ['01', 'Discovery call', "30 minuti, gratuiti. Raccontami com'è fatto il sistema adesso e qual è la decisione su cui siete fermi. Serve a capire se c'è un problema su cui posso essere utile."],
        ['02', 'Affondo mirato', "Un'area sola, un risultato concreto in mano, consegnato entro due settimane. Prezzo fisso, e il lavoro resta tuo in ogni caso."],
        ['03', 'Ingaggio continuativo', 'Se il problema è più grande di un affondo. Mese per mese, un obiettivo attivo per volta, con tutto quello che serve al sistema incluso.'],
        ['04', 'Uscita', 'Handover doc, runbook e un owner interno formato. Da qui in avanti il team va avanti da solo.'],
      ],
      fitTitle: 'Quando sono la scelta giusta',
      fitYes: 'Lavoriamo bene insieme se…',
      fitNo: 'Non sono la scelta giusta se…',
      fitExtra: 'vuoi che alla fine il team resti capace di andare avanti da solo',
      faqTitle: 'Domande frequenti',
      faq: [
        { q: 'Quanto costa?', a: "L'affondo mirato ha un prezzo fisso di €1.200: un'area sola, consegna in due settimane, rimborsato se non sei soddisfatto. L'ingaggio continuativo parte da €2.500 al mese, mese per mese, con un obiettivo attivo per volta." },
        { q: 'Come funziona la prima call?', a: 'Trenta minuti, gratuiti, senza impegno e senza slide. Mi racconti dove sta il sistema e cosa vi blocca, e ne esce se e come ha senso lavorare insieme.' },
        { q: 'Cosa resta a fine ingaggio?', a: "Un handover doc, i runbook e un owner interno che ho formato. Più il codice, i test e le decisioni documentate: il sistema non deve dipendere da me per funzionare." },
      ],
      ctaTitle: 'Hai una decisione tecnica che merita chiarezza?',
      ctaDesc: 'Trenta minuti bastano per capire dove sta il problema e se posso essere utile. Senza impegno, senza slide.',
      ctaPrimary: 'Parliamone',
      ctaSecondary: 'oppure scrivimi',
    };

/**
 * I casi in cui declinare. Finche' e' vuoto la sezione "quando sono la scelta
 * giusta" non compare: con una colonna sola non dice niente.
 *
 * Tre candidate, viste renderizzate il 2026-08-28 e messe da parte in attesa
 * delle parole dell'autore. Nessuna e' inventata: ognuna nasce da qualcosa che
 * il sito gia' afferma altrove.
 *
 *   - "cerchi qualcuno che esegua senza mettere in discussione le scelte"
 *     da: le decisioni restano scritte, alternative scartate comprese
 *   - "servono piu' lavori in parallelo, ognuno con la sua scadenza"
 *     da: l'impegno "un obiettivo attivo per volta"
 *   - "il sistema e' piccolo abbastanza che bastano un controllo periodico e un alert"
 *     da: la tabella "quando basta molto meno" del catalogo observability
 *
 * La terza e' la piu' solida: controintuitiva, verificabile, gia' detta altrove.
 * La prima e' la piu' rischiosa: si puo' leggere come "e' uno che discute".
 */
const notForYou: string[] = [];
---

<BaseLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/servizi.png" lang={lang}>
  <Header lang={lang} />
  <main>

    <section class="bg-accent-subtle border-b border-border/40 dark:border-border-dark/40">
      <div class="max-w-3xl mx-auto px-5 py-20 text-center fade-in-section">
        <p class="label-mono !text-accent">{t.eyebrow}</p>
        <h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight leading-[1.15] text-text-dark dark:text-text-light text-balance">
          {t.heroTitle}
        </h1>
        <p class="mt-5 text-text-muted leading-relaxed">{t.heroBody}</p>
        <div class="mt-8 flex flex-wrap gap-3 justify-center">
          <a href={calLink} target="_blank" rel="noopener noreferrer" data-umami-event="cta-servizi-hero"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent text-white text-sm font-semibold hover:bg-accent-hover transition-colors">
            {t.heroCta} &rarr;
          </a>
          <a href={`${prefix}/case-study/`}
            class={`inline-flex items-center gap-2 px-6 py-3 rounded-lg border ${hair} text-sm font-semibold text-text-dark dark:text-text-light hover:border-accent hover:text-accent transition-colors`}>
            {t.heroSecondary(caseStudyCount)}
          </a>
        </div>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-5 py-16">
      <h2 class={h2}>{t.howTitle}</h2>
      <div class="grid md:grid-cols-2 gap-4 mt-8">
        {t.commitments.map((c) => (
          <div class="surface-card p-6">
            <h3 class="font-semibold text-text-dark dark:text-text-light">{c.title}</h3>
            <p class="mt-2 text-sm text-text-muted leading-relaxed">{c.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-surface dark:bg-surface-dark/40 border-y border-border/40 dark:border-border-dark/40">
      <div class="max-w-5xl mx-auto px-5 py-16">
        <h2 class={h2}>{t.whatTitle}</h2>
        <p class="mt-4 text-text-muted leading-relaxed max-w-2xl">{t.whatBody}</p>
        <div class="grid md:grid-cols-2 gap-4 mt-8">
          {services.map((s, i) => (
            <a href={s.data.link ? `${prefix}${s.data.link}` : `${prefix}/case-study/`} class="group surface-link block p-6">
              <p class="label-mono !text-accent">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 text-lg font-bold text-text-dark dark:text-text-light group-hover:text-accent transition-colors">
                {s.data.title}
              </h3>
              <p class="mt-2 text-sm text-text-muted leading-relaxed">{s.data.description}</p>
              {s.data.items.length > 0 && (
                <ul class={`mt-4 pt-4 border-t ${hair} space-y-1.5`}>
                  {s.data.items.map((it) => (
                    <li class="flex gap-2 text-sm text-text-muted">
                      <span class="text-accent">&rsaquo;</span>
                      <span>{it}</span>
                    </li>
                  ))}
                </ul>
              )}
            </a>
          ))}

          <a href={`${prefix}/workshop/`} class="group surface-link block p-6">
            <p class="label-mono !text-accent">{String(services.length + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 text-lg font-bold text-text-dark dark:text-text-light group-hover:text-accent transition-colors">
              {t.trainingTitle}
            </h3>
            <p class="mt-2 text-sm text-text-muted leading-relaxed">{t.trainingBody}</p>
            <ul class={`mt-4 pt-4 border-t ${hair} space-y-1.5`}>
              {workshops.map((w) => (
                <li class="flex gap-2 text-sm text-text-muted">
                  <span class="text-accent">&rsaquo;</span>
                  <span>{lang === 'en' ? w.titleEn : w.title}</span>
                </li>
              ))}
              <li class="flex gap-2 text-sm text-text-muted">
                <span class="text-accent">&rsaquo;</span>
                <span>{t.trainingMore}</span>
              </li>
            </ul>
          </a>
        </div>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-5 py-16">
      <h2 class={h2}>{t.processTitle}</h2>
      <div class="grid md:grid-cols-4 gap-8 mt-8">
        {t.process.map(([n, titolo, desc]) => (
          <div>
            <p class="label-mono !text-accent">{n}</p>
            <h3 class="mt-2 font-semibold text-text-dark dark:text-text-light">{titolo}</h3>
            <p class="mt-2 text-sm text-text-muted leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    {notForYou.length > 0 && (
      <section class="bg-surface dark:bg-surface-dark/40 border-y border-border/40 dark:border-border-dark/40">
        <div class="max-w-5xl mx-auto px-5 py-16">
          <h2 class={h2}>{t.fitTitle}</h2>
          <div class="grid md:grid-cols-2 gap-4 mt-8">
            <div class="rounded-xl border-2 border-accent p-6">
              <h3 class="font-semibold text-text-dark dark:text-text-light">{t.fitYes}</h3>
              <ul class="mt-4 space-y-2.5">
                {[...signals[lang].map((s) => s.title.charAt(0).toLowerCase() + s.title.slice(1)), t.fitExtra].map((x) => (
                  <li class="flex gap-2.5 text-sm text-text-muted leading-relaxed">
                    <span class="text-accent shrink-0">✓</span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="surface-card p-6">
              <h3 class="font-semibold text-text-dark dark:text-text-light">{t.fitNo}</h3>
              <ul class="mt-4 space-y-2.5">
                {notForYou.map((x) => (
                  <li class="flex gap-2.5 text-sm text-text-muted leading-relaxed">
                    <span class="text-text-muted shrink-0">✕</span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="max-w-3xl mx-auto px-5 py-16">
      <h2 class={h2}>{t.faqTitle}</h2>
      <div class={`mt-8 border-t ${hair}`}>
        {t.faq.map((f) => (
          <details class={`group border-b ${hair}`}>
            <summary class="flex items-center justify-between gap-4 py-4 cursor-pointer font-semibold text-text-dark dark:text-text-light hover:text-accent transition-colors">
              {f.q}
              <span class="text-accent shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="pb-5 text-text-muted leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <FinalCta
      title={t.ctaTitle}
      desc={t.ctaDesc}
      ctaLabel={t.ctaPrimary}
      ctaHref={calLink}
      secondaryLabel={t.ctaSecondary}
      secondaryHref={mailLink}
      umamiEvent="cta-servizi-final"
      fullBleed
    />
  </main>
  <Footer lang={lang} />
</BaseLayout>
