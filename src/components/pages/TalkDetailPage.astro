---
import PageLayout from '@/layouts/PageLayout.astro';
import TalkGallery from '@/components/interactive/TalkGallery.vue';
import { talks } from '@/data/talks';
import { talkImagesFrom } from '@/utils/talks';
import TalkLanguage from '@/components/ui/TalkLanguage.astro';

interface Props {
  slug: string;
  lang?: 'it' | 'en';
}

const { slug, lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const talk = talks.find((tk) => tk.slug === slug)!;

const allTalkImages = import.meta.glob<{ default: { src: string } }>(
  '/src/assets/talks/*/*.{webp,jpg,jpeg,png}',
  { eager: true },
);
const images = talkImagesFrom(allTalkImages, slug);

const locale = lang === 'en' ? 'en-US' : 'it-IT';
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString(locale, { year: 'numeric', month: 'long' });

const t = lang === 'en'
  ? {
      back: 'All talks',
      upcoming: 'Upcoming',
      gallery: 'Gallery',
      linkArticle: 'Read the article',
      linkRepo: 'Slides & material',
      linkSlides: 'Slides',
      linkCode: 'Demo code',
      linkRecording: 'Recording',
      linkLinkedin: 'LinkedIn',
      linkConference: 'Conference',
      linkSpeaker: 'Speaker page',
    }
  : {
      back: 'Tutti i talk',
      upcoming: 'In arrivo',
      gallery: 'Galleria',
      linkArticle: 'Leggi l\'articolo',
      linkRepo: 'Slide e materiale',
      linkSlides: 'Slide',
      linkCode: 'Codice della demo',
      linkRecording: 'Registrazione',
      linkLinkedin: 'LinkedIn',
      linkConference: 'Conferenza',
      linkSpeaker: 'Pagina speaker',
    };

type LinkKey = 'article' | 'code' | 'repo' | 'slides' | 'recording' | 'linkedin' | 'conference' | 'speaker';
const linkOrder: LinkKey[] = ['article', 'slides', 'code', 'repo', 'recording', 'linkedin', 'conference', 'speaker'];
const linkLabel: Record<LinkKey, string> = {
  article: t.linkArticle,
  code: t.linkCode,
  repo: t.linkRepo,
  slides: t.linkSlides,
  recording: t.linkRecording,
  linkedin: t.linkLinkedin,
  conference: t.linkConference,
  speaker: t.linkSpeaker,
};
---

<PageLayout title={talk.title[lang]} description={talk.abstract[lang].split("\n\n")[0]} ogImage="/og/talks.png" lang={lang}>
  <a href={`${prefix}/talks/`} class="inline-block text-sm font-semibold text-accent hover:underline mb-8">&larr; {t.back}</a>

  <header class="mb-10">
    <p class="label-mono !text-accent font-bold">
      {talk.event} &middot; {fmtDate(talk.date)} &middot; {talk.location}
      {talk.status === 'upcoming' && <span> &middot; {t.upcoming}</span>}
    </p>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.1] text-text-dark mt-4 max-w-4xl">
      {talk.title[lang]}
    </h1>
    <TalkLanguage language={talk.language} lang={lang} class="mt-5" />
  </header>

  {images.length > 0 && (
    <section class="mb-12" aria-label={t.gallery}>
      <TalkGallery client:load images={images} title={talk.title[lang]} />
    </section>
  )}

  <div class="grid md:grid-cols-[1fr_16rem] gap-10 md:gap-14 mb-16">
    <div class="space-y-5 text-lg text-text-muted leading-relaxed max-w-2xl">
      {talk.abstract[lang].split('\n\n').map((para) => <p class="whitespace-pre-line">{para}</p>)}
      {talk.recap && (
        <p>
          {talk.recap[lang]}{' '}
          <a href={talk.recap.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-text-dark underline decoration-accent underline-offset-4 hover:text-accent transition-colors">{talk.recap.title}</a>
        </p>
      )}
    </div>

    {talk.links && (
      <aside class="md:pt-1">
        <ul class="border-y border-border divide-y divide-border md:sticky md:top-24">
          {linkOrder.map((key) => {
            const href = talk.links?.[key];
            if (!href) return null;
            const external = href.startsWith('http');
            return (
              <li>
                <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class="group flex items-center justify-between gap-3 py-3.5 font-semibold text-text-dark hover:text-accent transition-colors">
                  {linkLabel[key]}
                  <span class="text-accent" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            );
          })}
        </ul>
      </aside>
    )}
  </div>
</PageLayout>
