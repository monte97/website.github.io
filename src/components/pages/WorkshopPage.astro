---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Button from '@/components/ui/Button.astro';
import FinalCta from '@/components/ui/FinalCta.astro';
import { pillarStyles } from '@/data/pillar-styles';
import { pillarLabels } from '@/data/pillars';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const allProjects = await getCollection('projects');
const workshops = allProjects
  .filter((p) => p.data.type === 'workshop')
  .sort((a, b) => a.data.weight - b.data.weight);

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';
const mailLink = 'mailto:francesco@montelli.dev';

const t = lang === 'en'
  ? {
      pageTitle: 'Workshops',
      pageDesc: 'Hands-on workshops and training for engineering teams. Focused sessions on a specific topic, run with the team that has to apply what they learn.',
      eyebrow: 'Training',
      heroTitle: 'Hands-on workshops for engineering teams',
      heroSubtitle: 'One specific topic, on your real stack, with the team that has to apply it.',
      intro: "Workshops are hands-on training on a specific topic, run with the team that has to apply what they learn. Every session adapts to the team's level and stack, and if the topic you need isn't listed, we build it around your needs.",
      customTitle: 'Tailored workshop',
      customDesc: "Can't find the right topic? We build it around your team's needs, on your real stack.",
      customCta: "Let's talk",
      ctaTitle: 'Need a tailored session for your team?',
      ctaDesc: "Tell me where the team is now and what you want them to walk away with. We'll define scope and format together.",
      ctaPrimary: 'Book a discovery call',
      ctaSecondary: 'or write me',
      durationLabel: 'Duration',
      audienceLabel: 'For',
    }
  : {
      pageTitle: 'Workshop',
      pageDesc: 'Workshop e formazione hands-on per team di sviluppo. Sessioni mirate su un tema specifico, fatte con il team che dovrà applicare quello che impara.',
      eyebrow: 'Formazione',
      heroTitle: 'Workshop hands-on per team di sviluppo',
      heroSubtitle: 'Un tema specifico, sul vostro stack reale, con il team che dovrà applicarlo. Si esce sapendo fare.',
      intro: 'I workshop sono formazione hands-on su un tema specifico, fatta con il team che dovrà applicare quello che impara. Ogni sessione si adatta al livello e allo stack del team, e se il tema che ti serve non è in elenco, lo costruiamo su misura sulle vostre esigenze.',
      customTitle: 'Workshop su misura',
      customDesc: 'Non trovi il tema giusto? Lo costruiamo sulle esigenze del tuo team, sul vostro stack reale.',
      customCta: 'Parliamone',
      ctaTitle: 'Serve una sessione su misura per il tuo team?',
      ctaDesc: "Raccontami dove sta il team ora e cosa vuoi che si porti a casa. Definiamo insieme scope e formato.",
      ctaPrimary: 'Prenota una discovery call',
      ctaSecondary: 'oppure scrivimi',
      durationLabel: 'Durata',
      audienceLabel: 'Per',
    };
---

<BaseLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/workshop.webp" lang={lang}>
  <Header lang={lang} />
  <main>

    {/* HERO — banda centrata con eyebrow, stessa struttura dei servizi */}
    <section class="bg-accent-subtle border-b border-border/40 dark:border-border-dark/40">
      <div class="max-w-3xl mx-auto px-5 py-16 md:py-24 text-center fade-in-section">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-5">{t.eyebrow}</p>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-text-dark dark:text-text-light text-balance leading-[1.2]">
          {t.heroTitle}
        </h1>
        <p class="mt-5 text-base md:text-lg text-text-muted max-w-xl mx-auto leading-relaxed">
          {t.heroSubtitle}
        </p>
      </div>
    </section>

    {/* CONTENUTO */}
    <section>
      <div class="max-w-6xl mx-auto px-5 pt-12 md:pt-16 pb-16 md:pb-20">
        <p class="text-text-muted text-base md:text-lg leading-relaxed max-w-3xl mx-auto text-center mb-10 md:mb-12">{t.intro}</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 stagger-children items-stretch">
    {workshops.map((ws) => {
      const styles = pillarStyles[ws.data.pillar];
      return (
        <a
          href={`${prefix}/workshop/${ws.id}/`}
          class="group flex flex-col rounded-2xl border border-border/60 dark:border-border-dark/60 bg-white dark:bg-surface-dark p-6 md:p-7 shadow-sm hover:shadow-md hover:border-accent/40 transition-all duration-200"
        >
          <div class="flex items-center justify-between mb-5">
            <span class="flex items-center justify-center w-11 h-11 rounded-xl border border-accent/30 text-accent shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.3c-1.9-1.2-4.2-1.5-6.3-1v11.4c2.1-0.5 4.4-0.2 6.3 1 1.9-1.2 4.2-1.5 6.3-1V5.3c-2.1-0.5-4.4-0.2-6.3 1Zm0 0V18" />
              </svg>
            </span>
            <span class={`text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full whitespace-nowrap shrink-0 ${styles.badge}`}>
              {pillarLabels[ws.data.pillar][lang]}
            </span>
          </div>
          <h2 class="text-lg md:text-xl font-bold text-text-dark dark:text-text-light mb-3 group-hover:text-accent transition-colors">
            {ws.data.title}
          </h2>
          <p class="text-text-muted text-sm leading-relaxed mb-4 flex-1">{ws.data.description}</p>
          {ws.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {ws.data.tags.slice(0, 5).map((tag) => (
                <span class="text-[11px] text-text-muted/80 bg-text-muted/8 px-1.5 py-0.5 rounded">{tag}</span>
              ))}
            </div>
          )}
        </a>
      );
    })}

    {/* Workshop su misura — la customizzazione resa esplicita come card */}
    <a
      href={calLink}
      class="group flex flex-col rounded-2xl border border-dashed border-accent/40 bg-accent-subtle/40 p-6 md:p-7 hover:border-accent hover:bg-accent-subtle/70 transition-all duration-200"
    >
      <div class="flex items-center mb-5">
        <span class="flex items-center justify-center w-11 h-11 rounded-xl border border-accent/40 text-accent shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        </span>
      </div>
      <h2 class="text-lg md:text-xl font-bold text-text-dark dark:text-text-light mb-3 group-hover:text-accent transition-colors">
        {t.customTitle}
      </h2>
      <p class="text-text-muted text-sm leading-relaxed mb-4 flex-1">{t.customDesc}</p>
      <span class="text-sm font-semibold text-accent">{t.customCta} &rarr;</span>
    </a>
        </div>
      </div>
    </section>

    {/* CTA */}
    <FinalCta title={t.ctaTitle} desc={t.ctaDesc} ctaLabel={t.ctaPrimary} secondaryLabel={t.ctaSecondary} secondaryHref={mailLink} umamiEvent="cta-workshop-final" fullBleed />

  </main>
  <Footer lang={lang} />
</BaseLayout>
