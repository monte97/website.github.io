---
/**
 * Indice della sezione formazione: i workshop che vengono erogati davvero.
 *
 * In inglese esiste solo questa pagina, le landing sono in italiano: la scheda
 * lo dice invece di portare l'utente su una pagina che non sa leggere.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FinalCta from '@/components/ui/FinalCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { alsoDelivered } from '@/data/workshops';
import { getWorkshops } from '@/utils/workshop';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const workshops = await getWorkshops();
const mono = 'label-mono';

const t = lang === 'en'
  ? {
      pageTitle: 'Training',
      pageDesc: 'Hands-on workshops for engineering teams: AI agents in Python, observability, end-to-end testing. Modules are a menu, not a programme to complete.',
      eyebrow: 'Training',
      heroTitle: 'Hands-on workshops for engineering teams',
      heroSubtitle: 'One topic at a time, on your stack. The modules are available to choose from, not a programme to complete: they get picked during the discovery call.',
      modules: (n: number) => `${n} modules available`,
      custom: 'Tailored path',
      alsoTitle: 'Training also already delivered on',
      itOnly: 'The detailed pages are in Italian',
      articles: (n: number) => (n === 1 ? '1 article' : `${n} articles`),
      talks: (n: number) => (n === 1 ? '1 talk' : `${n} talks`),
      ctaTitle: 'Shall we talk about the path for your team?',
      ctaDesc: 'Tell me where the team is now and what it has to be able to do at the end.',
      ctaPrimary: 'Book a discovery call',
    }
  : {
      pageTitle: 'Formazione',
      pageDesc: 'Workshop hands-on per team di sviluppo: agenti AI in Python, observability, testing end-to-end. I moduli sono a disposizione, non un programma da completare.',
      eyebrow: 'Formazione',
      heroTitle: 'Workshop hands-on per team di sviluppo',
      heroSubtitle: 'Un tema per volta, sul vostro stack. I moduli sono a disposizione, non un programma da completare: si scelgono in discovery call.',
      modules: (n: number) => `${n} moduli a disposizione`,
      custom: 'Percorso su misura',
      alsoTitle: 'Formazione già erogata anche su',
      itOnly: '',
      articles: (n: number) => (n === 1 ? '1 articolo' : `${n} articoli`),
      talks: (n: number) => (n === 1 ? '1 talk' : `${n} talk`),
      ctaTitle: 'Parliamo del percorso per il tuo team?',
      ctaDesc: 'Raccontami dove sta il team ora e cosa deve saper fare alla fine.',
      ctaPrimary: 'Prenota una discovery call',
    };

const cardClass = 'flex flex-col surface-card p-6';
---

<BaseLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/workshop.png" lang={lang}>
  <Header lang={lang} />
  <main>
    <PageHero title={t.heroTitle} subtitle={t.heroSubtitle} eyebrow={t.eyebrow} align="center" />

    <div class="max-w-5xl mx-auto px-5 py-14">
      <div class="grid md:grid-cols-3 gap-5 items-stretch">
        {workshops.map((w) => {
          const Tag = lang === 'it' ? 'a' : 'div';
          return (
            <Tag
              href={lang === 'it' ? `/workshop/${w.slug}/` : undefined}
              class:list={[
                cardClass,
                lang === 'it' && 'group hover:border-accent/40 hover:bg-accent/5 transition-all',
              ]}
            >
              <p class={mono}>{w.moduleCount > 0 ? t.modules(w.moduleCount) : t.custom}</p>
              <h2 class="mt-3 text-xl font-bold text-text-dark dark:text-text-light leading-snug group-hover:text-accent transition-colors">
                {lang === 'en' ? w.titleEn : w.title}
              </h2>
              <p class="mt-3 text-sm text-text-muted leading-relaxed">{lang === 'en' ? w.goalEn : w.goal}</p>

              {lang === 'it' && w.groups.length > 0 && (
                <ul class="mt-5 space-y-1.5">
                  {w.groups[w.groups.length - 1].modules.slice(0, 4).map((m) => (
                    <li class="flex gap-2 text-sm text-text-muted">
                      <span class="mt-2 shrink-0 w-1 h-1 rounded-full bg-accent" />
                      <span>{m.name}</span>
                    </li>
                  ))}
                </ul>
              )}

              {lang === 'it' && w.delivered && (
                <p class="mt-5 text-sm text-text-muted leading-relaxed">{w.delivered}</p>
              )}

              <div class="mt-auto pt-5 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-border/60 dark:border-border-dark/60">
                <span class={mono}>{t.articles(w.postCount)}</span>
                {w.talks.length > 0 && <span class={mono}>{t.talks(w.talks.length)}</span>}
                {lang === 'it' && <span class="ml-auto text-accent text-sm font-semibold">Vedi &rarr;</span>}
              </div>
            </Tag>
          );
        })}
      </div>

      {lang === 'en' && (
        <p class="mt-6 text-sm text-text-muted">
          {t.itOnly}: <a href="/workshop/" class="text-accent hover:underline">montelli.dev/workshop</a>
        </p>
      )}

      <section class="mt-16 pt-8 border-t border-border/70 dark:border-border-dark/70">
        <p class={mono}>{t.alsoTitle}</p>
        <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2">
          {alsoDelivered.map((d) => (
            <li class="text-sm text-text-muted">
              {d.title}
              {d.repo && (
                <a href={d.repo} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline ml-2">
                  repository
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <FinalCta
      title={t.ctaTitle}
      desc={t.ctaDesc}
      ctaLabel={t.ctaPrimary}
      umamiEvent="cta-workshop-final"
      fullBleed
    />
  </main>
  <Footer lang={lang} />
</BaseLayout>
