---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { author } from '@/data/author';
import { publications } from '@/data/publications';
import { pillarStyles } from '@/data/pillar-styles';
import { pillarLabels, type Pillar } from '@/data/pillars';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const bio = author.bio[lang];
const prefix = lang === 'en' ? '/en' : '';

const calLink = 'https://cal.eu/monte97/30min';
const mailLink = 'mailto:francesco@montelli.dev';

type PillarBrief = { pillar: Pillar; description: string };

const pillarsBrief: PillarBrief[] = lang === 'en'
  ? [
      { pillar: 'progettare', description: 'The architectural decisions that cost the most to change later. This is where the work starts.' },
      { pillar: 'verificare', description: 'Making sure the system actually works — under load, under attack, over time.' },
      { pillar: 'automatizzare', description: 'Only after designing and verifying. Automation amplifies whatever is upstream of it.' },
    ]
  : [
      { pillar: 'progettare', description: 'Le decisioni architetturali più costose da cambiare in corsa. È da qui che parte il lavoro.' },
      { pillar: 'verificare', description: 'Sapere che il sistema funziona davvero — sotto carico, sotto attacco, nel tempo.' },
      { pillar: 'automatizzare', description: "Solo dopo aver progettato e verificato. L'automazione amplifica ciò che ha a monte." },
    ];

const t = lang === 'en'
  ? {
      pageTitle: 'About',
      heroTitle: 'About me',
      heroSubtitle: `${author.name} — Software Engineer, distributed systems`,
      cvLabel: 'Download CV',
      philosophyQuote: "AI today writes code the way robots assemble cars: fast, at scale, tirelessly. But no one lets a robot design the chassis or sign off on the brakes. That part is still a human responsibility.",
      whoTitle: 'Who I am',
      orderTitle: 'Registered with the Italian Order of Engineers',
      orderBody: "Member of the Italian Order of Engineers (Ordine degli Ingegneri della Provincia di Ravenna). It's not just a registration number — it carries professional liability. When I sign off, I'm the one accountable. No company behind me to deflect to.",
      methodTitle: 'The method',
      methodIntro: 'Three pillars that multiply — not three services that add up. The order is not negotiable.',
      skillsLink: 'Want to see in detail what I work with?',
      skillsLinkLabel: 'Skills and stack',
      blogTitle: 'The blog as an extension of the method',
      blogBody: "I write the kind of articles I would have wanted to find before making a decision. Not summaries of documentation — real cases, tradeoffs made explicit, things I learned by getting them wrong first. If you want to check whether what I claim matches what I do, the blog is the place.",
      blogCta: 'Read the blog',
      pubTitle: 'Publications',
      pubIntro: "Member of the Scientific Committee of Operai dell'Arte APS. Co-author of peer-reviewed publications in geomatics and cultural heritage.",
      ctaTitle: 'Want to talk?',
      ctaDesc: '30 minutes, free, to figure out if we can work together.',
      ctaPrimary: 'Book a call',
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'About',
      heroTitle: 'Chi sono',
      heroSubtitle: `${author.name} — Software Engineer, sistemi distribuiti`,
      cvLabel: 'Scarica il CV',
      philosophyQuote: "La IA oggi scrive codice come i robot assemblano le automobili: veloce, in larga scala, senza stancarsi. Ma nessuno affida a un robot la progettazione di una carrozzeria o il collaudo dei freni. Quella parte è ancora una questione umana.",
      whoTitle: 'Chi sono',
      orderTitle: "Iscritto all'Ordine degli Ingegneri",
      orderBody: "Iscritto all'Ordine degli Ingegneri della Provincia di Ravenna. Non è solo un numero di iscrizione — è responsabilità professionale. Quando firmo, sono io che ne rispondo. Non un'azienda dietro di me.",
      methodTitle: 'Il metodo',
      methodIntro: 'Tre pilastri che si moltiplicano, non tre servizi che si sommano. L\'ordine non è negoziabile.',
      skillsLink: 'Vuoi vedere nel dettaglio con cosa lavoro?',
      skillsLinkLabel: 'Competenze e stack',
      blogTitle: 'Il blog come estensione del metodo',
      blogBody: "Scrivo il tipo di articoli che mi sarebbe servito trovare prima di prendere una decisione. Non sono riassunti di documentazione: sono casi reali, tradeoff sul tavolo, cose che ho imparato sbagliandole prima. Se vuoi verificare se quello che racconto coincide con quello che faccio, il blog è il posto.",
      blogCta: 'Vai al blog',
      pubTitle: 'Pubblicazioni',
      pubIntro: "Membro del Comitato Tecnico-Scientifico di Operai dell'Arte APS. Co-autore di pubblicazioni peer-reviewed in geomatica e patrimonio culturale.",
      ctaTitle: 'Vogliamo parlarne?',
      ctaDesc: '30 minuti, gratuiti, per capire se possiamo lavorare insieme.',
      ctaPrimary: 'Prenota una call',
      ctaSecondary: 'oppure scrivimi',
    };
---

<PageLayout title={t.pageTitle} lang={lang}>
  <PageHero
    title={t.heroTitle}
    subtitle={t.heroSubtitle}
    image={{ src: author.image, alt: author.name }}
    cta={{ href: '/files/Francesco_Montelli_CV.pdf', label: t.cvLabel }}
  />

  {/* Apertura filosofica */}
  <section class="mb-20 fade-in-section">
    <blockquote class="border-l-4 border-l-accent pl-6 max-w-3xl">
      <p class="text-xl md:text-2xl leading-relaxed text-text-dark dark:text-text-light italic">
        {t.philosophyQuote}
      </p>
    </blockquote>
  </section>

  {/* Chi sono */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title={t.whoTitle} />
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl">
      {bio}
    </p>
  </section>

  {/* Iscrizione Ordine — evidenziata */}
  <section class="mb-20 fade-in-section">
    <div class="rounded-xl border border-accent/30 bg-accent/5 p-8 md:p-10 max-w-3xl">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-12 h-12 rounded-full bg-accent/15 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-accent">
            <path d="M12 2 4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-bold text-text-dark dark:text-text-light mb-3">
            {t.orderTitle}
          </h2>
          <p class="text-text-muted leading-relaxed">
            {t.orderBody}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Il metodo */}
  <section class="mb-12 fade-in-section">
    <SectionHeading title={t.methodTitle} />
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl mb-8">
      {t.methodIntro}
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 stagger-children">
      {pillarsBrief.map((p, i) => {
        const styles = pillarStyles[p.pillar];
        const label = pillarLabels[p.pillar][lang];
        return (
          <div class={`rounded-xl border border-border/70 dark:border-border-dark/70 border-l-[3px] ${styles.borderLeft} p-6 bg-white dark:bg-surface-dark`}>
            <div class="flex items-baseline gap-3 mb-2">
              <span class={`text-sm font-mono ${styles.text}`}>0{i + 1}</span>
              <h3 class={`font-semibold text-base ${styles.text}`}>{label}</h3>
            </div>
            <p class="text-text-muted text-sm leading-relaxed">{p.description}</p>
          </div>
        );
      })}
    </div>
  </section>

  {/* Link a /about/competenze */}
  <section class="mb-20 fade-in-section">
    <a
      href={`${prefix}/about/competenze/`}
      class="inline-flex items-baseline gap-2 text-accent hover:underline text-base font-medium"
    >
      {t.skillsLink} <span class="font-semibold">{t.skillsLinkLabel}</span> <span aria-hidden="true">→</span>
    </a>
  </section>

  {/* Il blog come estensione del metodo */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title={t.blogTitle} />
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl mb-6">
      {t.blogBody}
    </p>
    <Button href={`${prefix}/blog/`} variant="secondary" size="md">
      {t.blogCta}
    </Button>
  </section>

  {/* Pubblicazioni — ridotta */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title={t.pubTitle} />
    <p class="text-text-muted leading-relaxed max-w-3xl mb-5">{t.pubIntro}</p>
    <ul class="space-y-2 max-w-3xl">
      {publications.map((pub) => (
        <li>
          <a
            href={pub.paper.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-text-dark dark:text-text-light hover:text-accent transition-colors inline-flex items-baseline gap-2"
          >
            <span>{pub.title}</span>
            <span class="text-text-muted shrink-0">— {pub.publishedIn.name}, {pub.publishedIn.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* CTA finale */}
  <section class="text-center py-16 fade-in-section">
    <h2 class="text-3xl font-bold mb-3">{t.ctaTitle}</h2>
    <p class="text-text-muted text-lg mb-8 max-w-xl mx-auto">{t.ctaDesc}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <Button href={calLink} variant="primary" size="lg">
        {t.ctaPrimary}
      </Button>
      <a href={mailLink} class="text-sm text-text-muted hover:text-accent transition-colors">
        {t.ctaSecondary}
      </a>
    </div>
  </section>
</PageLayout>
