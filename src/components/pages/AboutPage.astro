---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import FinalCta from '@/components/ui/FinalCta.astro';
import { author } from '@/data/author';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const prefix = lang === 'en' ? '/en' : '';

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';
const mailLink = 'mailto:francesco@montelli.dev';
const cvHref = '/files/Francesco_Montelli_CV.pdf';

const t = lang === 'en'
  ? {
      pageTitle: 'About',
      pageDesc: 'Francesco Montelli, freelance Software Engineer. Philosophy, method and how I work.',
      heroTitle: author.name,
      heroSubtitle: 'Software Engineer · product systems',
      philosophyQuote: "AI today writes code the way robots assemble cars: fast, at scale, tirelessly. But no one lets a robot design the chassis or sign off on the brakes. That part is still a human responsibility.",
      whoTitle: 'Who I am',
      whoBody: [
        "I started working in 2016 while still studying. I learned almost everything on my own and, over time, developed a precise idea of how software should be built. Not an idea about technologies: those change. An idea about method: what comes first, what comes after, and why the order is not negotiable.",
        "I work with product companies: sometimes from scratch, sometimes on a system grown rigid over time that now fights every change. My ultimate goal is to make myself unnecessary: the system shouldn't depend on me to keep working.",
      ],
      blogTitle: 'The blog as an extension of the method',
      blogBody: "I write the kind of articles I would have wanted to find before making a decision. Not summaries of documentation: real cases, tradeoffs made explicit, things I learned by getting them wrong first. If you want to check whether what I claim matches what I do, the blog is the place.",
      blogCta: 'Read the blog',
      talksTitle: 'Conferences & speaking',
      talksBody: 'What I write about on the blog, I also bring to the stage. I am starting to speak at conferences on design, testing and automation.',
      talksCta: 'See all talks',
      ctaTitle: 'Want to talk?',
      ctaDesc: '30 minutes, free, to figure out if we can work together.',
      ctaPrimary: 'Book a discovery call',
      ctaSecondary: 'or write me',
      cvLabel: 'Download CV',
    }
  : {
      pageTitle: 'About',
      pageDesc: 'Francesco Montelli, Software Engineer freelance. Filosofia, metodo e come lavoro.',
      heroTitle: author.name,
      heroSubtitle: 'Software Engineer · sistemi di prodotto',
      philosophyQuote: "La IA oggi scrive codice come i robot assemblano le automobili: veloce, in larga scala, senza stancarsi. Ma nessuno affida a un robot la progettazione di una carrozzeria o il collaudo dei freni. Quella parte è ancora una questione umana.",
      whoTitle: 'Chi sono',
      whoBody: [
        "Ho iniziato a lavorare nel 2016 mentre ancora studiavo, ho imparato quasi tutto da solo e ho sviluppato nel tempo un'idea precisa su come il software dovrebbe essere costruito. Non un'idea sulle tecnologie: quelle cambiano. Un'idea sul metodo: cosa viene prima, cosa viene dopo, e perché l'ordine non è negoziabile.",
        "Lavoro con aziende di prodotto: a volte parto da zero, a volte da un sistema irrigidito nel tempo che ora combatte ogni modifica. Il mio obiettivo finale è rendermi inutile: il sistema non deve dipendere da me per funzionare.",
      ],
      blogTitle: 'Il blog come estensione del metodo',
      blogBody: "Scrivo il tipo di articoli che mi sarebbe servito trovare prima di prendere una decisione. Non sono riassunti di documentazione: sono casi reali, tradeoff sul tavolo, cose che ho imparato sbagliandole prima. Se vuoi verificare se quello che racconto coincide con quello che faccio, il blog è il posto.",
      blogCta: 'Vai al blog',
      talksTitle: 'Conferenze & speaking',
      talksBody: 'Quello che scrivo sul blog lo porto anche sul palco. Ho iniziato a parlare alle conferenze di progettazione, testing e automazione.',
      talksCta: 'Vedi tutti i talk',
      ctaTitle: 'Vogliamo parlarne?',
      ctaDesc: '30 minuti, gratuiti, per capire se possiamo lavorare insieme.',
      ctaPrimary: 'Prenota una discovery call',
      ctaSecondary: 'oppure scrivimi',
      cvLabel: 'Scarica il CV',
    };
---

<PageLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/about.webp" lang={lang}>
  <PageHero
    title={t.heroTitle}
    subtitle={t.heroSubtitle}
    image={{ src: author.image, alt: author.name }}
  />

  {/* Apertura filosofica */}
  <section class="mb-20 fade-in-section">
    <blockquote class="border-l-4 border-l-accent pl-6 max-w-3xl">
      <p class="text-xl md:text-2xl leading-relaxed text-text-dark dark:text-text-light italic">
        {t.philosophyQuote}
      </p>
    </blockquote>
  </section>

  {/* Chi sono — narrativa */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title={t.whoTitle} />
    <div class="space-y-5 max-w-3xl">
      {t.whoBody.map((p) => (
        <p class="text-text-muted text-lg leading-relaxed">{p}</p>
      ))}
    </div>
  </section>

  {/* Il blog come estensione del metodo */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title={t.blogTitle} />
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl mb-6">
      {t.blogBody}
    </p>
    <Button href={`${prefix}/blog/`} variant="secondary" size="md">
      {t.blogCta}
    </Button>
  </section>

  {/* Teaser talk */}
  <section class="mb-20 fade-in-section">
    <SectionHeading title={t.talksTitle} />
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl mb-6">
      {t.talksBody}
    </p>
    <Button href={`${prefix}/talks/`} variant="secondary" size="md">
      {t.talksCta} &rarr;
    </Button>
  </section>

  {/* CTA finale */}
  <FinalCta title={t.ctaTitle} desc={t.ctaDesc} ctaLabel={t.ctaPrimary} secondaryLabel={t.ctaSecondary} secondaryHref={mailLink}>
    <p class="mt-8">
      <a href={cvHref} class="text-sm text-white/70 hover:text-white underline underline-offset-4 transition-colors">{t.cvLabel} &rarr;</a>
    </p>
  </FinalCta>
</PageLayout>
