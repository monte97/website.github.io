---
/**
 * About: la pagina racconta, non vende. La vendita sta in /servizi/, e da qui
 * viene solo nominata. Blog, talk e competenze sono rimandi, quindi pesano come
 * righe e non come capitoli; la colonna destra tiene il profilo e il rimando al
 * lavoro. Le competenze erano una pagina orfana: ora ci si arriva da due punti.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import FinalCta from '@/components/ui/FinalCta.astro';
import { author } from '@/data/author';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';
const mailLink = 'mailto:francesco@montelli.dev';
const linkedinLink = author.linkedin;
const cvHref = '/files/Francesco_Montelli_CV.pdf';

const icons = {
  skills: '<path d="M4 7h16M4 12h10M4 17h7"/>',
  blog: '<path d="M5 4h11l3 3v13H5z"/><path d="M8 11h8M8 15h6"/>',
  talks: '<path d="M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z"/><path d="M6 11a6 6 0 0 0 12 0M12 17v4"/>',
  services: '<rect x="4" y="8" width="16" height="11" rx="2"/><path d="M9 8V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>',
  chat: '<path d="M5 5h14v10H8l-3 3z"/>',
  case: '<path d="M5 5h14v14H5z"/><path d="M9 9h6M9 13h4"/>',
};

const t = lang === 'en'
  ? {
      pageTitle: 'About',
      pageDesc: 'Francesco Montelli, freelance Software Engineer. Philosophy, method and how I work.',
      heroSubtitle: 'Software Engineer · product systems',
      photoAlt: 'Francesco Montelli on stage at DevSecOps Day',
      skillsCta: 'Skills and stack',
      cvLabel: 'Download CV',
      quote: "AI today writes code the way robots assemble cars: fast, at scale, tirelessly. But no one lets a robot design the chassis or sign off on the brakes. That part is still a human responsibility.",
      whoTitle: 'Who I am',
      whoBody: [
        "I started working in 2016 while still studying, first as a sysadmin and then as a developer; my first full-time job came in 2021. I learned almost everything on my own and, over time, developed a precise idea of how software should be built. Not an idea about technologies: those change. An idea about method: what comes first, what comes after, and why the order is not negotiable.",
        "I work with product companies: sometimes from scratch, sometimes on a system grown rigid over time that now fights every change. My ultimate goal is to make myself unnecessary: the system shouldn't depend on me to keep working.",
      ],
      checkLabel: 'If you want to check',
      hello: 'Happy to talk, even just for a chat.',
      links: [
        {
          href: `${prefix}/about/competenze/`,
          label: 'Skills and stack',
          i: 'skills',
          desc: 'What I can do, organized by method instead of as a wall of logos.',
        },
        {
          href: `${prefix}/blog/`,
          label: 'The blog',
          i: 'blog',
          desc: 'The articles I would have wanted to find before making a decision: real cases, tradeoffs on the table.',
        },
        {
          href: `${prefix}/talks/`,
          label: 'Conferences and speaking',
          i: 'talks',
          desc: 'What I write about on the blog I also bring on stage, including the parts that went wrong.',
        },
      ],
      linkedinCta: 'Follow me on LinkedIn',
      workTitle: 'The work',
      workBody: 'What I do for clients, and the training paths that go with it, live in their own sections.',
      servicesLabel: 'Services',
      servicesHref: '/en/services/',
      caseStudyLabel: 'Case studies',
      ctaTitle: 'Want to talk?',
      ctaDesc: '30 minutes, free, to figure out if we can work together.',
      ctaPrimary: 'Book a discovery call',
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'About',
      pageDesc: 'Francesco Montelli, Software Engineer freelance. Filosofia, metodo e come lavoro.',
      heroSubtitle: 'Software Engineer · sistemi di prodotto',
      photoAlt: 'Francesco Montelli sul palco del DevSecOps Day',
      skillsCta: 'Competenze e stack',
      cvLabel: 'Scarica il CV',
      quote: "La IA oggi scrive codice come i robot assemblano le automobili: veloce, in larga scala, senza stancarsi. Ma nessuno affida a un robot la progettazione di una carrozzeria o il collaudo dei freni. Quella parte è ancora una questione umana.",
      whoTitle: 'Chi sono',
      whoBody: [
        "Ho iniziato a lavorare nel 2016 mentre ancora studiavo, prima come sistemista e poi come developer; il primo impiego a tempo pieno è del 2021. Ho imparato quasi tutto da solo e ho sviluppato nel tempo un'idea precisa su come il software dovrebbe essere costruito. Non un'idea sulle tecnologie: quelle cambiano. Un'idea sul metodo: cosa viene prima, cosa viene dopo, e perché l'ordine non è negoziabile.",
        "Lavoro con aziende di prodotto: a volte parto da zero, a volte da un sistema irrigidito nel tempo che ora combatte ogni modifica. Il mio obiettivo finale è rendermi inutile: il sistema non deve dipendere da me per funzionare.",
      ],
      checkLabel: 'Se vuoi verificare',
      hello: 'Disponibile anche solo per due chiacchiere.',
      links: [
        {
          href: '/about/competenze/',
          label: 'Competenze e stack',
          i: 'skills',
          desc: 'Cosa so fare, organizzato per metodo invece che come parata di loghi.',
        },
        {
          href: '/blog/',
          label: 'Il blog',
          i: 'blog',
          desc: 'Gli articoli che mi sarebbe servito trovare prima di prendere una decisione: casi reali, tradeoff sul tavolo.',
        },
        {
          href: '/talks/',
          label: 'Conferenze e speaking',
          i: 'talks',
          desc: 'Quello che scrivo sul blog lo porto anche sul palco, comprese le parti andate storte.',
        },
      ],
      linkedinCta: 'Seguimi su LinkedIn',
      workTitle: 'Il lavoro',
      workBody: 'Cosa faccio per i clienti, e con quali percorsi di formazione, sta nelle sezioni dedicate.',
      servicesLabel: 'Servizi',
      servicesHref: '/servizi/',
      caseStudyLabel: 'Case study',
      ctaTitle: 'Vogliamo parlarne?',
      ctaDesc: '30 minuti, gratuiti, per capire se possiamo lavorare insieme.',
      ctaPrimary: 'Prenota una discovery call',
      ctaSecondary: 'oppure scrivimi',
    };

const allLinks = [
  ...t.links,
  { href: t.servicesHref, label: t.servicesLabel, i: 'services', desc: t.workBody },
  { href: `${prefix}/case-study/`, label: t.caseStudyLabel, i: 'case', desc: '' },
  { href: linkedinLink, label: t.linkedinCta, i: 'chat', desc: '', ext: true, ev: 'linkedin' },
];
---

<PageLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/about.png" lang={lang}>
  <section slot="hero" class="bg-base-light">
    <div class="max-w-5xl mx-auto px-5 pt-12 pb-4 md:pt-16 grid md:grid-cols-[1.1fr_1fr] gap-8 md:gap-12 items-center">
      <div>
        <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-text-muted mb-4">{t.pageTitle}</p>
        <h1 class="text-[2.6rem] sm:text-5xl md:text-[3.5rem] font-extrabold tracking-tight leading-[1.05] text-text-dark">{author.name}</h1>
        <p class="mt-4 text-lg md:text-xl text-text-muted leading-relaxed">{t.heroSubtitle}</p>
        <p class="mt-2 text-lg text-text-dark"><strong class="text-accent font-bold">{t.hello}</strong></p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={calLink} target="_blank" rel="noopener noreferrer" data-umami-event="cta-about-hero"
            class="inline-flex items-center rounded-lg bg-accent px-5 py-3.5 font-semibold text-white hover:bg-accent-hover transition-colors">{t.ctaPrimary}</a>
          <a href={cvHref}
            class="inline-flex items-center rounded-lg border-[1.5px] border-text-dark/80 px-5 py-3.5 font-semibold text-text-dark hover:border-accent hover:text-accent transition-colors">{t.cvLabel}</a>
        </div>
      </div>
      <img src="/images/home/palco.webp" alt={t.photoAlt} width="830" height="724" loading="eager"
        class="w-full aspect-[4/3] md:aspect-[830/724] object-cover object-[70%_30%] rounded-2xl border border-border" />
    </div>
  </section>

  <blockquote class="max-w-3xl">
    <p class="text-2xl md:text-[1.9rem] leading-snug font-bold tracking-tight text-text-dark">&ldquo;{t.quote}&rdquo;</p>
  </blockquote>

  <section class="mt-14 grid md:grid-cols-[200px_1fr] gap-4 md:gap-12">
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-text-dark">{t.whoTitle}</h2>
    <div class="space-y-4 max-w-2xl">
      {t.whoBody.map((p) => (
        <p class="text-text-muted text-lg leading-relaxed">{p}</p>
      ))}
    </div>
  </section>

  <section class="mt-14 grid md:grid-cols-[200px_1fr] gap-4 md:gap-12">
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-text-dark">{t.checkLabel}</h2>
    <div class="border-t border-border">
      {allLinks.map((r) => (
        <a href={r.href} {...(r.ext ? { target: '_blank', rel: 'noopener noreferrer', 'data-umami-event': 'click-social', 'data-umami-event-platform': 'linkedin' } : {})} class="group flex items-center gap-4 py-5 border-b border-border">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[26px] w-[26px] flex-none text-accent" set:html={icons[r.i as keyof typeof icons]} aria-hidden="true"></svg>
          <span class="flex-1">
            <span class="block font-bold text-text-dark group-hover:text-accent transition-colors">{r.label}</span>
            {r.desc && <span class="block text-[15px] text-text-muted leading-snug mt-0.5">{r.desc}</span>}
          </span>
          <span class="shrink-0 text-text-muted group-hover:text-accent transition-colors" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <FinalCta
    slot="after"
    title={t.ctaTitle}
    desc={t.ctaDesc}
    umamiEvent="cta-about-final"
  />
</PageLayout>
