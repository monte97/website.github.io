---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import FinalCta from '@/components/ui/FinalCta.astro';
import { pillarStyles } from '@/data/pillar-styles';
import { pillarLabels, type Pillar } from '@/data/pillars';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

// Non tutti gli articoli hanno la versione inglese: dove manca, il link EN
// deve cadere sull'italiano invece che su un 404.
const enSlugs = new Set(
  (await getCollection('posts'))
    .filter(p => p.data.lang === 'en' && !p.data.draft)
    .map(p => p.id.replace(/\/indexen$/, ''))
);
function postHrefLang(slug: string): string {
  const clean = slug.replace(/^\/blog\//, '').replace(/\/$/, '');
  return lang === 'en' && enSlugs.has(clean) ? `/en/blog/${clean}/` : `/blog/${clean}/`;
}

type Area = {
  title: string;
  description: string;
  tags: string[];
  link?: { href: string; label: string };
};

type PillarSection = {
  pillar: Pillar;
  intro: string;
  areas: Area[];
};

const sections: PillarSection[] = lang === 'en'
  ? [
      {
        pillar: 'progettare',
        intro: 'The architectural decisions that cost the most to change later. Where I focus before any line of code is written.',
        areas: [
          {
            title: 'Event-driven architectures',
            description: 'Asynchronous systems with explicit contracts, ordering and recovery strategies.',
            tags: ['Kafka', 'RabbitMQ', 'Pekko', 'Schema Registry'],
            link: { href: postHrefLang('progettare/kafka/01-intro'), label: 'Read the Kafka series' },
          },
          {
            title: 'API design and service contracts',
            description: 'Designing the seams between services so they can evolve without breaking each other.',
            tags: ['REST', 'gRPC', 'OpenAPI', 'AsyncAPI'],
          },
          {
            title: 'Distributed systems',
            description: 'When a monolith is the right call, when microservices are not, sync vs async tradeoffs made explicit.',
            tags: ['Modular monolith', 'Microservices', 'CQRS'],
          },
          {
            title: 'Domain modeling and tradeoff-driven choices',
            description: 'Technology decisions backed by the constraints they solve, not by hype.',
            tags: ['DDD', 'Bounded contexts', 'State machines'],
            link: { href: postHrefLang('progettare/system-design/03-compilatore-state-machine'), label: 'Modeling with state machines' },
          },
          {
            title: 'Performance and scalability as design requirements',
            description: 'Treated as constraints from day one, not as fixes bolted on after the fact.',
            tags: ['Benchmarking', 'Load profiles', 'Capacity planning'],
            link: { href: postHrefLang('progettare/system-design/02-benchmark-net8'), label: '.NET 8 benchmark study' },
          },
        ],
      },
      {
        pillar: 'verificare',
        intro: "Making sure the system actually works: under load, under attack, over time. Without this, automation just makes failures faster.",
        areas: [
          {
            title: 'Observability',
            description: 'Traces, metrics and logs you can correlate. SLOs, burn-rate alerts, signal that matters.',
            tags: ['OpenTelemetry', 'Prometheus', 'Grafana', 'Tempo'],
            link: { href: postHrefLang('verificare/observability/burn-rate-alerts-slo-multi-window'), label: 'Multi-window burn-rate alerts' },
          },
          {
            title: 'End-to-end functional testing',
            description: 'Tests that exercise the system the way users do, deterministic enough to run in CI.',
            tags: ['Playwright', 'Page Object Model', 'Network mocking'],
            link: { href: postHrefLang('verificare/testing/01-guida-completa-e2e'), label: 'Complete E2E guide' },
          },
          {
            title: 'Performance testing',
            description: 'Load profiles tied to real traffic, regressions caught before users do.',
            tags: ['k6', 'Load testing', 'SLO validation'],
          },
          {
            title: 'Authentication and authorization',
            description: 'Identity and permissions designed once, enforced everywhere, including service-to-service.',
            tags: ['Keycloak', 'OpenFGA', 'OAuth 2.0', 'OIDC'],
            link: { href: postHrefLang('verificare/openfga/01-zanzibar-concetti'), label: 'Zanzibar/OpenFGA fundamentals' },
          },
          {
            title: 'Security analysis',
            description: 'Static and dynamic analysis, dependency scanning, threat modeling on the path that matters.',
            tags: ['SAST', 'DAST', 'SCA', 'Threat modeling'],
          },
          {
            title: 'Architectural consistency over time',
            description: 'Guardrails so the system you designed is still the system you have a year later.',
            tags: ['ADR', 'Fitness functions', 'Architecture tests'],
          },
        ],
      },
      {
        pillar: 'automatizzare',
        intro: 'Only after designing and verifying. Automation amplifies everything sitting above it, mistakes included.',
        areas: [
          {
            title: 'CI/CD',
            description: 'Pipelines that fail loudly on the right things, ship safely on the others.',
            tags: ['GitHub Actions', 'GitLab CI', 'Quality gates'],
            link: { href: postHrefLang('verificare/testing/03-cicd-strategie-avanzate'), label: 'Advanced CI/CD strategies' },
          },
          {
            title: 'Container orchestration',
            description: 'Kubernetes when it earns its keep, with the platform abstractions to keep developers productive.',
            tags: ['Kubernetes', 'Cluster API', 'Helm'],
            link: { href: postHrefLang('progettare/kubernetes/01-capi-part1-intro'), label: 'Cluster API series' },
          },
          {
            title: 'Infrastructure as Code',
            description: 'Reviewable, reproducible infrastructure, including the recovery path.',
            tags: ['Terraform', 'OpenTofu', 'Ansible'],
          },
          {
            title: 'GitOps',
            description: 'Git as the source of truth for deployment state, drift caught automatically.',
            tags: ['Argo CD', 'Flux', 'Kustomize'],
          },
        ],
      },
    ]
  : [
      {
        pillar: 'progettare',
        intro: 'Le decisioni architetturali più costose da cambiare in corsa. Dove concentro l\'attenzione prima di scrivere codice.',
        areas: [
          {
            title: 'Architetture event-driven',
            description: 'Sistemi asincroni con contratti espliciti, gestione dell\'ordine e strategie di recovery.',
            tags: ['Kafka', 'RabbitMQ', 'Pekko', 'Schema Registry'],
            link: { href: postHrefLang('progettare/kafka/01-intro'), label: 'Leggi la serie su Kafka' },
          },
          {
            title: 'API design e contratti tra servizi',
            description: 'Progettare le interfacce tra servizi perché possano evolvere senza rompersi a vicenda.',
            tags: ['REST', 'gRPC', 'OpenAPI', 'AsyncAPI'],
          },
          {
            title: 'Sistemi distribuiti',
            description: 'Quando un monolite è la scelta giusta, quando i microservizi non lo sono, sincrono vs async con i tradeoff sul tavolo.',
            tags: ['Monolite modulare', 'Microservizi', 'CQRS'],
          },
          {
            title: 'Domain modeling e scelte tecnologiche con tradeoff espliciti',
            description: 'Decisioni tecnologiche giustificate dai vincoli che risolvono, non dall\'hype del momento.',
            tags: ['DDD', 'Bounded context', 'State machine'],
            link: { href: postHrefLang('progettare/system-design/03-compilatore-state-machine'), label: 'Modellare con macchine a stati' },
          },
          {
            title: 'Performance e scalabilità come requisiti di design',
            description: 'Trattate come vincoli dal giorno uno, non come ottimizzazioni a posteriori.',
            tags: ['Benchmarking', 'Profili di carico', 'Capacity planning'],
            link: { href: postHrefLang('progettare/system-design/02-benchmark-net8'), label: 'Benchmark .NET 8' },
          },
        ],
      },
      {
        pillar: 'verificare',
        intro: 'Sapere che il sistema funziona davvero: sotto carico, sotto attacco, nel tempo. Senza questo, l\'automazione amplifica solo i guasti.',
        areas: [
          {
            title: 'Observability',
            description: 'Trace, metriche e log correlabili. SLO, burn-rate alert, segnali che contano davvero.',
            tags: ['OpenTelemetry', 'Prometheus', 'Grafana', 'Tempo'],
            link: { href: postHrefLang('verificare/observability/burn-rate-alerts-slo-multi-window'), label: 'Burn-rate alert multi-window' },
          },
          {
            title: 'Testing funzionale end-to-end',
            description: 'Test che esercitano il sistema come gli utenti reali, abbastanza deterministici da girare in CI.',
            tags: ['Playwright', 'Page Object Model', 'Network mocking'],
            link: { href: postHrefLang('verificare/testing/01-guida-completa-e2e'), label: 'Guida completa al testing E2E' },
          },
          {
            title: 'Performance testing',
            description: 'Profili di carico legati al traffico reale, regressioni intercettate prima degli utenti.',
            tags: ['k6', 'Load testing', 'Validazione SLO'],
          },
          {
            title: 'Autenticazione e autorizzazione',
            description: 'Identità e permessi progettati una volta, applicati ovunque, service-to-service incluso.',
            tags: ['Keycloak', 'OpenFGA', 'OAuth 2.0', 'OIDC'],
            link: { href: postHrefLang('verificare/openfga/01-zanzibar-concetti'), label: 'Concetti di Zanzibar/OpenFGA' },
          },
          {
            title: 'Security analysis',
            description: 'Analisi statica e dinamica, dependency scanning, threat modeling sui flussi che contano.',
            tags: ['SAST', 'DAST', 'SCA', 'Threat modeling'],
          },
          {
            title: 'Coerenza architetturale nel tempo',
            description: 'Guardrail perché il sistema progettato sia ancora il sistema che hai un anno dopo.',
            tags: ['ADR', 'Fitness function', 'Test architetturali'],
          },
        ],
      },
      {
        pillar: 'automatizzare',
        intro: 'Solo dopo aver progettato e verificato. L\'automazione amplifica tutto quello che le sta sopra, errori compresi.',
        areas: [
          {
            title: 'CI/CD',
            description: 'Pipeline che falliscono rumorosamente sulle cose giuste, rilasciano in sicurezza sulle altre.',
            tags: ['GitHub Actions', 'GitLab CI', 'Quality gate'],
            link: { href: postHrefLang('verificare/testing/03-cicd-strategie-avanzate'), label: 'Strategie CI/CD avanzate' },
          },
          {
            title: 'Container orchestration',
            description: 'Kubernetes quando ne vale il costo, con le astrazioni di piattaforma per non bruciare i developer.',
            tags: ['Kubernetes', 'Cluster API', 'Helm'],
            link: { href: postHrefLang('progettare/kubernetes/01-capi-part1-intro'), label: 'Serie Cluster API' },
          },
          {
            title: 'Infrastructure as Code',
            description: 'Infrastruttura riproducibile e revisionabile, con il percorso di recovery incluso.',
            tags: ['Terraform', 'OpenTofu', 'Ansible'],
          },
          {
            title: 'GitOps',
            description: 'Git come fonte di verità dello stato di deploy, drift intercettato automaticamente.',
            tags: ['Argo CD', 'Flux', 'Kustomize'],
          },
        ],
      },
    ];

const t = lang === 'en'
  ? {
      pageTitle: 'Skills',
      pageDesc: 'Technical skills organized around the three pillars of the method: design, verify, automate. Technologies as secondary tags, real cases in the blog.',
      heroTitle: 'Skills and stack',
      heroSubtitle: 'Organized by method, not by logo wall.',
      intro: "What I actually do, grouped around the three pillars of the method. Technologies are secondary tags. Where a blog article makes the competence concrete, the link sits right next to it.",
      readMore: 'Read more',
      ctaTitle: 'Want to put this to work?',
      ctaDesc: "If something here matches what you're facing, the fastest way forward is a 30-minute discovery call.",
      ctaPrimary: 'Book a discovery call',
      ctaSecondary: 'See services',
    }
  : {
      pageTitle: 'Competenze',
      pageDesc: 'Le competenze tecniche organizzate per i tre pilastri del metodo: progettare, verificare, automatizzare. Tecnologie come tag secondari, casi reali nel blog.',
      heroTitle: 'Competenze e stack',
      heroSubtitle: 'Organizzate per metodo, non come parata di loghi.',
      intro: 'Quello che faccio davvero, raccolto attorno ai tre pilastri del metodo. Le tecnologie restano tag secondari. Dove un articolo del blog rende concreta la competenza, il link è lì accanto.',
      readMore: 'Approfondisci',
      ctaTitle: 'Vuoi metterlo in pratica?',
      ctaDesc: 'Se qualcosa qui sopra corrisponde a quello che stai affrontando, il modo più rapido per partire è una discovery call di 30 minuti.',
      ctaPrimary: 'Prenota una discovery call',
      ctaSecondary: 'Vedi i servizi',
    };
---

<PageLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/competenze.png" lang={lang}>
  <PageHero
    slot="hero"
    variant="index"
    eyebrow={t.pageTitle}
    title={t.heroTitle}
    subtitle={t.intro}
    note={t.heroSubtitle}
  />

  {sections.map((section) => {
    const styles = pillarStyles[section.pillar];
    const label = pillarLabels[section.pillar][lang];
    return (
      <section class="mb-20 fade-in-section">
        <div class="mb-8">
          <div class="flex items-baseline gap-3 mb-2">
            <span class={`text-2xl font-mono font-bold ${styles.text}`}>{styles.num}</span>
            <h2 class="text-2xl font-bold text-text-dark dark:text-text-light">{label}</h2>
            <span class="text-sm text-text-muted ml-auto tabular-nums">
              {section.areas.length} {lang === 'en' ? 'areas' : 'aree'}
            </span>
          </div>
          <div class={`h-0.5 w-full ${styles.bg} opacity-40 mb-3`} />
          <p class="text-text-muted max-w-2xl">{section.intro}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 stagger-children">
          {section.areas.map((area) => (
            <div class={`surface-card border-l-[3px] ${styles.borderLeft} p-6 h-full flex flex-col`}>
              <h3 class="font-semibold text-base text-text-dark dark:text-text-light mb-2">
                {area.title}
              </h3>
              <p class="text-text-muted text-sm leading-relaxed mb-4 grow">
                {area.description}
              </p>
              <div class="flex flex-wrap gap-1.5 mb-3">
                {area.tags.map((tag) => (
                  <span class={`text-[11px] px-2 py-0.5 rounded-full font-medium ${styles.badge}`}>
                    {tag}
                  </span>
                ))}
              </div>
              {area.link && (
                <a
                  href={area.link.href}
                  class={`text-sm font-medium ${styles.text} hover:underline inline-flex items-center gap-1`}
                >
                  {t.readMore}: {area.link.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          ))}
        </div>
      </section>
    );
  })}

  <FinalCta
    slot="after"
    title={t.ctaTitle}
    desc={t.ctaDesc}
    ctaLabel={t.ctaPrimary}
    ctaHref="https://cal.com/francesco-montelli-4hfojq/30min"
    secondaryLabel={t.ctaSecondary}
    secondaryHref={lang === 'en' ? '/en/services/' : '/servizi/'}
    umamiEvent="cta-competenze-final"
    fullBleed
  />
</PageLayout>
