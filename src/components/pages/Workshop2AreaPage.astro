---
/**
 * Pagina di un'area di formazione.
 *
 * Struttura ripresa dalla landing di serie del blog: fascia di pilastro in cima,
 * hero con scheda dei numeri, corpo a due colonne con sidebar appiccicata.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { pillarStyles } from '@/data/pillar-styles';
import { pillarLabels } from '@/data/pillars';
import { author } from '@/data/author';
import type { WorkshopArea } from '@/data/workshop-areas';
import { getAreaMaterial } from '@/utils/workshop';

interface Props {
  area: WorkshopArea;
  lang?: 'it' | 'en';
}

const { area, lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';
const mailLink = 'mailto:francesco@montelli.dev';

const t = lang === 'en'
  ? {
      home: 'Home',
      section: 'Training',
      badge: 'Training area',
      audienceTitle: 'Who it is for',
      formatLabel: 'Format',
      worksOnTitle: 'What the work is done on',
      takeawayTitle: 'What the team keeps',
      requirementsTitle: 'What is needed on your side',
      materialTitle: 'Published material',
      materialIntro: 'What already exists on this topic, readable before any conversation.',
      seriesLandingLabel: 'Series landing page',
      talksTitle: 'Talks',
      catalogTitle: 'The full catalogue',
      catalogDesc: 'What the path contains: the system worked on, the two formats, the measured costs of the stack.',
      catalogLabel: 'Read the catalogue',
      catalogPdfLabel: 'Download the PDF',
      statPosts: 'Published articles',
      statMinutes: 'Minutes of reading',
      statPillar: 'Pillar',
      ctaEyebrow: 'Discovery call',
      ctaTitle: 'Shall we talk about the path for your team?',
      ctaDesc: 'Tell me where the team is now and what it has to be able to do at the end. We define scope and format together.',
      ctaPrimary: 'Book a call',
      ctaSecondary: 'Write me directly',
      authorRole: 'Freelance Software Engineer',
      locale: 'en-GB',
      min: 'min',
    }
  : {
      home: 'Home',
      section: 'Formazione',
      badge: 'Area di formazione',
      audienceTitle: 'A chi è rivolta',
      formatLabel: 'Formato',
      worksOnTitle: 'Su cosa si lavora',
      takeawayTitle: 'Cosa resta al team',
      requirementsTitle: 'Cosa serve dalla vostra parte',
      materialTitle: 'Materiale pubblicato',
      materialIntro: 'Quello che esiste già su questo tema, leggibile prima di qualsiasi conversazione.',
      seriesLandingLabel: 'Landing della serie',
      talksTitle: 'Talk',
      catalogTitle: 'Il catalogo completo',
      catalogDesc: 'Cosa contiene il percorso: il sistema su cui si lavora, i due formati, i costi misurati dello stack.',
      catalogLabel: 'Leggi il catalogo',
      catalogPdfLabel: 'Scarica il PDF',
      statPosts: 'Articoli pubblicati',
      statMinutes: 'Minuti di lettura',
      statPillar: 'Pilastro',
      ctaEyebrow: 'Discovery call',
      ctaTitle: 'Parliamo del percorso per il tuo team?',
      ctaDesc: 'Raccontami dove sta il team ora e cosa deve saper fare alla fine. Definiamo insieme scope e formato.',
      ctaPrimary: 'Prenota una call',
      ctaSecondary: 'Scrivimi direttamente',
      authorRole: 'Software Engineer freelance',
      locale: 'it-IT',
      min: 'min',
    };

const { material, talks, postCount, readingTime } = await getAreaMaterial(area, lang);
const detail = area.detail;
const styles = pillarStyles[area.pillar];
const pillarLabel = pillarLabels[area.pillar][lang];
const groups = material.filter((g) => g.posts.length > 0);

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString(t.locale, { year: 'numeric', month: 'long' });

// Numerazione continua sull'intero elenco, come nella landing di serie.
let n = 0;
const numbered = groups.map((g) => ({
  ...g,
  posts: g.posts.map((post) => ({ ...post, num: String(++n).padStart(2, '0') })),
}));
---

<BaseLayout
  title={area.title[lang]}
  description={area.problem[lang]}
  ogImage="/og/workshop.png"
  lang={lang}
>
  <Header lang={lang} />

  <main>
    <!-- ── Hero ── -->
    <section class="relative overflow-hidden border-b border-border dark:border-border-dark">
      <div class={`absolute top-0 left-0 right-0 h-1 ${styles.bg}`} />

      <div class="max-w-5xl mx-auto px-5 pt-16 pb-12">
        <nav class="flex items-center gap-2 text-sm text-text-muted mb-8" aria-label="Breadcrumb">
          <a href={`${prefix}/`} class="hover:text-accent transition-colors">{t.home}</a>
          <span>/</span>
          <a href={`${prefix}/workshop2/`} class="hover:text-accent transition-colors">{t.section}</a>
          <span>/</span>
          <span class="text-text-dark dark:text-text-light font-medium">{area.title[lang]}</span>
        </nav>

        <div class="grid lg:grid-cols-[1fr_auto] gap-8 items-start">
          <div>
            <span class={`inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4 ${styles.badge}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${styles.bg}`} />
              {t.badge} &middot; {pillarLabel}
            </span>

            <h1 class="text-3xl sm:text-4xl font-bold text-text-dark dark:text-text-light leading-tight mb-4">
              {area.title[lang]}
            </h1>
            <p class="text-text-muted text-lg leading-relaxed max-w-2xl">{area.problem[lang]}</p>
            {detail?.format && (
              <p class="mt-5 text-sm text-text-muted">
                <span class="font-semibold text-text-dark dark:text-text-light">{t.formatLabel}:</span>{' '}
                {detail.format[lang]}
              </p>
            )}
          </div>

          <!-- Scheda dei numeri: solo cose contate, niente dichiarazioni -->
          <div class="lg:min-w-[200px] rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-5 space-y-4">
            <div>
              <div class="text-2xl font-bold text-text-dark dark:text-text-light">{postCount}</div>
              <div class="text-xs text-text-muted uppercase tracking-wide">{t.statPosts}</div>
            </div>
            <div class="border-t border-border dark:border-border-dark" />
            <div>
              <div class="text-2xl font-bold text-text-dark dark:text-text-light">{readingTime}</div>
              <div class="text-xs text-text-muted uppercase tracking-wide">{t.statMinutes}</div>
            </div>
            <div class="border-t border-border dark:border-border-dark" />
            <div>
              <div class={`text-sm font-semibold ${styles.text}`}>{pillarLabel}</div>
              <div class="text-xs text-text-muted uppercase tracking-wide">{t.statPillar}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-5 py-12 grid lg:grid-cols-[1fr_320px] gap-12 items-start">

      <!-- ── Colonna principale ── -->
      <div>
        <section class="mb-12 max-w-2xl">
          <h2 class="text-xl font-bold text-text-dark dark:text-text-light mb-4">{t.audienceTitle}</h2>
          <p class="text-text-muted leading-relaxed">{area.audience[lang]}</p>
        </section>

        {detail?.worksOn && (
          <section class="mb-12 max-w-2xl">
            <h2 class="text-xl font-bold text-text-dark dark:text-text-light mb-4">{t.worksOnTitle}</h2>
            <p class="text-text-muted leading-relaxed">{detail.worksOn[lang]}</p>
          </section>
        )}

        {detail?.takeaway && detail.takeaway.length > 0 && (
          <section class="mb-12">
            <h2 class="text-xl font-bold text-text-dark dark:text-text-light mb-5">{t.takeawayTitle}</h2>
            <ul class="space-y-3">
              {detail.takeaway.map((item) => (
                <li class="flex items-start gap-3">
                  <span class={`mt-1 flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold text-white ${styles.bg}`}>
                    ✓
                  </span>
                  <span class="text-text-muted leading-relaxed">
                    <span class="font-semibold text-text-dark dark:text-text-light">{item.title[lang]}.</span>{' '}
                    {item.desc[lang]}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {detail?.requirements && (
          <section class="mb-12 max-w-2xl">
            <h2 class="text-xl font-bold text-text-dark dark:text-text-light mb-4">{t.requirementsTitle}</h2>
            <p class="text-text-muted leading-relaxed">{detail.requirements[lang]}</p>
          </section>
        )}

        {numbered.length > 0 && (
          <section class="mb-12">
            <h2 class="text-xl font-bold text-text-dark dark:text-text-light mb-2">{t.materialTitle}</h2>
            <p class="text-sm text-text-muted mb-6">{t.materialIntro}</p>

            <div class="space-y-8">
              {numbered.map((g) => (
                <div>
                  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
                    <h3 class="text-base font-semibold text-text-dark dark:text-text-light">
                      {g.group.title[lang]}
                    </h3>
                    {g.group.href && lang === 'it' && (
                      <a href={g.group.href} class="text-sm text-accent hover:underline underline-offset-4">
                        {t.seriesLandingLabel} &rarr;
                      </a>
                    )}
                  </div>

                  <ol class="space-y-4">
                    {g.posts.map((post) => (
                      <li>
                        <a
                          href={post.href}
                          class="group flex gap-4 p-5 rounded-xl border border-border dark:border-border-dark hover:border-accent/40 dark:hover:border-accent/40 bg-surface dark:bg-surface-dark hover:bg-accent/5 transition-all"
                        >
                          <div class={`flex-shrink-0 w-9 h-9 rounded-lg flex items-center justify-center text-sm font-bold text-white ${styles.bg}`}>
                            {post.num}
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-2 mb-1">
                              <span class="text-base font-semibold text-text-dark dark:text-text-light leading-snug">
                                {post.title}
                              </span>
                              <span class="flex-shrink-0 text-xs text-text-muted mt-0.5">
                                {post.readingTime} {t.min}
                              </span>
                            </div>
                            <p class="text-sm text-text-muted leading-relaxed line-clamp-2">{post.description}</p>
                          </div>
                          <div class="flex-shrink-0 self-center text-text-muted group-hover:text-accent transition-colors">
                            &rarr;
                          </div>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              ))}

              {talks.length > 0 && (
                <div>
                  <h3 class="text-base font-semibold text-text-dark dark:text-text-light mb-4">{t.talksTitle}</h3>
                  <ul class="space-y-4">
                    {talks.map((talk) => (
                      <li>
                        <a
                          href={`${prefix}/talks/${talk.slug}/`}
                          class="group flex gap-4 p-5 rounded-xl border border-border dark:border-border-dark hover:border-accent/40 dark:hover:border-accent/40 bg-surface dark:bg-surface-dark hover:bg-accent/5 transition-all"
                        >
                          <div class="flex-shrink-0 w-9 h-9 rounded-lg flex items-center justify-center border border-accent/30 text-accent">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 0 0 3-3V6a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3Zm6-3a6 6 0 0 1-12 0m6 6v3" />
                            </svg>
                          </div>
                          <div class="flex-1 min-w-0">
                            <span class="block text-base font-semibold text-text-dark dark:text-text-light leading-snug mb-1">
                              {talk.title}
                            </span>
                            <p class="text-sm text-text-muted">
                              {talk.event} &middot; {fmtDate(talk.date)} &middot; {talk.location}
                            </p>
                          </div>
                          <div class="flex-shrink-0 self-center text-text-muted group-hover:text-accent transition-colors">
                            &rarr;
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )}
      </div>

      <!-- ── Sidebar ── -->
      <aside class="space-y-6 lg:sticky lg:top-6">

        {/* Catalogo: compare quando esiste. Il PDF e' un'aggiunta, non un requisito. */}
        {area.catalog && lang === 'it' && (
          <div class="rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-6">
            <div class="text-xs font-semibold uppercase tracking-widest mb-3 text-text-muted">
              {t.catalogTitle}
            </div>
            <p class="text-sm text-text-muted leading-relaxed mb-5">{t.catalogDesc}</p>
            <a
              href={area.catalog.href}
              class="block w-full text-center px-4 py-2.5 rounded-lg border border-accent text-accent text-sm font-semibold hover:bg-accent hover:text-white transition-colors"
            >
              {t.catalogLabel} &rarr;
            </a>
            {area.catalog.pdf && (
              <a
                href={area.catalog.pdf}
                class="block w-full text-center mt-2 text-sm text-text-muted hover:text-accent transition-colors underline underline-offset-4"
              >
                {t.catalogPdfLabel}
              </a>
            )}
          </div>
        )}

        <div class={`rounded-xl border-2 ${styles.border} p-6`}>
          <div class={`text-xs font-semibold uppercase tracking-widest mb-3 ${styles.text}`}>
            {t.ctaEyebrow}
          </div>
          <h3 class="text-lg font-bold text-text-dark dark:text-text-light mb-3 leading-snug">
            {t.ctaTitle}
          </h3>
          <p class="text-sm text-text-muted leading-relaxed mb-5">{t.ctaDesc}</p>
          <a
            href={calLink}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="cta-workshop2-area"
            class={`block w-full text-center px-4 py-2.5 rounded-lg text-white text-sm font-semibold transition-opacity hover:opacity-90 ${styles.bg}`}
          >
            {t.ctaPrimary} &rarr;
          </a>
          <a
            href={mailLink}
            class="block w-full text-center mt-2 px-4 py-2.5 rounded-lg text-sm font-medium text-text-muted hover:text-accent transition-colors bg-text-muted/10 hover:bg-text-muted/15"
          >
            {t.ctaSecondary}
          </a>
        </div>

        <div class="rounded-xl border border-border dark:border-border-dark p-5">
          <div class="flex items-center gap-3 mb-3">
            <img
              src={author.image}
              alt={author.name}
              width="40"
              height="40"
              class="w-10 h-10 rounded-full object-cover"
            />
            <div>
              <div class="text-sm font-semibold text-text-dark dark:text-text-light">{author.name}</div>
              <div class="text-xs text-text-muted">{t.authorRole}</div>
            </div>
          </div>
          <p class="text-sm text-text-muted leading-relaxed">{author.bio[lang]}</p>
        </div>

      </aside>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
