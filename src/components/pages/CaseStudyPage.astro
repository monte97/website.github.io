---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FinalCta from '@/components/ui/FinalCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CaseStudyFilterable from '@/components/case-study/CaseStudyFilterable.vue';
import { pillarStyles } from '@/data/pillar-styles';
import { pillarLabels } from '@/data/pillars';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const allProjects = await getCollection('projects');
const caseStudies = allProjects
  .filter((p) => p.data.type === 'case-study' && !p.data.hold)
  .sort((a, b) => a.data.weight - b.data.weight);

const mailLink = 'mailto:francesco@montelli.dev';

const serialized = caseStudies.map((cs) => ({
  id: cs.id,
  title: cs.data.title,
  description: cs.data.description,
  eyebrow: cs.data.eyebrow,
  pillar: cs.data.pillar,
  tags: cs.data.tags,
  problem: cs.data.problem,
  result: Array.isArray(cs.data.result) ? cs.data.result[0] : cs.data.result,
  href: `${prefix}/case-study/${cs.id}/`,
}));

const t = lang === 'en'
  ? {
      pageTitle: 'Case Studies',
      pageDesc: 'Technical analyses of real projects on systems already in production: the starting constraint, the decisions taken, and where the work stopped.',
      eyebrow: 'Case studies',
      heroTitle: 'What was decided, and why',
      heroSubtitle: 'Analyses of real projects on systems that already had people working inside them. Client names are omitted; the decisions are not.',
      intro: 'Each piece starts from the constraint that created the work, walks through the choices one by one — including the rejected ones and the reason — and says what the client was left with. If you are looking at a similar problem, what transfers is the reasoning: the technologies change from one project to the next.',
      readLabel: 'Read the analysis',
      emptyTitle: 'Nothing published yet',
      emptyDesc: 'The first analyses are being written.',
      ctaTitle: 'Holding a similar situation?',
      ctaDesc: 'Tell me how the system looks today and which decision you are stuck on. Half an hour to see whether there is a problem I can be useful on, no commitment.',
      ctaPrimary: 'Book a discovery call',
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'Case Study',
      pageDesc: 'Analisi tecniche di progetti reali su sistemi in esercizio: il vincolo di partenza, le decisioni prese, e il punto in cui il lavoro si è fermato.',
      eyebrow: 'Case study',
      heroTitle: 'Cosa è stato deciso, e perché',
      heroSubtitle: 'Analisi di progetti reali su sistemi che avevano già gente dentro. I nomi dei committenti sono omessi, le decisioni no.',
      intro: 'Ogni pezzo parte dal vincolo che ha generato il lavoro, ripercorre le scelte una per una — comprese quelle scartate e il motivo — e dice cosa è rimasto in mano a chi ha pagato. Se stai guardando un problema simile, quello che si trasferisce sono i motivi: le tecnologie cambiano da un progetto all’altro.',
      readLabel: 'Leggi l’analisi',
      emptyTitle: 'Ancora niente di pubblicato',
      emptyDesc: 'Le prime analisi sono in scrittura.',
      ctaTitle: 'Hai in mano una situazione simile?',
      ctaDesc: 'Raccontami com’è fatto il sistema adesso e qual è la decisione che siete fermi a prendere. Mezz’ora per capire se c’è un problema su cui posso essere utile, senza impegno.',
      ctaPrimary: 'Prenota una discovery call',
      ctaSecondary: 'oppure scrivimi',
    };
---

<BaseLayout title={t.pageTitle} description={t.pageDesc} lang={lang}>
  <Header lang={lang} />
  <main>

    <PageHero title={t.heroTitle} subtitle={t.heroSubtitle} eyebrow={t.eyebrow} align="center" />

    {/* ELENCO */}
    <section>
      <div class="max-w-5xl mx-auto px-5 pt-12 md:pt-16 pb-16 md:pb-20">
        <p class="text-text-muted text-base md:text-lg leading-relaxed max-w-3xl mx-auto text-center mb-10 md:mb-12">{t.intro}</p>

        {caseStudies.length === 0 ? (
          <div class="max-w-xl mx-auto text-center rounded-2xl border border-dashed border-border/60 dark:border-border-dark/60 p-10">
            <h2 class="text-lg font-bold text-text-dark dark:text-text-light mb-2">{t.emptyTitle}</h2>
            <p class="text-text-muted text-sm">{t.emptyDesc}</p>
          </div>
        ) : (
          <CaseStudyFilterable client:load items={serialized} lang={lang} />
        )}
      </div>
    </section>

    <FinalCta title={t.ctaTitle} desc={t.ctaDesc} ctaLabel={t.ctaPrimary} secondaryLabel={t.ctaSecondary} secondaryHref={mailLink} umamiEvent="cta-case-study-final" fullBleed />

  </main>
  <Footer lang={lang} />
</BaseLayout>
