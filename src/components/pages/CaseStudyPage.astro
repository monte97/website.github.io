---
/**
 * Indice dei case study.
 *
 * Grammatica visiva allineata all'indice del blog: righe con bordo sottile e
 * nessuna ombra, pilastro come etichetta mono invece che pastiglia, e occhiello
 * promosso a prima riga, perche' e' il campo con cui il lettore riconosce la
 * propria situazione. L'introduzione sta nell'hero invece che sospesa in mezzo.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FinalCta from '@/components/ui/FinalCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { pillarLabels } from '@/data/pillars';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const caseStudies = (await getCollection('projects'))
  .filter((p) => p.data.type === 'case-study' && !p.data.hold)
  .sort((a, b) => a.data.weight - b.data.weight);

const mailLink = 'mailto:francesco@montelli.dev';
const mono = 'label-mono';
const hair = 'border-border/70 dark:border-border-dark/70';

const t = lang === 'en'
  ? {
      pageTitle: 'Case Studies',
      pageDesc: 'Technical analyses of real projects on systems already in production: the starting constraint, the decisions taken, and where the work stopped.',
      eyebrow: 'Case studies',
      heroTitle: 'What was decided, and why',
      intro: (n: number) =>
        `${n} analyses of real projects on systems that already had people working inside them. Each piece starts from the constraint that created the work, walks through the choices one by one including the rejected ones, and says what the client was left with.`,
      note: 'Client names are omitted, the decisions are not',
      emptyTitle: 'Nothing published yet',
      emptyDesc: 'The first analyses are being written.',
      readLabel: 'Read the analysis',
      constraint: 'The constraint',
      outcome: 'The outcome',
      ctaTitle: 'Holding a similar situation?',
      ctaDesc: 'Tell me how the system looks today and which decision you are stuck on. Half an hour to see whether there is a problem I can be useful on, no commitment.',
      ctaPrimary: 'Book a discovery call',
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'Case Study',
      pageDesc: 'Analisi tecniche di progetti reali su sistemi in esercizio: il vincolo di partenza, le decisioni prese, e il punto in cui il lavoro si è fermato.',
      eyebrow: 'Case study',
      heroTitle: 'Cosa è stato deciso, e perché',
      intro: (n: number) =>
        `${n} analisi di progetti reali su sistemi che avevano già gente dentro. Ogni pezzo parte dal vincolo che ha generato il lavoro, ripercorre le scelte una per una comprese quelle scartate, e dice cosa è rimasto in mano a chi ha pagato.`,
      note: 'I nomi dei committenti sono omessi, le decisioni no',
      emptyTitle: 'Ancora niente di pubblicato',
      emptyDesc: 'Le prime analisi sono in scrittura.',
      readLabel: 'Leggi l’analisi',
      constraint: 'Il vincolo',
      outcome: 'L’esito',
      ctaTitle: 'Hai in mano una situazione simile?',
      ctaDesc: 'Raccontami com’è fatto il sistema adesso e qual è la decisione che siete fermi a prendere. Mezz’ora per capire se c’è un problema su cui posso essere utile, senza impegno.',
      ctaPrimary: 'Prenota una discovery call',
      ctaSecondary: 'oppure scrivimi',
    };
---

<BaseLayout title={t.pageTitle} description={t.pageDesc} lang={lang}>
  <Header lang={lang} />
  <main>

    <PageHero
      variant="index"
      eyebrow={t.eyebrow}
      title={t.heroTitle}
      subtitle={t.intro(caseStudies.length)}
      note={t.note}
    />

    <div class="max-w-5xl mx-auto px-5 py-12 md:py-16">
      {caseStudies.length === 0 ? (
        <div class={`max-w-xl mx-auto text-center rounded-xl border border-dashed ${hair} p-10`}>
          <h2 class="text-lg font-bold text-text-dark dark:text-text-light mb-2">{t.emptyTitle}</h2>
          <p class="text-text-muted text-sm">{t.emptyDesc}</p>
        </div>
      ) : (
        <div class="space-y-4">
          {caseStudies.map((cs) => (
            <a
              href={`${prefix}/case-study/${cs.id}/`}
              class="group surface-link block p-6 md:p-7"
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-3">
                {cs.data.eyebrow && (
                  <p class="label-mono !text-accent">{cs.data.eyebrow}</p>
                )}
                <p class={mono}>{pillarLabels[cs.data.pillar][lang]}</p>
              </div>

              <h2 class="text-xl md:text-2xl font-bold text-text-dark dark:text-text-light leading-snug text-balance group-hover:text-accent transition-colors">
                {cs.data.title}
              </h2>
              <p class="mt-3 text-text-muted leading-relaxed max-w-2xl">{cs.data.description}</p>

              {(cs.data.problem || cs.data.esito) && (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 mt-5">
                  {cs.data.problem && (
                    <div class={`border-l-2 ${hair} pl-4`}>
                      <p class={`${mono} mb-1.5`}>{t.constraint}</p>
                      <p class="text-sm text-text-muted leading-relaxed">{cs.data.problem}</p>
                    </div>
                  )}
                  {cs.data.esito && (
                    <div class="border-l-2 border-accent pl-4">
                      <p class="label-mono !text-accent mb-1.5">{t.outcome}</p>
                      <p class="text-sm text-text-muted leading-relaxed">{cs.data.esito}</p>
                    </div>
                  )}
                </div>
              )}

              <div class={`mt-5 pt-4 border-t ${hair} flex flex-wrap items-center gap-x-4 gap-y-2`}>
                <div class="flex flex-wrap gap-1.5">
                  {cs.data.tags.slice(0, 5).map((tg) => (
                    <span class="text-[11px] text-text-muted/80 bg-text-muted/8 px-1.5 py-0.5 rounded">{tg}</span>
                  ))}
                </div>
                <span class="ml-auto text-sm font-semibold text-accent">{t.readLabel} &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>

    <FinalCta
      title={t.ctaTitle}
      desc={t.ctaDesc}
      ctaLabel={t.ctaPrimary}
      secondaryLabel={t.ctaSecondary}
      secondaryHref={mailLink}
      umamiEvent="cta-case-study-final"
      fullBleed
    />
  </main>
  <Footer lang={lang} />
</BaseLayout>
