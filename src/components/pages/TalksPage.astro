---
import PageLayout from '@/layouts/PageLayout.astro';
import { talks } from '@/data/talks';
import { talkImagesFrom } from '@/utils/talks';
import FinalCta from '@/components/ui/FinalCta.astro';
import PageHero from '@/components/ui/PageHero.astro';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const mailLink = 'mailto:francesco@montelli.dev';

// Foto talk: glob eager su src/assets/talks/<slug>/*, risolto per slug tramite talkImagesFrom.
// import.meta.glob deve stare nel file consumante (static analysis di Vite).
const allTalkImages = import.meta.glob<{ default: { src: string } }>(
  '/src/assets/talks/*/*.{webp,jpg,jpeg,png}',
  { eager: true },
);
const coverFor = (slug: string): string | null => talkImagesFrom(allTalkImages, slug)[0] ?? null;

const upcoming = talks
  .filter((tk) => tk.status === 'upcoming')
  .sort((a, b) => a.date.localeCompare(b.date));
const past = talks
  .filter((tk) => tk.status === 'delivered')
  .sort((a, b) => b.date.localeCompare(a.date));

const locale = lang === 'en' ? 'en-US' : 'it-IT';
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString(locale, { year: 'numeric', month: 'long' });

const mono = 'label-mono';
const hair = 'border-border/70 dark:border-border-dark/70';

const t = lang === 'en'
  ? {
      pageTitle: 'Talks',
      pageDesc: 'Conferences and talks by Francesco Montelli: slides, material and recordings.',
      eyebrow: 'Speaking',
      heroTitle: 'Conferences & speaking',
      intro: 'Every talk comes out of a real project. Slides, material and recordings are here; if a topic fits your event or your team, we can adapt it.',
      note: 'The same topics I work on every day, including the parts that went wrong',
      upcomingTitle: 'Upcoming',
      pastTitle: 'Past talks',
      ctaTitle: 'Looking for a speaker on these topics?',
      ctaDesc: 'Tell me about the event, the audience and the slot. We\'ll work out the angle together.',
      ctaPrimary: 'Book a call',
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'Talks',
      pageDesc: 'Conferenze e talk di Francesco Montelli: slide, materiale e registrazioni.',
      eyebrow: 'Speaking',
      heroTitle: 'Conferenze e speaking',
      intro: 'Ogni talk nasce da un progetto vero. Qui trovi slide, materiale e registrazioni; se un tema è adatto al tuo evento o al tuo team, si adatta.',
      note: 'Gli stessi temi su cui lavoro tutti i giorni, comprese le parti andate storte',
      upcomingTitle: 'Prossimi',
      pastTitle: 'Talk passati',
      ctaTitle: 'Cerchi uno speaker su questi temi?',
      ctaDesc: 'Raccontami evento, pubblico e durata dello slot. L\'angolo lo troviamo insieme.',
      ctaPrimary: 'Prenota una call',
      ctaSecondary: 'oppure scrivimi',
    };
---

<PageLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/talks.png" lang={lang}>
  <PageHero
    slot="hero"
    variant="index"
    eyebrow={t.eyebrow}
    title={t.heroTitle}
    subtitle={t.intro}
    note={t.note}
  />

  {upcoming.length > 0 && (
    <section class="mb-16 fade-in-section">
      <h2 class="label-mono !text-accent mb-4">{t.upcomingTitle}</h2>
      <div class="space-y-4">
        {upcoming.map((talk) => {
          const img = coverFor(talk.slug);
          return (
            <a href={`${prefix}/talks/${talk.slug}/`} class="group rounded-xl border border-accent/40 bg-accent/5 overflow-hidden hover:border-accent transition-all md:flex">
              {img && (
                <img src={img} alt={talk.title} class="w-full h-48 md:h-56 md:w-64 object-cover shrink-0" loading="lazy" />
              )}
              <div class="p-6 flex-1">
                <p class="label-mono !text-accent">{talk.event} &middot; {fmtDate(talk.date)} &middot; {talk.location}</p>
                <h3 class="text-xl font-bold text-text-dark dark:text-text-light mt-1 group-hover:text-accent transition-colors">{talk.title}</h3>
                <p class="text-text-muted mt-2 leading-relaxed">{talk.abstract[lang]}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section class="mb-16 fade-in-section">
      <h2 class={`${mono} mb-4`}>{t.pastTitle}</h2>
      <div class="space-y-4">
        {past.map((talk) => {
          const img = coverFor(talk.slug);
          return (
            <a href={`${prefix}/talks/${talk.slug}/`} class="group surface-link overflow-hidden md:flex">
              {img && (
                <img src={img} alt={talk.title} class="w-full h-48 md:h-56 md:w-64 object-cover shrink-0" loading="lazy" />
              )}
              <div class="p-6 flex-1">
                <p class={mono}>{talk.event} &middot; {fmtDate(talk.date)} &middot; {talk.location}</p>
                <h3 class="text-xl font-bold text-text-dark dark:text-text-light mt-1 group-hover:text-accent transition-colors">{talk.title}</h3>
                <p class="text-text-muted mt-2 leading-relaxed">{talk.abstract[lang]}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <FinalCta slot="after" title={t.ctaTitle} desc={t.ctaDesc} ctaLabel={t.ctaPrimary} secondaryLabel={t.ctaSecondary} secondaryHref={mailLink} umamiEvent="cta-talks-final" fullBleed />

</PageLayout>
