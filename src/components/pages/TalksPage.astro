---
import PageLayout from '@/layouts/PageLayout.astro';
import { talks } from '@/data/talks';
import { talkImagesFrom } from '@/utils/talks';
import FinalCta from '@/components/ui/FinalCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import TalkLanguage from '@/components/ui/TalkLanguage.astro';
import SeenAt from '@/components/home/SeenAt.astro';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const mailLink = 'mailto:francesco@montelli.dev';

// Foto talk: glob eager su src/assets/talks/<slug>/*, risolto per slug tramite talkImagesFrom.
// import.meta.glob deve stare nel file consumante (static analysis di Vite).
const allTalkImages = import.meta.glob<{ default: { src: string } }>(
  '/src/assets/talks/*/*.{webp,jpg,jpeg,png}',
  { eager: true },
);
const coverFor = (slug: string): string | null => talkImagesFrom(allTalkImages, slug)[0] ?? null;

// Logo dell'evento (public/images/loghi/), abbinato per nome; null se non c'e'.
const LOGHI: [RegExp, string][] = [
  [/devfest milano/i, 'devfest-milano.png'],
  [/devsecops/i, 'devsecopsday.svg'],
  [/linux day prato/i, 'linuxday-prato.png'],
  [/mlopsday/i, 'mlopsday.svg'],
  [/devfest alps/i, 'devfest-alps.svg'],
  [/devfest bari/i, 'devfest-bari.svg'],
  [/devromagna/i, 'devromagna-orizz.png'],
  [/working software/i, 'working-software.svg'],
];
const logoFor = (event: string): string | null => {
  const hit = LOGHI.find(([re]) => re.test(event));
  return hit ? `/images/loghi/${hit[1]}` : null;
};

const upcoming = talks
  .filter((tk) => tk.status === 'upcoming')
  .sort((a, b) => a.date.localeCompare(b.date));
const past = talks
  .filter((tk) => tk.status === 'delivered')
  .sort((a, b) => b.date.localeCompare(a.date));

const locale = lang === 'en' ? 'en-US' : 'it-IT';
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString(locale, { year: 'numeric', month: 'long' });
const fmtMonth = (iso: string) =>
  new Date(iso).toLocaleDateString(locale, { month: 'short' }).replace('.', '');
const fmtYear = (iso: string) => new Date(iso).getFullYear();

const mono = 'label-mono';

const t = lang === 'en'
  ? {
      pageTitle: 'Talks',
      pageDesc: 'Conferences and talks by Francesco Montelli: slides, material and recordings.',
      eyebrow: 'Speaking',
      heroTitle: 'Conferences & speaking',
      intro: 'Every talk comes out of a real project. Slides, material and recordings are here.',
      note: 'The same topics I work on every day, including the parts that went wrong',
      upcomingTitle: 'Upcoming',
      pastTitle: 'Past talks',
      ctaTitle: 'Looking for a speaker on these topics?',
      ctaDesc: 'Tell me about the event, the audience and the slot. We\'ll work out the angle together.',
      ctaPrimary: 'Book a call',
      ctaSecondary: 'or write me',
    }
  : {
      pageTitle: 'Talks',
      pageDesc: 'Conferenze e talk di Francesco Montelli: slide, materiale e registrazioni.',
      eyebrow: 'Speaking',
      heroTitle: 'Conferenze e speaking',
      intro: 'Ogni talk nasce da un progetto vero. Qui trovi slide, materiale e registrazioni.',
      note: 'Gli stessi temi su cui lavoro tutti i giorni, comprese le parti andate storte',
      upcomingTitle: 'Prossimi',
      pastTitle: 'Talk passati',
      ctaTitle: 'Cerchi uno speaker su questi temi?',
      ctaDesc: 'Raccontami evento, pubblico e durata dello slot. L\'angolo lo troviamo insieme.',
      ctaPrimary: 'Prenota una call',
      ctaSecondary: 'oppure scrivimi',
    };
---

<PageLayout title={t.pageTitle} description={t.pageDesc} ogImage="/og/talks.png" lang={lang}>
  <PageHero
    slot="hero"
    variant="index"
    eyebrow={t.eyebrow}
    title={t.heroTitle}
    subtitle={t.intro}
    note={t.note}
  />
  <SeenAt slot="hero" lang={lang} />

  {upcoming.length > 0 && (
    <section class="mb-20 fade-in-section">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-text-dark mb-6"><span class="text-accent">{t.upcomingTitle}</span></h2>
      <div class="surface-card overflow-hidden divide-y divide-border">
        {upcoming.map((talk) => {
          return (
            <a href={`${prefix}/talks/${talk.slug}/`} class="group flex items-center gap-4 md:gap-6 p-4 md:p-6 hover:bg-base-light/60 transition-colors">
              <div class="shrink-0 w-14 md:w-20 text-center">
                <p class="font-mono text-xs md:text-sm uppercase tracking-[0.12em] font-bold text-accent">{fmtMonth(talk.date)}</p>
                <p class="text-xl md:text-3xl font-extrabold tracking-tight text-text-dark leading-none mt-1">{fmtYear(talk.date)}</p>
              </div>
              <div class="flex-1 min-w-0">
                {logoFor(talk.event)
                  ? <div class="flex items-center gap-3"><img src={logoFor(talk.event)} alt={talk.event} class="h-7 md:h-8 w-auto max-w-[170px] object-contain" /><span class="label-mono">{talk.location}</span></div>
                  : <p class="label-mono">{talk.event} &middot; {talk.location}</p>}
                <h3 class="text-lg md:text-2xl font-bold tracking-tight leading-snug text-text-dark mt-1 group-hover:text-accent transition-colors">{talk.title[lang]}</h3>
                <TalkLanguage language={talk.language} lang={lang} class="mt-2" />
              </div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden sm:block h-5 w-5 shrink-0 text-accent" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section class="mb-20 fade-in-section">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-text-dark mb-6">{t.pastTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {past.map((talk) => {
          const img = coverFor(talk.slug);
          return (
            <a href={`${prefix}/talks/${talk.slug}/`} class="group surface-link overflow-hidden flex flex-col h-full">
              {img ? (
                <img src={img} alt={talk.title[lang]} class="w-full aspect-[4/3] object-cover" loading="lazy" />
              ) : (
                <div class="w-full aspect-[4/3] bg-surface" aria-hidden="true"></div>
              )}
              <div class="p-5 flex-1 flex flex-col">
                {logoFor(talk.event)
                  ? <div class="flex items-center justify-between gap-3"><img src={logoFor(talk.event)} alt={talk.event} class="h-7 w-auto max-w-[150px] object-contain" loading="lazy" /><span class="label-mono !text-accent font-bold">{fmtDate(talk.date)}</span></div>
                  : <p class="label-mono !text-accent font-bold">{talk.event} &middot; {fmtDate(talk.date)}</p>}
                <h3 class="text-lg font-bold tracking-tight text-text-dark mt-2 leading-snug line-clamp-3 group-hover:text-accent transition-colors">{talk.title[lang]}</h3>
                <p class="text-sm text-text-muted mt-auto pt-4">{talk.location}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <FinalCta slot="after" title={t.ctaTitle} desc={t.ctaDesc} />

</PageLayout>
