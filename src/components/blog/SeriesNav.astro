---
import { getCollection } from 'astro:content';
import { postHref } from '@/utils/blog';
import { seriesMetadata } from '@/data/series';

interface Props {
  series: string;
  currentId: string;
  lang?: 'it' | 'en';
}

const { series, currentId, lang = 'it' } = Astro.props;

const allPosts = await getCollection('posts');
const seriesPosts = allPosts
  .filter(p => p.data.series === series && p.data.lang === lang && !p.data.draft)
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

const showNav = seriesPosts.length > 1;

const currentIndex = seriesPosts.findIndex(p => p.id === currentId);
const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
const nextPost = currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;

// Se la serie ha una landing, il titolo vero sta li'; altrimenti si ricava dallo slug.
const meta = seriesMetadata[series];
const seriesLabel = (lang === 'en' ? meta?.en.title : meta?.title) ?? series
  .replace(/-/g, ' ')
  .replace(/\b\w/g, c => c.toUpperCase());
const landingHref = meta ? `${lang === 'en' ? '/en' : ''}/blog/${meta.pillar}/${series}/` : null;

const t = {
  part: lang === 'en' ? 'Part' : 'Parte',
  of: lang === 'en' ? 'of' : 'di',
  all: lang === 'en' ? 'Whole series' : 'Tutta la serie',
  prev: lang === 'en' ? 'Previous' : 'Precedente',
  next: lang === 'en' ? 'Next' : 'Successivo',
};
---

{showNav && (
  <details class="series-line group border-b border-border text-[15px]">
    <summary class="flex flex-wrap items-center gap-x-2 py-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <span>{`${t.part} ${currentIndex + 1} ${t.of} ${seriesPosts.length}`}</span>
      <span aria-hidden="true">·</span>
      <b class="text-accent">{seriesLabel}</b>
      <span aria-hidden="true">·</span>
      <span class="text-text-muted">{t.all}{' '}<span class="inline-block transition-transform group-open:rotate-180" aria-hidden="true">▾</span></span>
    </summary>

    <ol class="space-y-1 pb-3 text-sm">
      {seriesPosts.map((post, i) => {
        const isCurrent = post.id === currentId;
        return (
          <li>
            {isCurrent ? (
              <span class="block py-1 px-3 border-l-2 border-accent font-semibold text-accent">
                {i + 1}. {post.data.title}
              </span>
            ) : (
              <a
                href={postHref(post.id, lang)}
                class="block py-1 px-3 border-l-2 border-transparent text-text-muted hover:text-accent hover:border-accent/50 transition-colors"
              >
                {i + 1}. {post.data.title}
              </a>
            )}
          </li>
        );
      })}
    </ol>

    <div class="flex items-center justify-between gap-4 pb-3 text-sm">
      {prevPost ? (
        <a href={postHref(prevPost.id, lang)} class="text-text-muted hover:text-accent transition-colors truncate" title={prevPost.data.title}>&larr; {t.prev}</a>
      ) : <span />}
      {landingHref && <a href={landingHref} class="text-text-muted hover:text-accent transition-colors">{seriesLabel}</a>}
      {nextPost ? (
        <a href={postHref(nextPost.id, lang)} class="text-text-muted hover:text-accent transition-colors truncate text-right" title={nextPost.data.title}>{t.next} &rarr;</a>
      ) : <span />}
    </div>
  </details>
)}
