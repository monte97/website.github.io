---
/**
 * Corpo dell'indice del blog (prova D): tre settori per pillar, dentro ciascuno
 * le sue serie e i suoi pezzi singoli.
 *
 * Sta in un componente perché le prove sull'hero condividano lo stesso corpo:
 * così quello che si confronta è solo la testa della pagina.
 */
import SeriesGrid from '@/components/blog/SeriesGrid.astro';
import { postHref, estimateReadingTime } from '@/utils/blog';
import { pillarStyles } from '@/data/pillar-styles';
import { getPillarLabel } from '@/data/pillars';
import type { SeriesEntry } from '@/utils/series';

interface Props {
  series: SeriesEntry[];
  singoli: any[];
  lang?: 'it' | 'en';
}
const { series, singoli, lang = 'it' } = Astro.props;
const tr = lang === 'en'
  ? { articoli: 'articles', serie: 'series', singoli: 'Single pieces' }
  : { articoli: 'articoli', serie: 'serie', singoli: 'Pezzi singoli' };

export const PILLARS = ['progettare', 'verificare', 'automatizzare'] as const;
export const introPillar: Record<'it' | 'en', Record<string, string>> = {
  it: {
    progettare: 'Decidere cosa costruire e come: architettura, eventi, identità, autorizzazione.',
    verificare: 'Assicurarsi che funzioni e che si sappia quando smette: test, observability, alerting.',
    automatizzare: 'Far girare tutto senza intervento manuale: cluster, pipeline, container, homelab.',
  },
  en: {
    progettare: 'Deciding what to build and how: architecture, events, identity, authorization.',
    verificare: 'Making sure it works, and knowing when it stops: testing, observability, alerting.',
    automatizzare: 'Keeping it running without anyone watching: clusters, pipelines, containers, homelab.',
  },
};
---

<div class="space-y-20">
  {PILLARS.map(pil => {
    const st = pillarStyles[pil];
    const mieSerie = series.filter(s => s.pillar === pil);
    const mieiSingoli = singoli.filter(p => p.data.pillar === pil);
    const tot = mieSerie.reduce((a, s) => a + s.count, 0) + mieiSingoli.length;

    return (
      <section id={pil} class="scroll-mt-24">
        <div class="mb-8">
          <p class="label-mono !text-accent mb-3">
            {st.num} · {tot} {tr.articoli}{mieSerie.length > 0 && ` · ${mieSerie.length} ${tr.serie}`}
          </p>
          <h2 class="text-3xl md:text-[2.5rem] leading-[1.1] font-extrabold tracking-tight text-text-dark">{getPillarLabel(pil, lang)}</h2>
          <p class="mt-3 text-lg text-text-muted max-w-2xl leading-relaxed">{introPillar[lang][pil]}</p>
        </div>

        {mieSerie.length > 0 && <SeriesGrid series={mieSerie} cols={2} lang={lang} />}

        {mieiSingoli.length > 0 && (
          <div class={mieSerie.length > 0 ? 'mt-10' : ''}>
            <p class="label-mono mb-2">{tr.singoli}</p>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 border-t border-border">
              {mieiSingoli.map(p => (
                <li>
                  <a href={postHref(p.id, lang)} class="group flex items-baseline gap-3 py-3 border-b border-border">
                    <span class="flex-1 text-[15px] font-medium text-text-dark group-hover:text-accent transition-colors leading-snug">
                      {p.data.title}
                    </span>
                    <span class="shrink-0 label-mono tabular-nums">{estimateReadingTime(p.body)} min</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    );
  })}
</div>
