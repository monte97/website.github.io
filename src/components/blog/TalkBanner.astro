---
/**
 * Se l'articolo e' legato a un talk (talks.ts, links.article), lo dice subito
 * sotto il titolo: foto dal palco, evento, titolo del talk, link a pagina e slide.
 */
import { talks } from '@/data/talks';
import { talkImagesFrom, eventLogo } from '@/utils/talks';

interface Props { lang?: 'it' | 'en' }
const { lang = 'it' } = Astro.props;

const path = Astro.url.pathname.replace(/^\/en/, '').replace(/\/?$/, '/');
const talk = talks.find(t => t.links?.article && t.links.article.replace(/\/?$/, '/') === path);

const allTalkImages = import.meta.glob<{ default: { src: string } }>(
  '/src/assets/talks/*/*.{webp,jpg,jpeg,png}',
  { eager: true },
);
const photo = talk ? (talkImagesFrom(allTalkImages, talk.slug)[0] ?? null) : null;
const logo = talk ? eventLogo(talk.event) : null;
const prefix = lang === 'en' ? '/en' : '';
const when = talk ? new Date(talk.date).toLocaleDateString(lang === 'en' ? 'en-US' : 'it-IT', { month: 'long', year: 'numeric' }) : '';
const t = lang === 'en'
  ? { k: talk?.status === 'upcoming' ? 'I will talk about it on stage' : 'I talked about it on stage', page: 'The talk', slides: 'Slides' }
  : { k: talk?.status === 'upcoming' ? 'Ne parlerò dal palco' : 'Ne ho parlato dal palco', page: 'Il talk', slides: 'Le slide' };
---

{talk && (
  <aside class="mb-10 overflow-hidden rounded-2xl bg-[#16161d] text-white grid md:grid-cols-[260px_1fr]">
    {photo
      ? <img src={photo} alt="" class="w-full h-44 md:h-full object-cover" loading="lazy" />
      : <div class="hidden md:block bg-[#1f1f29]" aria-hidden="true"></div>}
    <div class="p-6 md:p-7 flex flex-col gap-3">
      <p class="text-[12px] font-bold uppercase tracking-[0.12em] text-accent">{t.k}</p>
      <div class="flex flex-wrap items-center gap-3">
        {logo && <span class="inline-flex items-center rounded-lg bg-white px-3 py-2"><img src={logo} alt={talk.event} class="h-6 w-auto max-w-[160px] object-contain" /></span>}
        <span class="text-sm text-white/70">{logo ? '' : `${talk.event} · `}{when} · {talk.location}</span>
      </div>
      <p class="text-xl md:text-2xl font-extrabold tracking-tight leading-snug">{talk.title[lang]}</p>
      <div class="mt-1 flex flex-wrap gap-3">
        <a href={`${prefix}/talks/${talk.slug}/`} class="inline-flex rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-hover transition-colors">{t.page} →</a>
        {talk.links?.slides && <a href={talk.links.slides} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-lg border border-white/40 px-4 py-2 text-sm font-semibold text-white hover:border-accent hover:text-accent transition-colors">{t.slides}</a>}
      </div>
    </div>
  </aside>
)}
