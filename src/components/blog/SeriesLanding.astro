---
/**
 * Landing di una serie del blog.
 *
 * Le pagine sotto src/pages/blog/<pillar>/<serie>/index.astro sono wrapper di
 * dieci righe: passano lo slug della serie e, nello slot, il cappello in prosa
 * che spiega perché la serie esiste. Tutto il resto (hero, stats, elenco degli
 * articoli, sidebar) vive qui.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { postHref, estimateReadingTime } from '@/utils/blog';
import { pillarStyles } from '@/data/pillar-styles';
import { getPillarLabel } from '@/data/pillars';
import { seriesMetadata } from '@/data/series';
import AuthorCard from '@/components/ui/AuthorCard.astro';

interface Props {
  /** Chiave in seriesMetadata, e valore del campo `series` nel frontmatter dei post */
  series: string;
  lang?: 'it' | 'en';
}

const { series, lang = 'it' } = Astro.props;
const base = seriesMetadata[series];
if (!base) throw new Error(`SeriesLanding: nessun metadata per la serie "${series}"`);

// L'italiano è la sorgente: l'inglese sovrascrive solo i campi tradotti.
const meta = lang === 'en' ? { ...base, ...base.en } : base;

const t = lang === 'en'
  ? { serie: 'Series', articoli: 'articles', pubblicati: 'Published articles',
      minuti: 'Minutes of reading', livello: 'Level', imparerai: 'What you will learn',
      elenco: 'Articles in the series', servizio: 'Service', scopri: 'See the service',
      scrivimi: 'Email me directly', inArrivo: 'Coming soon' }
  : { serie: 'Serie', articoli: 'articoli', pubblicati: 'Articoli pubblicati',
      minuti: 'Minuti di lettura', livello: 'Livello', imparerai: 'Cosa imparerai',
      elenco: 'Articoli della serie', servizio: 'Servizio', scopri: 'Scopri il servizio',
      scrivimi: 'Scrivimi direttamente', inArrivo: 'In arrivo' };

const blogHref = lang === 'en' ? '/en/blog/' : '/blog/';
const altHref = lang === 'en'
  ? `/blog/${base.pillar}/${series}/`
  : `/en/blog/${base.pillar}/${series}/`;

const allPosts = await getCollection('posts');
const articles = allPosts
  .filter(p => p.data.series === series && p.data.lang === lang)
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

const publishedArticles = articles.filter(p => !p.data.draft);
const totalReadingTime = publishedArticles.reduce(
  (acc, p) => acc + estimateReadingTime(p.body),
  0
);

const styles = pillarStyles[meta.pillar];
const pillarLabel = getPillarLabel(meta.pillar);
---

<BaseLayout
  title={`${meta.title} · Serie completa`}
  description={meta.subtitle}
  ogImage={`/og/${series}.png`}
  lang={lang}
>
  <Header lang={lang} altHref={altHref} />

  <main>
    <!-- ── Hero ── -->
    <section class="bg-base-light border-b border-border">
      <div class="max-w-5xl mx-auto px-5 py-14 md:py-16">
        <nav class="flex items-center gap-2 label-mono mb-6" aria-label="Breadcrumb">
          <a href={blogHref} class="hover:text-accent transition-colors">Blog</a>
          <span>/</span>
          <span>{pillarLabel}</span>
        </nav>

        <div class="grid lg:grid-cols-[1fr_auto] gap-10 items-start">
          <div>
            <p class="label-mono !text-accent mb-4">{t.serie} · {publishedArticles.length} {t.articoli}</p>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-text-dark leading-[1.08] max-w-3xl">
              {meta.title}
            </h1>
            <p class="mt-5 text-lg md:text-xl text-text-muted leading-relaxed max-w-2xl">
              {meta.subtitle}
            </p>
          </div>

          <div class="lg:min-w-[220px] surface-card p-5 space-y-4">
            <div>
              <div class="text-3xl font-extrabold tracking-tight text-text-dark">{publishedArticles.length}</div>
              <div class="label-mono">{t.pubblicati}</div>
            </div>
            <div class="border-t border-border" />
            <div>
              <div class="text-3xl font-extrabold tracking-tight text-text-dark">{totalReadingTime}</div>
              <div class="label-mono">{t.minuti}</div>
            </div>
            <div class="border-t border-border" />
            <div>
              <div class="text-sm font-bold text-text-dark">{meta.level}</div>
              <div class="label-mono">{t.livello}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-5 py-14 grid lg:grid-cols-[1fr_320px] gap-12 items-start">

      <div>
        <section class="mb-14 max-w-2xl">
          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-text-dark mb-5 leading-tight">
            {meta.cappello.h2}
          </h2>
          <div class="space-y-4 text-text-muted leading-relaxed">
            <p class="text-text-dark">{meta.description}</p>
            {meta.cappello.paragrafi.map(par => <p set:html={par} />)}
          </div>
        </section>

        <section class="mb-14">
          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-text-dark mb-5">
            {t.imparerai}
          </h2>
          <ul class="border-t border-border">
            {meta.learningGoals.map(goal => (
              <li class="flex items-start gap-3 py-3 border-b border-border">
                <span class="text-accent font-bold shrink-0" aria-hidden="true">&check;</span>
                <span class="text-text-muted leading-relaxed">{goal}</span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-text-dark mb-6">
            {t.elenco}
          </h2>

          <ol class="space-y-3">
            {articles.map((post, i) => {
              const isDraft = post.data.draft;
              const readTime = estimateReadingTime(post.body);
              const href = postHref(post.id, lang);
              const num = String(i + 1).padStart(2, '0');

              return (
                <li>
                  {isDraft ? (
                    <div class="flex gap-4 p-5 surface-card opacity-50 cursor-not-allowed">
                      <span class="label-mono pt-1 shrink-0">{num}</span>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                          <span class="font-semibold text-text-muted">{post.data.title}</span>
                          <span class="label-mono">{t.inArrivo}</span>
                        </div>
                        <p class="text-sm text-text-muted line-clamp-2">{post.data.description}</p>
                      </div>
                    </div>
                  ) : (
                    <a href={href} class="group surface-link flex gap-4 p-5">
                      <span class="label-mono !text-accent pt-1 shrink-0">{num}</span>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-3 mb-1">
                          <span class="font-bold text-text-dark group-hover:text-accent transition-colors leading-snug">
                            {post.data.title}
                          </span>
                          <span class="label-mono shrink-0 pt-1">{readTime} min</span>
                        </div>
                        <p class="text-sm text-text-muted leading-relaxed line-clamp-2">
                          {post.data.description}
                        </p>
                      </div>
                    </a>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-6">
        <div class="surface-card p-6">
          <p class="label-mono !text-accent mb-3">{t.servizio}</p>
          <h3 class="text-xl font-extrabold tracking-tight text-text-dark mb-3 leading-snug">
            {meta.serviceCTA}
          </h3>
          <p class="text-sm text-text-muted leading-relaxed mb-5">
            {meta.serviceDescription}
          </p>
          <a
            href={meta.serviceHref}
            class="block w-full text-center px-4 py-3 rounded-lg bg-accent text-white text-sm font-semibold hover:bg-accent-hover transition-colors"
          >
            {t.scopri} &rarr;
          </a>
          <a
            href="mailto:francesco@montelli.dev"
            class="block w-full text-center mt-2 px-4 py-2.5 text-sm font-medium text-text-muted hover:text-accent transition-colors"
          >
            {t.scrivimi}
          </a>
        </div>

        <AuthorCard lang={lang} />
      </aside>
    </div>
  </main>

  <Footer lang="it" />
</BaseLayout>
