---
/**
 * Card di un articolo: copertina = prima figura dell'articolo, oppure una
 * copertina scura generata (icona, pillar, primo tag) quando non ne ha.
 */
import { Image } from 'astro:assets';
import { postHref } from '@/utils/blog';
import { getPillarLabel } from '@/data/pillars';
import { getCover } from '@/utils/blogCover';

interface Props { post: any; lang?: 'it' | 'en' }
const { post, lang = 'it' } = Astro.props;
const cover = getCover(post);
const pillar = post.data.pillar;
const pillarLabel = pillar ? getPillarLabel(pillar, lang) : '';
const tag = post.data.tags?.[0] ?? pillarLabel;
const date = post.data.date.toISOString().slice(0, 10);
const icons: Record<string, string> = {
  progettare: 'M4 20h16M6 16l4-10 4 6 3-4 3 8',
  verificare: 'M20 20l-4.5-4.5M8.5 11l2 2 3.5-3.5',
  automatizzare: 'M13 3L5 14h6l-1 7 8-11h-6z',
};
---

<a href={postHref(post.id, lang)} class="group flex flex-col h-full overflow-hidden rounded-2xl border border-border bg-white hover:border-accent hover:shadow-[0_10px_30px_-12px_rgba(0,0,0,0.18)] transition-all">
  {cover ? (
    <Image src={cover} alt="" width={640} loading="lazy" class="w-full aspect-video object-contain p-2 bg-[#f3efe9] border-b border-border" />
  ) : (
    <div class="relative aspect-video overflow-hidden bg-[#1f1f29] p-5 flex flex-col justify-end gap-1">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="absolute -top-6 -right-6 w-44 h-44 text-accent opacity-90" aria-hidden="true">
        <path d={icons[pillar] ?? icons.progettare} />
      </svg>
      <span class="relative text-[11px] font-bold uppercase tracking-wider text-accent">{pillarLabel}</span>
      <span class="relative text-2xl font-extrabold text-white leading-tight line-clamp-2">{tag}</span>
    </div>
  )}
  <div class="p-5">
    <p class="text-[11px] font-bold uppercase tracking-wider text-accent mb-2">{date}{pillarLabel && ` · ${pillarLabel}`}</p>
    <h3 class="text-lg font-extrabold leading-snug tracking-tight text-text-dark line-clamp-3">{post.data.title}</h3>
  </div>
</a>
