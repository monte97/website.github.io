---
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getPillarLabel } from '@/data/pillars';

interface Props {
  title: string;
  description: string;
  date: Date;
  pillar: 'progettare' | 'verificare' | 'automatizzare' | null;
  tags: string[];
  href: string;
  lang?: 'it' | 'en';
  heroImage?: string;
  readingTime?: number;
}

const { title, description, date, pillar, tags, href, lang = 'it', heroImage, readingTime } = Astro.props;

const formattedDate = date.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const displayTags = tags.slice(0, 3);
---

<a href={href} class="group block h-full">
  <Card pillar={pillar} class={heroImage ? 'overflow-hidden !p-0' : ''}>
    {heroImage && (
      <img src={heroImage} alt="" class="w-full h-36 object-cover" loading="lazy" />
    )}
    <div class:list={[heroImage ? 'p-6' : '', 'flex flex-col flex-1']}>
      <div class="flex items-center gap-2 mb-3">
        <time class="text-xs text-text-muted tabular-nums" datetime={date.toISOString()}>
          {formattedDate}
        </time>
        {pillar && (
          <Badge pillar={pillar}>
            {getPillarLabel(pillar, lang)}
          </Badge>
        )}
        {readingTime && (
          <span class="text-xs text-text-muted">{readingTime} min</span>
        )}
      </div>
      <h3 class="text-base font-semibold mb-1.5 text-text-dark dark:text-text-light group-hover:text-accent transition-colors leading-snug">
        {title}
      </h3>
      <p class="text-text-muted text-sm line-clamp-2 leading-relaxed">
        {description}
      </p>
      {displayTags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-auto pt-3">
          {displayTags.map((tag) => (
            <span class="text-[11px] text-text-muted/80 bg-text-muted/8 px-1.5 py-0.5 rounded">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </Card>
</a>
