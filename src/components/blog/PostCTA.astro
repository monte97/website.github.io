---
type Variant = 'generic' | 'observability' | 'architecture';

interface Props {
  lang?: 'it' | 'en';
  category?: string;
}

const { lang = 'it', category } = Astro.props;

const observabilityCategories = new Set(['observability', 'testing', 'openfga']);
const architectureCategories = new Set([
  'kafka',
  'kubernetes',
  'system-design',
  'keycloak',
  'devops',
  'docker',
]);

function pickVariant(cat?: string): Variant {
  if (!cat) return 'generic';
  if (observabilityCategories.has(cat)) return 'observability';
  if (architectureCategories.has(cat)) return 'architecture';
  return 'generic';
}

const variant = pickVariant(category);
const prefix = lang === 'en' ? '/en' : '';

const calLink = 'https://cal.com/francesco-montelli-4hfojq/30min';
const mailLink = 'mailto:francesco@montelli.dev';
// in inglese la pagina e' /en/services/, non /en/servizi/
const servicesLink = lang === 'en' ? '/en/services/' : '/servizi/';

type Copy = {
  title: string;
  body: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
};

const copy: Record<'it' | 'en', Record<Variant, Copy>> = {
  it: {
    generic: {
      title: 'Stai affrontando qualcosa di simile in produzione?',
      body: 'Lavoro con aziende di prodotto: progetto, sviluppo e automatizzo il loro software. Se vuoi capire dove intervenire nel tuo sistema, partiamo da una discovery call di 30 minuti.',
      primary: { label: 'Prenota una discovery call', href: calLink },
      secondary: { label: 'oppure scrivimi', href: mailLink },
    },
    observability: {
      title: 'Stai implementando questo nel tuo stack?',
      body: 'Se il tuo sistema non ti dà ancora visibilità su cosa succede in produzione, posso aiutarti a capire da dove partire. Partiamo da una call di 30 minuti: niente impegno, solo un quadro chiaro su da dove iniziare.',
      primary: { label: 'Prenota una discovery call', href: calLink },
      secondary: { label: 'o vedi come lavoro', href: servicesLink },
    },
    architecture: {
      title: 'Stai affrontando una decisione architetturale simile?',
      body: 'Queste decisioni sono le più costose da cambiare in corsa. Se hai dubbi su come strutturare il sistema o vuoi un secondo parere prima di procedere, parliamone.',
      primary: { label: 'Prenota una discovery call', href: calLink },
      secondary: { label: 'o scrivimi direttamente', href: mailLink },
    },
  },
  en: {
    generic: {
      title: 'Facing something similar in production?',
      body: "I work with product companies: I design, build and automate their software. If you want to figure out where to act on your system, let's start with a 30-minute discovery call.",
      primary: { label: 'Book a discovery call', href: calLink },
      secondary: { label: 'or write me', href: mailLink },
    },
    observability: {
      title: 'Rolling this out on your stack?',
      body: "If your system still doesn't give you visibility into what's happening in production, I can help you figure out where to start. Let's start with a 30-minute call: no commitment, just a clear picture of where to begin.",
      primary: { label: 'Book a discovery call', href: calLink },
      secondary: { label: 'or see how I work', href: servicesLink },
    },
    architecture: {
      title: 'Facing a similar architectural decision?',
      body: "These are the most expensive decisions to change later. If you're unsure how to structure the system, or want a second opinion before moving forward, let's talk.",
      primary: { label: 'Book a discovery call', href: calLink },
      secondary: { label: 'or write me directly', href: mailLink },
    },
  },
};

const c = copy[lang][variant];
const primaryIsExternal = c.primary.href.startsWith('http');
const secondaryIsExternal = c.secondary.href.startsWith('http');
---

<aside
  class="mt-12 pt-8 border-t border-border dark:border-border-dark"
  data-cta-variant={variant}
>
  <div class="rounded-xl border border-border/70 dark:border-border-dark/70 border-l-[3px] border-l-accent bg-white dark:bg-surface-dark p-8 md:p-10 max-w-3xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold text-text-dark dark:text-text-light mb-3">
      {c.title}
    </h2>
    <p class="text-text-muted text-base md:text-lg leading-relaxed mb-6">
      {c.body}
    </p>
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5">
      <a
        href={c.primary.href}
        target={primaryIsExternal ? '_blank' : undefined}
        rel={primaryIsExternal ? 'noopener noreferrer' : undefined}
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-accent text-white text-sm font-semibold hover:bg-accent-hover transition-colors"
      >
        {c.primary.label} <span aria-hidden="true">→</span>
      </a>
      <a
        href={c.secondary.href}
        target={secondaryIsExternal ? '_blank' : undefined}
        rel={secondaryIsExternal ? 'noopener noreferrer' : undefined}
        class="text-sm text-text-muted hover:text-accent transition-colors"
      >
        {c.secondary.label}
      </a>
    </div>
  </div>
</aside>
