---
/**
 * Testata dell'indice del blog (IT e EN): titolo, una riga, le tre porte per
 * pillar come sommario e l'ultimo articolo. Condivisa da /blog/ e /en/blog/.
 */
import PageHero from '@/components/ui/PageHero.astro';
import { postHref, estimateReadingTime } from '@/utils/blog';
import { getPillarLabel } from '@/data/pillars';
import { pillarStyles } from '@/data/pillar-styles';

interface Props {
  allPosts: any[];
  series: { pillar?: string | null }[];
  lang?: 'it' | 'en';
}
const { allPosts, series, lang = 'it' } = Astro.props;

const PILLARS = ['progettare', 'verificare', 'automatizzare'] as const;
const ultimo = [...allPosts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const t = lang === 'en'
  ? {
      eyebrow: 'Blog',
      title: 'What I learned by building, put in order',
      sub: 'Real systems, decisions actually taken, limits declared alongside the results.',
      note: `${allPosts.length} articles · ${series.length} series`,
      art: 'articles', ser: 'series', latest: 'Latest',
      riga: {
        progettare: 'Architecture, events, identity, permissions',
        verificare: 'Testing, observability, alerting',
        automatizzare: 'Clusters, pipelines, containers, homelab',
      } as Record<string, string>,
    }
  : {
      eyebrow: 'Blog',
      title: 'Quello che ho imparato costruendo, messo in ordine',
      sub: 'Sistemi veri, scelte prese davvero, vincoli dichiarati insieme ai risultati.',
      note: `${allPosts.length} articoli · ${series.length} serie`,
      art: 'articoli', ser: 'serie', latest: "L'ultimo",
      riga: {
        progettare: 'Architetture, eventi, identità, permessi',
        verificare: 'Test, observability, alerting',
        automatizzare: 'Cluster, pipeline, container, homelab',
      } as Record<string, string>,
    };

const conteggi: Record<string, { art: number; ser: number }> = {
  progettare: { art: 0, ser: 0 }, verificare: { art: 0, ser: 0 }, automatizzare: { art: 0, ser: 0 },
};
for (const p of allPosts) if (p.data.pillar) conteggi[p.data.pillar].art++;
for (const s of series) if (s.pillar) conteggi[s.pillar].ser++;
---

<PageHero variant="index" eyebrow={t.eyebrow} title={t.title} subtitle={t.sub} note={t.note}>
  <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 surface-card overflow-hidden divide-y sm:divide-y-0 sm:divide-x divide-border">
    {PILLARS.map(pil => {
      const st = pillarStyles[pil];
      const c = conteggi[pil];
      return (
        <a href={`#${pil}`} class="group block p-5 hover:bg-base-light transition-colors">
          <div class="flex items-baseline gap-2">
            <span class="label-mono !text-accent">{st.num}</span>
            <span class="text-xl font-extrabold tracking-tight text-text-dark group-hover:text-accent transition-colors">
              {getPillarLabel(pil, lang)}
            </span>
          </div>
          <p class="mt-2 text-sm text-text-muted leading-snug">{t.riga[pil]}</p>
          <p class="mt-3 label-mono">{c.art} {t.art} · {c.ser} {t.ser}</p>
        </a>
      );
    })}
  </div>

  {ultimo && (
    <a href={postHref(ultimo.id, lang)} class="group mt-4 flex items-baseline gap-3 py-3 border-b border-border">
      <span class="label-mono !text-accent shrink-0">{t.latest}</span>
      <span class="flex-1 font-semibold text-text-dark group-hover:text-accent transition-colors leading-snug">{ultimo.data.title}</span>
      <span class="label-mono shrink-0">{estimateReadingTime(ultimo.body)} min</span>
    </a>
  )}
</PageHero>
