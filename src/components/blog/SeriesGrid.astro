---
/**
 * Griglia delle serie. Le serie con una landing hanno la card "piena": ci si
 * arriva alla porta della serie. Quelle senza portano al primo articolo e lo
 * dicono, invece di fingere di essere la stessa cosa.
 */
import type { SeriesEntry } from '@/utils/series';

interface Props {
  series: SeriesEntry[];
  /** due o tre colonne */
  cols?: 2 | 3;
  lang?: 'it' | 'en';
}
const { series, cols = 3, lang = 'it' } = Astro.props;
const t = lang === 'en'
  ? { uno: 'article', molti: 'articles', tot: 'min in total', apri: 'Open the series', primo: 'Start from the first' }
  : { uno: 'articolo', molti: 'articoli', tot: 'min in tutto', apri: 'Apri la serie', primo: 'Parti dal primo' };
const grid = cols === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---

<div class={`grid grid-cols-1 ${grid} gap-4`}>
  {series.map(s => {
    const href = s.landingHref ?? s.firstHref;
    return (
      <a href={href} class="group surface-link flex flex-col h-full p-6">
        <p class="label-mono mb-3">
          {s.count} {s.count === 1 ? t.uno : t.molti} · {s.minutes} min
        </p>

        <h3 class="text-xl font-extrabold tracking-tight text-text-dark leading-snug group-hover:text-accent transition-colors">
          {s.title}
        </h3>

        {s.subtitle && (
          <p class="mt-2 text-sm text-text-muted leading-relaxed line-clamp-2">{s.subtitle}</p>
        )}

        <span class="mt-auto pt-5 text-sm font-semibold text-accent">
          {s.landingHref ? t.apri : t.primo} &rarr;
        </span>
      </a>
    );
  })}
</div>
