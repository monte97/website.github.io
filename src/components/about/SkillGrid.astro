---
import { skills } from '@/data/skills';

const categoryLabels: Record<string, string> = {
  language: 'Linguaggi',
  container: 'Container & Orchestration',
  frameworks: 'Framework & Piattaforme',
  observability: 'Observability',
  database: 'Database',
  devops: 'DevOps & CI/CD',
  cloud: 'Cloud',
  basic: 'Core',
};

const categoryOrder = ['language', 'container', 'frameworks', 'observability', 'database', 'devops', 'cloud'];

// Group skills by their first category
const grouped = new Map<string, typeof skills>();
for (const skill of skills) {
  const cat = skill.categories[0] ?? 'basic';
  if (!grouped.has(cat)) {
    grouped.set(cat, []);
  }
  grouped.get(cat)!.push(skill);
}

// Build ordered entries, placing any remaining categories at the end
const orderedGroups: [string, typeof skills][] = [];
for (const cat of categoryOrder) {
  if (grouped.has(cat)) {
    orderedGroups.push([cat, grouped.get(cat)!]);
    grouped.delete(cat);
  }
}
// Append any leftover categories (e.g. 'basic' skills not already placed)
for (const [cat, items] of grouped) {
  orderedGroups.push([cat, items]);
}
---

<div>
  {orderedGroups.map(([category, items]) => (
    <div class="mb-8">
      <h3 class="text-xs text-text-muted uppercase tracking-wide mb-3">
        {categoryLabels[category] ?? category}
      </h3>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-4">
        {items.map((skill) => (
          <a
            href={skill.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-2 p-3 rounded-lg hover:bg-border/20 dark:hover:bg-border-dark/30 transition-colors"
            title={skill.summary}
          >
            {skill.logo ? (
              <img src={skill.logo} alt={skill.name} width="40" height="40" loading="lazy" class:list={["w-10 h-10 object-contain", skill.darkInvert && "dark:brightness-0 dark:invert"]} />
            ) : (
              <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center text-accent font-bold text-sm">
                {skill.name.charAt(0)}
              </div>
            )}
            <span class="text-xs text-center font-medium text-text-dark dark:text-text-light">{skill.name}</span>
          </a>
        ))}
      </div>
    </div>
  ))}
</div>
