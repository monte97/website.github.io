---
interface TimelineItem {
  title: string;
  subtitle: string;
  period: string;
  description?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<div class="relative pl-8 space-y-10">
  {/* Vertical line */}
  <div class="absolute left-[7px] top-2 bottom-2 w-px bg-border dark:bg-border-dark"></div>

  {items.map((item) => (
    <div class="relative">
      {/* Dot */}
      <div class="absolute -left-8 top-1.5 w-[15px] h-[15px] rounded-full bg-accent border-2 border-base-light dark:border-base-dark"></div>

      <div>
        <h3 class="font-semibold text-lg text-text-dark dark:text-text-light">{item.title}</h3>
        <p class="text-accent text-sm">{item.subtitle}</p>
        <p class="text-xs text-text-muted mt-0.5">{item.period}</p>
        {item.description && (
          <p class="text-text-muted mt-2 text-sm leading-relaxed">{item.description}</p>
        )}
      </div>
    </div>
  ))}
</div>
