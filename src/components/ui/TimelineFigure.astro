---
interface Step {
  /** etichetta mono sopra il titolo: fase, periodo, stato */
  kind?: string;
  title: string;
  desc?: string;
  /** ultimo passo raggiunto: pallino pieno accento invece che vuoto */
  done?: boolean;
}
interface Props {
  figureId?: string;
  label?: string;
  steps: Step[];
  caption?: string;
  note?: string;
}
const { figureId, label, steps, caption, note } = Astro.props;
---

<figure class="not-prose my-10">
  {figureId && label && (
    <figcaption class="text-[10px] font-mono uppercase tracking-[0.18em] text-accent mb-3">
      {figureId} &middot; {label}
    </figcaption>
  )}

  <div class="rounded-2xl border border-border/60 dark:border-border-dark/60 bg-accent-subtle/20 p-5 md:p-7">
    {!figureId && label && (
      <span class="block text-[10px] font-mono uppercase tracking-[0.2em] text-text-muted mb-5">{label}</span>
    )}

    <ol class="flex flex-col">
      {steps.map((s, i) => (
        <li class="flex gap-4 md:gap-5">
          <div class="flex flex-col items-center shrink-0">
            <span class={`w-3 h-3 rounded-full mt-1.5 border-2 border-accent ${s.done ? 'bg-accent' : 'bg-white dark:bg-surface-dark'}`} />
            {i < steps.length - 1 && (
              <span class="w-px flex-1 min-h-6 bg-border dark:bg-border-dark" />
            )}
          </div>
          <div class={i < steps.length - 1 ? 'pb-7' : ''}>
            {s.kind && (
              <span class="block text-[10px] font-mono uppercase tracking-[0.18em] text-text-muted">{s.kind}</span>
            )}
            <span class="block font-bold text-sm text-text-dark dark:text-text-light mt-0.5 text-balance">{s.title}</span>
            {s.desc && <span class="block text-sm text-text-muted mt-1.5 leading-relaxed max-w-xl">{s.desc}</span>}
          </div>
        </li>
      ))}
    </ol>
  </div>

  {caption && (
    <figcaption class="mt-2 text-[10px] font-mono uppercase tracking-[0.15em] text-text-muted">{caption}</figcaption>
  )}
  {note && <p class="mt-3 text-sm text-text-muted leading-relaxed max-w-2xl">{note}</p>}
</figure>
