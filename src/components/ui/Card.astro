---
import { pillarStyles } from '@/data/pillar-styles';
import type { Pillar } from '@/data/pillars';

interface Props {
  pillar?: Pillar | null;
  class?: string;
}

const { pillar, class: className = '' } = Astro.props;

const borderClass = pillar ? `border-l-[3px] ${pillarStyles[pillar].borderLeft}` : '';
---

<div class:list={[
  'bg-white dark:bg-surface-dark rounded-xl border border-border/70 dark:border-border-dark/70 p-6',
  'hover:border-border dark:hover:border-border-dark hover:shadow-md transition-colors duration-200',
  'h-full flex flex-col',
  borderClass,
  className,
]}>
  <slot />
</div>
