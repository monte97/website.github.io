---
import { pillarStyles } from '@/data/pillar-styles';
import type { Pillar } from '@/data/pillars';

interface Props {
  pillar?: Pillar | null;
  class?: string;
}

const { pillar, class: className = '' } = Astro.props;

const borderClass = pillar ? `border-l-[3px] ${pillarStyles[pillar].borderLeft}` : '';
---

<div class:list={[
  'surface-link p-6',
  'h-full flex flex-col',
  borderClass,
  className,
]}>
  <slot />
</div>
