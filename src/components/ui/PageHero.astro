---
import Button from '@/components/ui/Button.astro';

interface Props {
  title: string;
  subtitle?: string;
  /** Etichetta mono sopra il titolo (Formazione, Lavori, ...) */
  eyebrow?: string;
  /** 'left' (default, con immagine) oppure 'center' per le pagine indice */
  align?: 'left' | 'center';
  image?: { src: string; alt: string };
  cta?: { href: string; label: string };
  ctaSecondary?: { href: string; label: string };
  /**
   * 'index' e' la testata degli elenchi (blog, case study, talks): allineata a
   * sinistra, titolo piu' contenuto, introduzione a misura di prosa e una riga
   * in mono sotto. Lo slot accoglie quello che una singola pagina aggiunge.
   */
  variant?: 'default' | 'index';
  /** Riga in mono sotto l'introduzione, solo in variant="index". */
  note?: string;
}

const { title, subtitle, eyebrow, align = 'left', image, cta, ctaSecondary, variant = 'default', note } = Astro.props;
const centered = align === 'center' && !image;
const isIndex = variant === 'index';
---

{isIndex ? (
  <section class="bg-accent-subtle border-b border-border/40 dark:border-border-dark/40">
    <div class="max-w-5xl mx-auto px-5 py-14 md:py-16 fade-in-section">
      {eyebrow && (
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-4">{eyebrow}</p>
      )}
      <h1 class="font-bold tracking-tight text-text-dark dark:text-text-light leading-[1.15] text-3xl sm:text-4xl max-w-2xl">
        {title}
      </h1>
      {subtitle && <p class="mt-4 text-text-muted leading-relaxed max-w-2xl">{subtitle}</p>}
      {note && <p class="mt-5 label-mono">{note}</p>}
      <slot />
    </div>
  </section>
) : (
<section class="bg-accent-subtle border-b border-border/40 dark:border-border-dark/40">
  <div class:list={['mx-auto px-5 py-16 md:py-24 fade-in-section', centered ? 'max-w-3xl text-center' : 'max-w-5xl']}>
    <div class:list={[
      'flex flex-col',
      image ? 'md:flex-row md:items-center md:gap-10' : '',
    ]}>
      {image && (
        <div class="shrink-0 mb-6 md:mb-0">
          <img
            src={image.src}
            alt={image.alt}
            width="128"
            height="128"
            class="w-28 h-28 md:w-32 md:h-32 rounded-full object-cover shadow-lg ring-4 ring-accent"
          />
        </div>
      )}

      <div class="flex-1">
        {eyebrow && (
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-5">{eyebrow}</p>
        )}
        <h1 class:list={['font-bold tracking-tight text-text-dark dark:text-text-light leading-[1.15]',
          centered ? 'text-3xl sm:text-4xl text-balance' : 'text-3xl sm:text-4xl md:text-5xl']}>
          {title}
        </h1>
        {subtitle && (
          <p class:list={['mt-4 text-base md:text-lg text-text-muted leading-relaxed',
            centered ? 'max-w-xl mx-auto mt-5' : 'max-w-2xl']} set:html={subtitle} />
        )}
        {(cta || ctaSecondary) && (
          <div class:list={['mt-8 flex flex-wrap gap-3', centered && 'justify-center']}>
            {cta && (
              <Button href={cta.href} size="lg">
                {cta.label}
              </Button>
            )}
            {ctaSecondary && (
              <Button href={ctaSecondary.href} variant="secondary" size="lg">
                {ctaSecondary.label}
              </Button>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
)}
