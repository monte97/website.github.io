---
/**
 * Chiusura delle pagine: dall'11/11/2026 e' la stessa della home ("Un caffè?"
 * con i quattro modi per sentirsi), con il titolo e la frase della pagina.
 * ctaLabel/ctaHref/secondary* restano per compatibilita' ma non si usano piu'.
 */
import Coffee from '@/components/home/Coffee.astro';

interface Props {
  title: string;
  desc: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  umamiEvent?: string;
  fullBleed?: boolean;
}

const { title, desc } = Astro.props;
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'it';
---

<Coffee lang={lang} title={title} lead={desc}><slot /></Coffee>
