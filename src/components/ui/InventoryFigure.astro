---
interface Item {
  name: string;
  /** l'eccezione dichiarata: riquadro pieno invece che vuoto */
  mark?: boolean;
}
interface Props {
  figureId?: string;
  label?: string;
  items: Item[];
  legend?: { plain?: string; mark?: string };
  caption?: string;
  note?: string;
}
const { figureId, label, items, legend, caption, note } = Astro.props;
const marked = items.filter((i) => i.mark).length;
---

<figure class="not-prose my-10">
  {figureId && label && (
    <figcaption class="text-[10px] font-mono uppercase tracking-[0.18em] text-accent mb-3">
      {figureId} &middot; {label}
    </figcaption>
  )}

  <div class="rounded-2xl border border-border/60 dark:border-border-dark/60 bg-accent-subtle/20 p-5 md:p-7">
    <div class="flex flex-wrap gap-2">
      {items.map((it) => (
        <span class={`inline-flex items-center rounded-lg border px-3 py-2 text-sm leading-none ${
          it.mark
            ? 'border-accent bg-accent/10 text-accent font-semibold'
            : 'border-border dark:border-border-dark bg-white dark:bg-surface-dark text-text-muted'
        }`}>
          {it.name}
        </span>
      ))}
    </div>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-5 pt-4 border-t border-border/40 dark:border-border-dark/40">
      <span class="text-xs text-text-muted">
        <span class="font-mono font-semibold text-text-dark dark:text-text-light">{items.length}</span>
        {' '}{legend?.plain ?? 'in tutto'}
      </span>
      {marked > 0 && (
        <span class="flex items-center gap-2 text-xs text-text-muted">
          <span class="w-4 h-3 rounded border border-accent bg-accent/10 shrink-0" />
          <span><span class="font-mono font-semibold text-accent">{marked}</span> {legend?.mark ?? 'con eccezione'}</span>
        </span>
      )}
    </div>
  </div>

  {caption && (
    <figcaption class="mt-2 text-[10px] font-mono uppercase tracking-[0.15em] text-text-muted">{caption}</figcaption>
  )}
  {note && <p class="mt-3 text-sm text-text-muted leading-relaxed max-w-2xl">{note}</p>}
</figure>
