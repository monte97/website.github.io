---
// Lingua in cui il talk e' tenuto: sigla piu' etichetta, nella lingua della pagina.
interface Props {
  language: 'it' | 'en';
  lang?: 'it' | 'en';
  class?: string;
}

const { language, lang = 'it', class: className = '' } = Astro.props;

const labels = {
  it: { it: 'Talk in italiano', en: 'Talk in inglese' },
  en: { it: 'Talk in Italian', en: 'Talk in English' },
};
---

<span class:list={['inline-flex items-center gap-1.5 rounded border border-accent/40 bg-accent/10 px-2 py-0.5 text-xs font-semibold text-accent', className]}>
  <span class="font-mono uppercase tracking-wider">{language}</span>
  <span aria-hidden="true">&middot;</span>
  <span>{labels[lang][language]}</span>
</span>
