---
interface Row {
  /** l'asse su cui si confronta: "il ciclo di verifica", "la domanda in trattativa" */
  label: string;
  before: string;
  after: string;
}
interface Props {
  figureId?: string;
  label?: string;
  /** ogni pezzo nomina il proprio asse: Prima/Dopo, ma anche La strada ovvia/Quella presa */
  beforeLabel?: string;
  afterLabel?: string;
  rows: Row[];
  caption?: string;
  note?: string;
}
const {
  figureId,
  label,
  beforeLabel = 'Prima',
  afterLabel = 'Dopo',
  rows,
  caption,
  note,
} = Astro.props;
---

<figure class="not-prose my-10">
  {figureId && label && (
    <figcaption class="text-[10px] font-mono uppercase tracking-[0.18em] text-accent mb-3">
      {figureId} &middot; {label}
    </figcaption>
  )}

  <div class="rounded-2xl border border-border/60 dark:border-border-dark/60 bg-accent-subtle/20 p-5 md:p-7">

    {/* intestazioni: solo da sm in su, sotto ogni cella porta la propria etichetta */}
    <div class="hidden sm:grid grid-cols-[minmax(0,7rem)_1fr_1fr] gap-x-5 mb-3">
      <span></span>
      <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-text-muted/70">{beforeLabel}</span>
      <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-accent">{afterLabel}</span>
    </div>

    <div class="flex flex-col gap-4 sm:gap-0">
      {rows.map((r, i) => (
        <div class={`sm:grid sm:grid-cols-[minmax(0,7rem)_1fr_1fr] sm:gap-x-5 sm:py-4 ${i > 0 ? 'sm:border-t sm:border-border/40 sm:dark:border-border-dark/40' : ''}`}>
          <span class="block text-sm font-bold text-text-dark dark:text-text-light leading-snug mb-2 sm:mb-0">
            {r.label}
          </span>

          <div class="border-l-2 border-dashed border-text-muted/40 pl-3 sm:pl-4 mb-2 sm:mb-0">
            <span class="sm:hidden block text-[10px] font-mono uppercase tracking-[0.15em] text-text-muted/70 mb-1">{beforeLabel}</span>
            <span class="block text-sm text-text-muted leading-relaxed">{r.before}</span>
          </div>

          <div class="border-l-2 border-accent pl-3 sm:pl-4">
            <span class="sm:hidden block text-[10px] font-mono uppercase tracking-[0.15em] text-accent mb-1">{afterLabel}</span>
            <span class="block text-sm text-text-dark dark:text-text-light leading-relaxed">{r.after}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  {caption && (
    <figcaption class="mt-2 text-[10px] font-mono uppercase tracking-[0.15em] text-text-muted">{caption}</figcaption>
  )}
  {note && <p class="mt-3 text-sm text-text-muted leading-relaxed max-w-2xl">{note}</p>}
</figure>
