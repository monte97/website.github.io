---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'left' } = Astro.props;
---

<div class:list={['mb-10', align === 'center' ? 'text-center' : '']}>
  <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-text-dark dark:text-text-light">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-2 text-text-muted text-base max-w-xl">
      {subtitle}
    </p>
  )}
</div>
