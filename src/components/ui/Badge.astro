---
import { pillarStyles } from '@/data/pillar-styles';
import type { Pillar } from '@/data/pillars';

interface Props {
  pillar?: Pillar;
  class?: string;
}

const { pillar, class: className = '' } = Astro.props;

const style = pillar ? pillarStyles[pillar].badge : 'bg-text-muted/10 text-text-muted';
---

<span class:list={['inline-flex items-center px-2 py-0.5 rounded text-xs font-medium tracking-wide', style, className]}>
  <slot />
</span>
