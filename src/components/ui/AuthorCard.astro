---
/**
 * Riquadro autore: foto, nome, ruolo, bio e — se richiesto — il bottone LinkedIn.
 *
 * Nome, ruolo, bio e URL vivono in `src/data/author.ts`: qui non si scrive
 * nessuno dei tre. Prima esistevano due versioni divergenti di questo riquadro,
 * una con la foto e una con una lettera dentro un cerchio, e dicevano due ruoli
 * diversi.
 */
import { author } from '@/data/author';

interface Props {
  lang?: 'it' | 'en';
  /** Il bottone LinkedIn: si toglie dove la pagina ha gia' una CTA propria */
  linkedin?: boolean;
  /** `row`: riga orizzontale fra due filetti, per fine articolo */
  variant?: 'card' | 'row';
  class?: string;
}

const { lang = 'it', linkedin = true, variant = 'card', class: extra = '' } = Astro.props;

const t = lang === 'en'
  ? { follow: 'Follow me on LinkedIn' }
  : { follow: 'Seguimi su LinkedIn' };
---

{variant === 'row' ? (
  <div class:list={['flex gap-4 items-start py-6 border-y border-border', extra]}>
    <img src={author.image} alt={author.name} width="56" height="56" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover shrink-0" />
    <div>
      <div class="font-semibold text-text-dark">{author.name}</div>
      <p class="text-[15px] text-text-muted leading-relaxed mt-1 mb-2">{author.bio[lang]}</p>
      {linkedin && (
        <a href={author.linkedin} target="_blank" rel="noopener noreferrer" class="text-[15px] font-semibold text-accent hover:underline">{t.follow} &rarr;</a>
      )}
    </div>
  </div>
) : (
<div class:list={['surface-card p-5', extra]}>
  <div class="flex items-center gap-3 mb-3">
    <img
      src={author.image}
      alt={author.name}
      width="40"
      height="40"
      loading="lazy"
      decoding="async"
      class="w-10 h-10 rounded-full object-cover"
    />
    <div>
      <div class="text-sm font-semibold text-text-dark">{author.name}</div>
      <div class="text-xs text-text-muted">{author.role[lang]}</div>
    </div>
  </div>

  <p class="text-sm text-text-muted leading-relaxed">{author.bio[lang]}</p>

  {linkedin && (
    <a
      href={author.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="block w-full text-center mt-4 px-4 py-2 rounded-lg border-[1.5px] border-text-dark/80 text-text-dark text-sm font-semibold hover:border-accent hover:text-accent transition-colors"
    >
      {t.follow}
    </a>
  )}
</div>
)}
