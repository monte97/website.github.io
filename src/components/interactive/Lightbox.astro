---
// Click su un'immagine di contenuto -> visualizzatore con zoom e pan.
// Incluso una volta da BaseLayout: vale per tutto il sito.
// Usa <dialog>, che porta gratis Esc per chiudere, focus trap e backdrop.
---

<dialog id="lightbox" aria-label="Visualizzatore immagine">
  <img id="lightbox-img" alt="" />
  <button id="lightbox-close" aria-label="Chiudi">&times;</button>
  <p id="lightbox-hint">rotella o pizzico per zoomare · trascina per spostare · doppio click per reimpostare</p>
</dialog>

<style is:global>
  #lightbox {
    padding: 0;
    border: none;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    background: transparent;
    overflow: hidden;
  }
  #lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(2px);
  }
  #lightbox-img {
    position: absolute;
    top: 50%;
    left: 50%;
    max-width: 92vw;
    max-height: 92vh;
    transform-origin: center;
    /* i diagrammi con sfondo trasparente sono scritti in scuro:
       serve un fondo chiaro in entrambi i temi, non il backdrop */
    background: #fff;
    border-radius: 0.25rem;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  #lightbox-img.grabbing {
    cursor: grabbing;
  }
  #lightbox-close,
  #lightbox-hint {
    position: fixed;
    color: #fff;
    font-family: inherit;
  }
  #lightbox-close {
    top: 0.75rem;
    right: 1rem;
    font-size: 2rem;
    line-height: 1;
    background: none;
    border: none;
    cursor: pointer;
    opacity: 0.7;
  }
  #lightbox-close:hover {
    opacity: 1;
  }
  #lightbox-hint {
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.75rem;
    opacity: 0.55;
    text-align: center;
    pointer-events: none;
  }
  /* le immagini apribili si annunciano al passaggio del mouse */
  main img[data-zoomable] {
    cursor: zoom-in;
  }
  main img[data-zoomable]:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    #lightbox-img {
      transition: transform 0.12s ease-out;
    }
    #lightbox-img.dragging {
      transition: none;
    }
  }
</style>

<script>
  const MIN = 1;
  const MAX = 8;

  // Lo stato vive fuori da initLightbox: con le view transitions gli elementi
  // vengono ricreati a ogni navigazione, il documento no.
  let scale = 1;
  let x = 0;
  let y = 0;
  // pointerId -> ultima posizione: uno = trascinamento, due = pizzico
  const pointers = new Map<number, { x: number; y: number }>();
  let pinchStart = 0;
  let scaleStart = 1;
  let bound = false;
  let keyBound = false;

  function initLightbox() {
    const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    if (!dlg || !img) return;

    const apply = () => {
      img.style.transform = `translate(-50%, -50%) translate(${x}px, ${y}px) scale(${scale})`;
    };
    const reset = () => {
      scale = 1;
      x = 0;
      y = 0;
      apply();
    };
    const zoomTo = (next: number) => {
      scale = Math.min(MAX, Math.max(MIN, next));
      if (scale === 1) {
        x = 0;
        y = 0;
      }
      apply();
    };

    // apertura: delega sul documento, cosi' vale anche per il contenuto renderizzato dal markdown.
    // Il documento sopravvive alle view transitions, quindi si registra una volta sola.
    if (!bound) {
      bound = true;
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (!(t instanceof HTMLImageElement)) return;
        // solo immagini di contenuto, e mai quelle che sono gia' un link
        if (!t.closest('main') || t.closest('a') || t.id === 'lightbox-img') return;
        const d = document.getElementById('lightbox') as HTMLDialogElement | null;
        const i = document.getElementById('lightbox-img') as HTMLImageElement | null;
        if (!d || !i) return;
        i.src = t.currentSrc || t.src;
        i.alt = t.alt;
        scale = 1;
        x = 0;
        y = 0;
        i.style.transform = 'translate(-50%, -50%)';
        d.showModal();
      });
    }

    // segnala quali immagini sono apribili, e le rende raggiungibili da tastiera
    document.querySelectorAll('main img').forEach((el) => {
      if (el.closest('a')) return;
      el.setAttribute('data-zoomable', '');
      el.setAttribute('tabindex', '0');
      el.setAttribute('role', 'button');
      el.setAttribute('aria-label', `Ingrandisci: ${el.getAttribute('alt') || 'immagine'}`);
    });

    // Invio e Spazio aprono come il click
    if (!keyBound) {
      keyBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const t = document.activeElement as HTMLElement | null;
        if (!(t instanceof HTMLImageElement) || !t.hasAttribute('data-zoomable')) return;
        e.preventDefault();
        t.click();
      });
    }

    document.getElementById('lightbox-close')?.addEventListener('click', () => dlg.close());

    // click sul backdrop (fuori dall'immagine) chiude
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    dlg.addEventListener('wheel', (e) => {
      e.preventDefault();
      zoomTo(scale * (e.deltaY < 0 ? 1.15 : 1 / 1.15));
    }, { passive: false });

    img.addEventListener('dblclick', reset);

    img.addEventListener('pointerdown', (e) => {
      img.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchStart = Math.hypot(a.x - b.x, a.y - b.y);
        scaleStart = scale;
      }
      img.classList.add('grabbing', 'dragging');
    });

    img.addEventListener('pointermove', (e) => {
      const prev = pointers.get(e.pointerId);
      if (!prev) return;
      const now = { x: e.clientX, y: e.clientY };
      pointers.set(e.pointerId, now);

      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinchStart > 0) zoomTo(scaleStart * (dist / pinchStart));
        return;
      }
      x += now.x - prev.x;
      y += now.y - prev.y;
      apply();
    });

    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinchStart = 0;
      if (pointers.size === 0) img.classList.remove('grabbing', 'dragging');
    };
    img.addEventListener('pointerup', release);
    img.addEventListener('pointercancel', release);

    dlg.addEventListener('close', reset);
  }

  document.addEventListener('astro:page-load', initLightbox);
</script>
