---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Badge from '@/components/ui/Badge.astro';
import TOC from '@/components/blog/TOC.astro';
import PostCTA from '@/components/blog/PostCTA.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  pillar: 'progettare' | 'verificare' | 'automatizzare' | null;
  tags: string[];
  headings: Heading[];
  lang?: 'it' | 'en';
  editUrl?: string;
  series?: string;
  postId: string;
}

const {
  title,
  description,
  date,
  pillar,
  tags,
  headings,
  lang = 'it',
  editUrl,
  series,
  postId,
} = Astro.props;

const formattedDate = date.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const pillarLabels: Record<string, { it: string; en: string }> = {
  progettare: { it: 'Progettare', en: 'Design' },
  verificare: { it: 'Verificare', en: 'Verify' },
  automatizzare: { it: 'Automatizzare', en: 'Automate' },
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
];
if (pillar) {
  breadcrumbs.push({
    label: pillarLabels[pillar][lang],
    href: `/blog/${pillar}/`,
  });
}
---

<BaseLayout title={title} description={description} lang={lang}>
  <Header lang={lang} />

  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-text-muted mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        {breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && <li class="text-text-muted/50">/</li>}
            <li>
              <a href={crumb.href} class="hover:text-accent transition-colors">
                {crumb.label}
              </a>
            </li>
          </>
        ))}
        <li class="text-text-muted/50">/</li>
        <li class="truncate max-w-[200px]" title={title}>{title}</li>
      </ol>
    </nav>

    <!-- Title block -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-3">
        <time class="text-sm text-text-muted" datetime={date.toISOString()}>
          {formattedDate}
        </time>
        {pillar && (
          <Badge pillar={pillar}>
            {pillarLabels[pillar][lang]}
          </Badge>
        )}
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-4">
        {title}
      </h1>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="text-xs text-text-muted bg-text-muted/10 px-2.5 py-1 rounded-md">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Series nav slot (filled by SeriesNav when series is defined) -->
    <slot name="series-nav" />

    <!-- Two-column layout: content + TOC -->
    <div class="flex gap-12">
      <!-- Main content -->
      <article class="flex-1 min-w-0 prose prose-lg dark:prose-invert max-w-none
        prose-headings:scroll-mt-20
        prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-10 prose-h2:mb-4
        prose-h3:text-xl prose-h3:font-semibold prose-h3:mt-8 prose-h3:mb-3
        prose-p:leading-relaxed prose-p:mb-4
        prose-a:text-accent prose-a:no-underline hover:prose-a:underline
        prose-img:rounded-lg prose-img:shadow-md
        prose-code:before:content-none prose-code:after:content-none
        prose-pre:bg-code-bg prose-pre:rounded-lg
        prose-blockquote:border-l-accent prose-blockquote:bg-text-muted/5 prose-blockquote:rounded-r-lg prose-blockquote:py-1
        prose-li:marker:text-accent
        prose-table:text-sm
        prose-th:bg-text-muted/10 prose-th:px-4 prose-th:py-2
        prose-td:px-4 prose-td:py-2 prose-td:border-t prose-td:border-border dark:prose-td:border-border-dark">
        <slot />
      </article>

      <!-- TOC sidebar -->
      <aside class="hidden lg:block w-64 shrink-0">
        <TOC headings={headings} />
      </aside>
    </div>

    <!-- CTA -->
    <PostCTA lang={lang} />

    <!-- Edit on GitHub link -->
    {editUrl && (
      <div class="mt-8 text-center">
        <a
          href={editUrl}
          target="_blank"
          rel="noopener"
          class="text-sm text-text-muted hover:text-accent transition-colors"
        >
          {lang === 'it' ? 'Modifica su GitHub' : 'Edit on GitHub'}
        </a>
      </div>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>
