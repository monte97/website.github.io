---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Badge from '@/components/ui/Badge.astro';
import TOC from '@/components/blog/TOC.astro';
import PostCTA from '@/components/blog/PostCTA.astro';
import SeriesNav from '@/components/blog/SeriesNav.astro';
import { getPillarLabel } from '@/data/pillars';
import { getCollection } from 'astro:content';
import { postHref } from '@/utils/blog';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  pillar: 'progettare' | 'verificare' | 'automatizzare' | null;
  category?: string;
  tags: string[];
  headings: Heading[];
  lang?: 'it' | 'en';
  editUrl?: string;
  series?: string;
  postId: string;
  heroImage?: string | null;
  readingTime?: number;
  ogImage?: string | null;
  alternateUrl?: string;
}

const {
  title,
  description,
  date,
  pillar,
  category,
  tags,
  headings,
  lang = 'it',
  editUrl,
  series,
  postId,
  heroImage,
  readingTime,
  ogImage,
  alternateUrl,
} = Astro.props;

const formattedDate = date.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const prefix = lang === 'en' ? '/en' : '';
const canonicalURL = new URL(`${prefix}/blog/${postId.replace(/\/indexen$/, '')}/`, Astro.site);

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  url: canonicalURL,
  author: {
    '@type': 'Person',
    name: 'Francesco Montelli',
    url: new URL(`${prefix}/about/`, Astro.site),
  },
  ...(ogImage ? { image: new URL(ogImage, Astro.site) } : {}),
};

const breadcrumbs = [
  { label: 'Home', href: `${prefix}/` || '/' },
  { label: 'Blog', href: `${prefix}/blog/` },
];
if (pillar) {
  breadcrumbs.push({
    label: getPillarLabel(pillar, lang),
    href: `${prefix}/blog/${pillar}/`,
  });
}

// Fetch all posts for related posts and series prev/next
const allPosts = await getCollection('posts');

// Related posts (same pillar, different post, same language)
const relatedPosts = pillar
  ? allPosts
      .filter(p => p.data.pillar === pillar && p.data.lang === lang && !p.data.draft && p.id !== postId)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      .slice(0, 3)
  : [];

---

<BaseLayout title={title} description={description} ogImage={ogImage} lang={lang} type="article" publishedTime={date} alternateUrl={alternateUrl} author="Francesco Montelli" jsonLd={blogPostingJsonLd}>
  <Header lang={lang} />

  <main class="max-w-5xl mx-auto px-5 py-8">
    <!-- Breadcrumb -->
    <nav class="text-xs text-text-muted mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        {breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && <li aria-hidden="true" class="opacity-40">/</li>}
            <li>
              <a href={crumb.href} class="hover:text-accent transition-colors">
                {crumb.label}
              </a>
            </li>
          </>
        ))}
        <li aria-hidden="true" class="opacity-40">/</li>
        <li class="truncate max-w-[200px] text-text-dark dark:text-text-light" title={title}>{title}</li>
      </ol>
    </nav>

    <!-- Hero image -->
    {heroImage && (
      <img
        src={heroImage}
        alt=""
        class="w-full max-w-4xl mx-auto h-56 md:h-72 object-cover rounded-xl shadow-sm mb-8"
        loading="eager"
      />
    )}

    <!-- Title block -->
    <header class="mb-10 max-w-3xl">
      <div class="flex items-center gap-3 mb-3">
        <time class="text-sm text-text-muted tabular-nums" datetime={date.toISOString()}>
          {formattedDate}
        </time>
        {readingTime && (
          <span class="text-sm text-text-muted">&middot; {readingTime} min</span>
        )}
        {pillar && (
          <Badge pillar={pillar}>
            {getPillarLabel(pillar, lang)}
          </Badge>
        )}
      </div>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight text-text-dark dark:text-text-light mb-4">
        {title}
      </h1>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map(tag => (
            <span class="text-[11px] text-text-muted/80 bg-text-muted/8 px-1.5 py-0.5 rounded">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Series navigation -->
    {series && <SeriesNav series={series} currentId={postId} lang={lang} />}

    <!-- Two-column layout: content + TOC -->
    <div class="flex gap-12">
      <!-- Main content -->
      <article class="flex-1 min-w-0 prose max-w-none">
        <slot />
      </article>

      <!-- TOC sidebar -->
      <aside class="hidden lg:block w-56 shrink-0">
        <TOC headings={headings} lang={lang} />
      </aside>
    </div>

    <!-- CTA -->
    <PostCTA lang={lang} category={category} />

    <!-- Related posts -->
    {relatedPosts.length > 0 && (
      <div class="mt-12 pt-8 border-t border-border dark:border-border-dark">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-text-muted mb-4">
          {lang === 'it' ? 'Articoli correlati' : 'Related articles'}
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedPosts.map(rp => (
            <a href={postHref(rp.id, lang)} class="group block p-4 rounded-lg border border-border/50 dark:border-border-dark/50 hover:border-accent/50 transition-colors">
              <time class="text-xs text-text-muted">
                {rp.data.date.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
              <h4 class="text-sm font-medium mt-1 text-text-dark dark:text-text-light group-hover:text-accent transition-colors line-clamp-2">
                {rp.data.title}
              </h4>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Edit on GitHub link -->
    {editUrl && (
      <div class="mt-6 text-center">
        <a
          href={editUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-text-muted hover:text-accent transition-colors"
        >
          {lang === 'it' ? 'Modifica su GitHub' : 'Edit on GitHub'}
        </a>
      </div>
    )}
  </main>

  <Footer lang={lang} />

  <script>
    function initCopyButtons() {
      const pres = document.querySelectorAll('article pre');
      pres.forEach((pre) => {
        if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper';
        pre.parentNode!.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.setAttribute('aria-label', 'Copy code');
        btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;

        btn.addEventListener('click', async () => {
          const code = pre.textContent ?? '';
          await navigator.clipboard.writeText(code);
          btn.classList.add('copied');
          btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
          setTimeout(() => {
            btn.classList.remove('copied');
            btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
          }, 2000);
        });

        wrapper.appendChild(btn);
      });
    }

    document.addEventListener('astro:page-load', initCopyButtons);
  </script>
</BaseLayout>
